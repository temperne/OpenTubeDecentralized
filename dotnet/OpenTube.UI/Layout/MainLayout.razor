@inherits LayoutComponentBase
@implements IDisposable
@inject ClientSession S
@inject OpenTube.UI.UiPlatform Platform
@inject NavigationManager Nav
@inject IVideoPlayer Player
<header class="top">
    <a class="logo" href="">Open<span>Tube</span></a>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink href="explore" class="desk-only">Explore</NavLink>
        <NavLink href="posts">Posts</NavLink>
        <NavLink href="friends">Friends</NavLink>
        <NavLink href="messages">Messages</NavLink>
        <NavLink href="market" class="desk-only">Market</NavLink>
        <NavLink href="exchange" class="desk-only">Exchange</NavLink>
        <NavLink href="orgs" class="desk-only">Orgs</NavLink>
        <NavLink href="devices" class="desk-only">Devices</NavLink>
        <NavLink href="you">You</NavLink>
    </nav>
    <a class="bell" href="notifications" title="Notifications">🔔@if (S.Ready && S.Notes.Unread > 0) { <span class="bell-n">@(S.Notes.Unread > 99 ? "99+" : S.Notes.Unread.ToString())</span> }</a>
    <div class="net">
        <span class="dot @(S.Peers > 0 ? "on" : "")"></span>@(S.Peers) node@(S.Peers == 1 ? "" : "s")
        @if (S.Ready) { <span class="sub"> · main #@S.MainBest["height"]</span> }
        <span class="badge">@Platform.Label</span>
        @if (Platform.Label.Contains("WebAssembly")) { <a class="sub" href="../?classic=1" title="The older JavaScript page, for what isn’t in this site yet. “New site” there brings you back.">Classic page</a> }
    </div>
</header>
<TermsBanner />
<main>@Body</main>
@code {
    protected override void OnInitialized()
    {
        S.Changed += Poke;
        _ = Task.Run(async () => { for (int i = 0; i < 300 && !S.Ready; i++) await Task.Delay(200); if (S.Ready) MediaUi.ReseedOnce(S, Player); });
        AppNav.Go += Open;   // a tapped notification (phone)
        if (AppNav.Pending is { } p) _ = InvokeAsync(() => Open(p));
    }
    void Open(string href) { AppNav.Pending = null; var l = AppNav.LinkFor(href, S.Site); _ = InvokeAsync(() => Nav.NavigateTo(l)); }
    bool pending;
    void Poke() { if (pending) return; pending = true; _ = InvokeAsync(async () => { await Task.Delay(500); pending = false; StateHasChanged(); }); }
    public void Dispose() { S.Changed -= Poke; AppNav.Go -= Open; }
}
