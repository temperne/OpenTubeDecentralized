@inject OpenTube.Client.ClientSession S
@* A recording one of your computers made of a live stream: publish it as a video, or discard it *@
<div class="panel recording">
    <div class="row-actions">
        @if ((string?)R.R["thumb"] is { Length: > 0 } th) { <img src="@th" style="width:160px;border-radius:6px" alt="" /> }
        <div class="grow"><h3>📼 Recording ready: @R.Title</h3>
            <p class="sub">@(S.Engine.Read(e => (string?)e.Nodes.GetValueOrDefault((string?)R.R["by"] ?? "")?["info"]?["name"]) ?? "Your computer") recorded this stream (@Size) and is sharing it. Publish it as a video, or discard it.</p></div>
    </div>
    <label>Title</label><input @bind="title" maxlength="140" />
    <label>Description</label><textarea @bind="desc" rows="2" maxlength="5000"></textarea>
    <div class="row-actions">
        <button class="primary" disabled="@busy" @onclick="() => Act(true)">Publish recording</button>
        <button disabled="@busy" @onclick="() => Act(false)">@(confirmDiscard ? "Really discard?" : "Discard")</button>
        <span class="sub">@msg</span>
    </div>
</div>
@code {
    [Parameter] public required string Chain { get; set; }
    [Parameter] public required ChainActions.NodeRecording R { get; set; }
    string title = "", desc = ""; string? msg; bool busy, confirmDiscard;
    string Size => $"{(Js.Num(R.R["size"]) ?? 0) / 1e6:0.0} MB";
    protected override void OnParametersSet() { if (title.Length == 0) title = R.Title; }
    async Task Act(bool publish)
    {
        if (!publish && !confirmDiscard) { confirmDiscard = true; return; }
        busy = true; msg = publish ? "Publishing…" : "Discarding…";
        try { await S.SettleRecording(Chain, R, publish, title, desc); msg = publish ? "Recording published as a video." : "Recording discarded."; }
        catch (Exception e) { msg = "Failed: " + e.Message; busy = false; }
    }
}
