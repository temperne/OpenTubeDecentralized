@inherits Live
@using Microsoft.AspNetCore.Components.Forms
@{ var d = S.Chain(Id); }
@if (d != null)
{
    var space = d.Kind == "channel" ? "@" : d.Kind == "circle" ? "@@" : "~"; var cur = S.NameOfChain(Id); var what = d.Kind == "circle" ? "page" : d.Kind;
    @if (d.Kind is "channel" or "list" or "circle")
    {
        <div class="panel">
            <h3>Username</h3>
            <p class="sub">Gives this @what a short link: @S.Site/@(space)name. One name per @what. Changing or releasing it frees the old name for anyone.</p>
            @if (cur != null) { <div class="row-actions"><span>Current:</span><a href="n/@Uri.EscapeDataString(cur)"><b>@cur</b></a></div> }
            <div class="row-actions"><b>@space</b><input class="grow-input" id="name-input" @bind="handle" @bind:event="oninput" maxlength="30" placeholder="@(d.Kind == "channel" ? "yourchannel" : d.Kind == "circle" ? "yourname" : "yourlist")" />
                <button class="primary" disabled="@busy" @onclick="Claim">@(cur != null ? "Change name" : "Claim name")</button>
                @if (cur != null) { <button disabled="@busy" @onclick="Release">Release</button> }
            </div>
            <div class="sub" id="name-status">@NameStatus(space, cur)</div>
        </div>
    }
    <div class="panel">
        <h3>@(d.Kind == "circle" ? "Your public profile" : "Profile")</h3>
        <label>Name</label><input @bind="name" maxlength="60" />
        <label>About</label><textarea @bind="about" rows="4" maxlength="2000"></textarea>
        @if (d.Kind != "list")
        {
            <label>Avatar</label>
            <div class="row-actions">@if ((avatar ?? (string?)d.Profile["avatar"]) is { Length: > 0 } av) { <img class="avatar" src="@av" alt="" /> }<InputFile OnChange="PickAvatar" accept="image/*" /></div>
        }
        <label>Location</label><input @bind="location" maxlength="100" placeholder="City, country (optional)" />
        @if (d.Kind != "list") { <label>@(d.Kind == "org" ? "On the map (where this organization is)" : "On the map (for a business or venue; optional)")</label><PlacePicker Value="place" ValueChanged="p => { place = p; placeChanged = true; }" /> }
        <label>Links (shown on the About page)</label>
        @foreach (var l in links.ToList()) { <div class="row-item"><span class="grow">🔗 <b>@l.Label</b> <span class="sub">@l.Url</span></span><button @onclick="() => links.Remove(l)">Remove</button></div> }
        <div class="row-actions"><input @bind="linkLabel" maxlength="40" placeholder="Label, e.g. Mastodon" style="width:160px" /><input class="grow-input" @bind="linkUrl" maxlength="300" placeholder="https://…" /><button @onclick="AddLink">Add link</button></div>
        @if (d.Kind == "channel")
        {
            <label>Default comment setting (each video can override it)</label>
            <select @bind="policy"><option value="anyone">Anyone can comment</option><option value="approved">Only approved users</option><option value="off">Comments off</option></select>
        }
        @if (d.Kind == "group")
        {
            <label>Who can post</label>
            <select @bind="join"><option value="open">Anyone</option><option value="approved">Only approved members</option></select>
        }
        <p class="sub">Edits are appended as a new block. The genesis block on the main chain never changes.</p>
        <button class="primary" disabled="@busy" @onclick="Save">Save</button>
    </div>
    @if (d.Kind is "channel" or "group")
    {
        <div class="panel">
            <h3>@(d.Kind == "group" ? "Members" : "Commenters")</h3>
            <p class="sub">@(d.Kind == "group" ? "Approve people to post when only approved members can." : "Approve a user to comment when the policy is “approved”.") Blocking hides everything they write afterwards; unblock to show it again.</p>
            <input @bind="key" placeholder="User ID (43 characters)" />
            <div class="row-actions"><button @onclick="() => KeyAct(true)">Approve</button><button @onclick="() => KeyAct(false)">Block</button></div>
            <h4>Approved</h4>@if (d.Allowed.Count == 0) { <div class="sub">None</div> } @foreach (var k in d.Allowed) { <div class="row-item"><a class="grow person" href="u/@k">@S.NameOf(k)</a><span class="mono">@k[..8]…</span></div> }
            <h4>Blocked</h4>@if (d.Revoked.Count == 0) { <div class="sub">None</div> }
            @foreach (var k in d.Revoked) { <div class="row-item"><a class="grow person" href="u/@k">@S.NameOf(k)</a><button @onclick="() => Unblock(k)">Unblock</button></div> }
        </div>
    }
    @if (d.Kind != "circle")
    {
    <div class="panel">
        <h3>@(char.ToUpperInvariant(what[0]) + what[1..]) key</h3>
        <p class="sub">This @what is controlled by its own key pair: whoever holds the private key controls it. Back it up (locked with a password) or give it a new key under Keys & backup.</p>
        <div class="mono">Public key: @d.Owner</div>
        <div class="row-actions"><a class="button primary-link" href="you/keys">Keys & backup</a>
            <span class="sub">@(S.OwnerIdentity(Id) == S.Me.pub ? "✓ Bound to your identity: coins paid here go to your wallet." : "Being bound to your identity…")</span></div>
    </div>
    }
    @if (msg != null) { <div class="sub" id="manage-msg">@msg</div> }
}
@code {
    [Parameter] public string Id { get; set; } = "";
    string handle = "", name = "", about = "", location = "", policy = "anyone", join = "open", key = "", linkLabel = "", linkUrl = "";
    string? avatar, msg; bool busy, loaded, placeChanged; JsonObject? place;
    record Link(string Label, string Url);
    List<Link> links = [];
    protected override void OnParametersSet()
    {
        if (loaded || S.Chain(Id) is not { } d) return; loaded = true;
        var p = d.Profile;
        name = (string?)p["name"] ?? ""; about = (string?)p["about"] ?? ""; location = (string?)p["location"] ?? "";
        policy = (string?)p["comments"] ?? "anyone"; join = (string?)p["join"] ?? "open";
        links = (p["links"] as JsonArray ?? []).OfType<JsonObject>().Select(l => new Link((string?)l["label"] ?? "", (string?)l["url"] ?? "")).ToList();
        handle = (S.NameOfChain(Id) ?? "").TrimStart('@', '~');
        place = p["place"]?.DeepClone() as JsonObject;
    }
    string NameStatus(string space, string? cur)
    {
        var v = handle.Trim().ToLowerInvariant();
        if (v.Length == 0) return "";
        if (!ChainActions.NameRe.IsMatch(v)) return "3–30 characters: a–z, 0–9, and . _ - in the middle";
        var holder = S.NameHolder(space + v);
        return holder != null && holder != Id ? $"{space}{v} is taken" : space + v == cur ? "This is your name" : $"{space}{v} is available";
    }
    async Task Run(Func<Task> f, string? doing, string? done)
    {
        busy = true; msg = doing; StateHasChanged();
        try { await f(); msg = done; } catch (Exception e) { msg = e.Message; }
        busy = false;
    }
    Task Claim() => Run(() => S.ClaimName(Id, handle.Trim().ToLowerInvariant()), "Signing (a little proof of work)…", "Claimed: it’s yours once the next main-chain block confirms it.");
    Task Release() => Run(() => S.ClaimName(Id, null), "Releasing…", "Released once the next main-chain block confirms it.");
    async Task PickAvatar(InputFileChangeEventArgs e)
    {
        try
        {
            var img = await e.File.RequestImageFileAsync("image/jpeg", 256, 256);
            using var ms = new MemoryStream(); await img.OpenReadStream(2 << 20).CopyToAsync(ms);
            avatar = "data:image/jpeg;base64," + Convert.ToBase64String(ms.ToArray());
        }
        catch (Exception ex) { msg = "That picture didn’t work: " + ex.Message; }
    }
    void AddLink()
    {
        var u = linkUrl.Trim(); if (!System.Text.RegularExpressions.Regex.IsMatch(u, @"^https://\S+$")) { msg = "Links must start with https://"; return; }
        if (links.Count >= 12) { msg = "Up to 12 links"; return; }
        var label = linkLabel.Trim(); if (label.Length == 0) label = new Uri(u).Host.Replace("www.", "");
        links.Add(new(label[..Math.Min(40, label.Length)], u)); linkLabel = linkUrl = "";
    }
    Task Save()
    {
        var d = S.Chain(Id)!; var p = d.Profile; var ch = new JsonObject();
        if (name.Trim().Length > 0 && name.Trim() != (string?)p["name"]) ch["name"] = name.Trim();
        if (about != ((string?)p["about"] ?? "")) ch["about"] = about;
        if (avatar != null) ch["avatar"] = avatar;
        if (placeChanged && place != null) ch["place"] = place.DeepClone();
        if (location.Trim() != ((string?)p["location"] ?? "")) ch["location"] = location.Trim();
        var cur = (p["links"] as JsonArray ?? []).OfType<JsonObject>().Select(l => new Link((string?)l["label"] ?? "", (string?)l["url"] ?? "")).ToList();
        if (!cur.SequenceEqual(links)) ch["links"] = new JsonArray(links.Select(l => (JsonNode?)new JsonObject { ["label"] = l.Label, ["url"] = l.Url }).ToArray());
        if (d.Kind == "channel" && policy != ((string?)p["comments"] ?? "anyone")) ch["comments"] = policy;
        if (d.Kind == "group" && join != ((string?)p["join"] ?? "open")) ch["join"] = join;
        if (ch.Count == 0) { msg = "Nothing changed."; return Task.CompletedTask; }
        return Run(async () => { await S.UpdateProfile(Id, ch); avatar = null; }, "Saving…", "Profile update appended to your chain.");
    }
    Task Unblock(string k) => Run(() => S.Allow(Id, k), null, "Unblocked.");
    Task KeyAct(bool approve)
    {
        var k = key.Trim(); if (!System.Text.RegularExpressions.Regex.IsMatch(k, "^[A-Za-z0-9_-]{43}$")) { msg = "Not a valid user ID"; return Task.CompletedTask; }
        return Run(async () => { if (approve) await S.Allow(Id, k); else await S.Block(Id, k); key = ""; }, null, approve ? "Approved." : "Blocked.");
    }
}
