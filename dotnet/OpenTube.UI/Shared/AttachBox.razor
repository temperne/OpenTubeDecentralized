@inject OpenTube.Client.ClientSession S
@inject IVideoPlayer Player
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
@* "📎 Attach" for a composer: pick from your library or add new files; GetRefs(priv) shares them when you post *@
<div class="attach">
    <div class="row-actions">
        <button type="button" class="small-btn" @onclick="Toggle">📎 Attach</button>
        @foreach (var it in picked) { <span class="tagbox">@if (it.Thumb is { Length: > 0 } t) { <img src="@t" style="height:28px;border-radius:4px" alt="" /> } else { <span>📄</span> } @it.Name[..Math.Min(24, it.Name.Length)]<button type="button" class="tagx" @onclick="() => picked.Remove(it)">✕</button></span> }
    </div>
    @if (open)
    {
        <div class="panel">
            <div class="head-row"><b>My media</b><label class="button file-button small-btn">＋ Add files <InputFile OnChange="AddFiles" multiple accept="image/*,video/*" /></label></div>
            @if (lib.Count == 0) { <div class="sub">Your library is empty. Add pictures or videos: they stay private until you attach them.</div> }
            <div class="media-grid">@foreach (var it in lib.Take(60)) { <button type="button" class="media-pick @(picked.Any(p => p.Id == it.Id) ? "on" : "")" title="@it.Name" @onclick="() => Pick(it)">@if (it.Thumb is { Length: > 0 } t) { <img src="@t" alt="" /> } else { <span>📄 @it.Name[..Math.Min(16, it.Name.Length)]</span> }</button> }</div>
            @if (msg != null) { <div class="sub">@msg</div> }
        </div>
    }
</div>
@code {
    readonly List<Media.Item> picked = []; List<Media.Item> lib = []; bool open; string? msg;
    public int Count => picked.Count;
    async Task Toggle() { open = !open; if (open) lib = await S.Media.List(); }
    void Pick(Media.Item it) { var at = picked.FindIndex(p => p.Id == it.Id); if (at >= 0) picked.RemoveAt(at); else if (picked.Count < 10) picked.Add(it); }
    async Task AddFiles(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(10))
        {
            msg = $"Adding {f.Name}…"; StateHasChanged();
            try { var it = await MediaTab.AddFile(S, JS, f); if (picked.Count < 10) picked.Add(it); } catch (Exception ex) { msg = ex.Message; }
        }
        msg = null; lib = await S.Media.List();
    }
    /// <summary>Share what's picked (encrypted copies when <paramref name="priv"/>) and give the refs to put on the chain.</summary>
    public async Task<JsonArray> GetRefs(bool priv)
    {
        var outp = new JsonArray(); var seed = MediaUi.Seeder(Player);
        foreach (var it in picked) outp.Add(await S.Media.Share(it, priv, seed));
        return outp;
    }
    public void Clear() { picked.Clear(); open = false; StateHasChanged(); }
}
