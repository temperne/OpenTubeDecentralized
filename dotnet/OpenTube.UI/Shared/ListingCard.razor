@inject OpenTube.Client.ClientSession S
@{
    var K = Market.KindOf(L.L); var dd = L.L["details"] as JsonObject; var per = (string?)dd?["rateUnit"] ?? (string?)dd?["period"] ?? ((string?)L.L["deal"] == "rent" ? "month" : null);
    var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(); var ends = Js.Num(L.L["ends"]) ?? 0;
    var price = Js.Num(L.L["price"]) ?? 0; var qty = Js.Num(L.L["qty"]) ?? 0; var certs = (L.L["certs"] as JsonArray)?.Count ?? 0;
    var what = L.Kind == "auction"
        ? $"{(L.L["high"] != null ? "bid" : "starts at")} {Trade.Coins(L.PriceNow)} · {(L.Open ? Left(ends - now) : L.State)}"
        : $"{(price > 0 ? Trade.Coins(price) + " coins" : (string?)dd?["salary"] ?? (string?)dd?["budget"] ?? "price on request")}{(price > 0 && per != null ? " / " + per : "")}{(qty > 1 ? $" · {qty} left" : "")}{(L.State != "open" ? " · " + L.State : "")}";
}
<a class="card" href="market/item/@L.Id">
    @if ((string?)L.L["image"] is { Length: > 0 } img) { <img src="@img" alt="" /> } else { <div class="thumb-empty">@(certs > 0 ? "🎟" : K.Icon)</div> }
    <div class="title">@L.Title</div>
    <div class="sub">@what</div>
    <div class="sub">@K.Icon @K.Name · @S.NameOf(L.Seller)@(certs > 0 ? $" · {certs} ad view{(certs == 1 ? "" : "s")}" : "")@((string?)L.L["place"]?["label"] is { Length: > 0 } pl ? " · 📍 " + pl : "")</div>
    @{ var det = Market.Details(L.L); }
    @if (det.Count > 0) { <div class="sub">@string.Join(" · ", det.Take(3).Select(x => x.Value))</div> }
</a>
@code {
    [Parameter] public required Trade.Listing L { get; set; }
    static string Left(double ms) { if (ms <= 0) return "ended"; var h = ms / 3600000; return h >= 48 ? $"{Math.Round(h / 24)} days left" : h >= 1 ? $"{Math.Round(h)} h left" : $"{Math.Max(1, Math.Round(ms / 60000))} min left"; }
}
