@inherits Live
<div class="post @(Reply ? "reply" : "")">
    <div><b>@P.Name</b> <span class="sub">· @Ago(P.Ts)</span></div>
    <div class="post-text">@P.Text</div>
    <div class="row-actions small-actions">
        <button disabled="@(P.Mine || liked)" title="Like (pays the author)" @onclick="Like">👍 @(liked && !P.Mine ? Math.Max(P.Likes, 1) : P.Likes)</button>
        @if (!Full) { <a class="sub" href="posts/@Month/@Hash">@P.Replies repl@(P.Replies == 1 ? "y" : "ies")</a> }
        @if (P.Mine) { <button @onclick="() => S.Social.Delete(P.Chain, Hash)">Delete</button> }
    </div>
</div>
@code {
    [Parameter] public required Social.Post P { get; set; }
    [Parameter] public string Month { get; set; } = "";
    [Parameter] public bool Full { get; set; }
    [Parameter] public bool Reply { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    bool liked;
    string Hash => (string)P.Block["hash"]!;
    async Task Like()
    {
        liked = true;
        try { await S.Social.Like(P.Chain, P.Block); }
        catch (Exception e) { liked = false; await OnError.InvokeAsync("Like failed: " + e.Message); }
    }
}
