@inject IJSRuntime JS
@* Where something is: search an address, use your location, or click the map. Only the pin and the label are published. *@
<div class="place-picker">
    <div class="row-actions">
        <input type="search" class="grow-input" placeholder="Search an address or place…" @bind="q" @onkeydown="Key" />
        <button type="button" @onclick="Search">Search</button>
        <button type="button" @onclick="Locate">Use my location</button>
        <button type="button" @onclick="Clear">Clear</button>
    </div>
    @foreach (var r in results) { <div><a href="" @onclick="() => Set(r.Lat, r.Lon, r.Label, true)" @onclick:preventDefault="true">@r.Label</a></div> }
    <MapView @ref="map" Height="260" Picked="Value" Zoom="@(Value != null ? 15 : 2)" OnPick="p => Set((double)p[LatKey]!, (double)p[LonKey]!, label, false)" />
    <div class="row-actions"><input class="grow-input" @bind="label" @bind:after="LabelChanged" maxlength="120" placeholder="Place name or address shown to others (optional)" /><span class="sub">@status</span></div>
    <div class="sub">Click the map to place the pin. Only the pin and the label you type are published.</div>
</div>
@code {
    [Parameter] public JsonObject? Value { get; set; }
    [Parameter] public EventCallback<JsonObject?> ValueChanged { get; set; }
    const string LatKey = "lat", LonKey = "lon";
    record Hit(string Label, double Lat, double Lon);
    string q = "", label = ""; string? status; List<Hit> results = []; MapView? map; bool init;
    protected override void OnParametersSet() { if (!init) { init = true; label = (string?)Value?["label"] ?? ""; if (Value != null) status = $"📍 {Value["lat"]}, {Value["lon"]}"; } }
    async Task Set(double lat, double lon, string lbl, bool fly)
    {
        if (lbl.Length > 0) label = lbl;
        Value = new JsonObject { ["lat"] = lat, ["lon"] = lon, ["label"] = label[..Math.Min(120, label.Length)] }; status = $"📍 {lat}, {lon}"; results = [];
        if (fly && map != null) await map.PinAt(lat, lon);
        await ValueChanged.InvokeAsync(Value);
    }
    async Task LabelChanged() { if (Value != null) { Value["label"] = label[..Math.Min(120, label.Length)]; await ValueChanged.InvokeAsync(Value); } }
    Task Key(KeyboardEventArgs e) => e.Key == "Enter" ? Search() : Task.CompletedTask;
    async Task Search()
    {
        if (q.Trim().Length == 0) return; status = "Searching…";
        try { results = await JS.InvokeAsync<List<Hit>>("otMap.geocode", q.Trim()); status = results.Count == 0 ? "Nothing found." : null; } catch (Exception e) { status = "Search failed: " + e.Message; }
    }
    async Task Locate()
    {
        try { var p = await JS.InvokeAsync<double[]>("otUi.locate"); await Set(Math.Round(p[0], 5), Math.Round(p[1], 5), label, true); }
        catch (Exception e) { status = "Couldn’t get your location: " + e.Message; }
    }
    async Task Clear() { Value = null; label = ""; status = "No place"; await ValueChanged.InvokeAsync(null); }
}
