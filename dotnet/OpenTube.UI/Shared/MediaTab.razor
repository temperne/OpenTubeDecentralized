@inherits Live
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
<div class="panel">
    <div class="head-row"><h3>My media</h3><div class="row-actions"><span class="sub">@msg</span><label class="button primary-link file-button">＋ Add pictures or videos <InputFile OnChange="Add" multiple accept="image/*,video/*" /></label></div></div>
    <p class="sub">Private: kept on this device and shared only when you attach them to something. To friends they go encrypted, readable only by that audience.</p>
    @if (lib == null) { <p class="sub">Loading…</p> }
    else if (lib.Count == 0) { <p class="sub">No pictures or videos yet.</p> }
    else
    {
        <div class="media-grid big">
            @foreach (var it in lib)
            {
                <div class="panel media-card">
                    @if (it.Thumb is { Length: > 0 } t) { <img src="@t" alt="" /> } else { <div class="sub">📄</div> }
                    <div class="clamp">@it.Name</div>
                    <div class="sub">@Bytes(it.Size) · @Ago(it.Ts) · @(it.Shared.Count > 0 ? $"shared {it.Shared.Count}×" : "private")</div>
                    <div class="row-actions small-actions"><button @onclick="() => OpenItem(it)">Open</button><button @onclick="() => Delete(it)">@(confirmId == it.Id ? "Really delete?" : "Delete")</button></div>
                </div>
            }
        </div>
    }
</div>
@code {
    List<Media.Item>? lib; string? msg, confirmId;
    protected override async Task OnInitializedAsync() { base.OnInitialized(); lib = await S.Media.List(); S.Media.Changed += Reload; }
    void Reload() => InvokeAsync(async () => { lib = await S.Media.List(); StateHasChanged(); });
    public override void Dispose() { base.Dispose(); S.Media.Changed -= Reload; }
    /// <summary>Read a chosen file into your library (with a thumbnail).</summary>
    public static async Task<Media.Item> AddFile(ClientSession s, IJSRuntime js, IBrowserFile f)
    {
        using var ms = new MemoryStream(); await f.OpenReadStream(500L << 20).CopyToAsync(ms); var data = ms.ToArray();
        string? thumb = null;
        try { thumb = await js.InvokeAsync<string>("otUi.thumbOf", data, f.ContentType); } catch { }
        return await s.Media.Add(f.Name, f.ContentType, data, thumb);
    }
    async Task Add(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(20)) { msg = $"Adding {f.Name}…"; StateHasChanged(); try { await AddFile(S, JS, f); } catch (Exception ex) { msg = ex.Message; } }
        msg = null;
    }
    async Task OpenItem(Media.Item it) { var b = await S.Media.Bytes(it); if (b != null) await JS.InvokeVoidAsync("otUi.openBytes", b, it.Mime); }
    async Task Delete(Media.Item it) { if (confirmId != it.Id) { confirmId = it.Id; return; } confirmId = null; await S.Media.Remove(it); }
}
