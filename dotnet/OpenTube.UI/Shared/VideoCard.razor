<a class="card" href="v/@Chain/@Block["hash"]">
    @if ((string?)Block["payload"]?["thumb"] is { Length: > 0 } t) { <img src="@t" alt="" /> } else { <div class="thumb-empty">▶</div> }
    <div class="title">@((string?)Block["payload"]?["title"])</div>
    <div class="sub">@ChannelName · @When</div>
</a>
@code {
    [Parameter] public required string Chain { get; set; }
    [Parameter] public required JsonObject Block { get; set; }
    [Parameter] public string? ChannelName { get; set; }
    string When => Ago(Js.Num(Block["ts"]) ?? 0);
    static string Ago(double ms) { var s = (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - ms) / 1000; return s < 3600 ? $"{(int)Math.Max(1, s / 60)} min ago" : s < 86400 ? $"{(int)(s / 3600)} h ago" : $"{(int)(s / 86400)} days ago"; }
}
