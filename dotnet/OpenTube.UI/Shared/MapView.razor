@inject IJSRuntime JS
@* A map (OpenStreetMap) of points, or (with OnPick) a place picker *@
<div class="osm" id="@id" style="height:@(Height)px"></div>
@code {
    [Parameter] public List<JsonObject> Points { get; set; } = [];
    [Parameter] public JsonObject? Picked { get; set; }
    [Parameter] public int Height { get; set; } = 360;
    [Parameter] public int? Zoom { get; set; }
    [Parameter] public EventCallback<JsonObject> OnPick { get; set; }
    readonly string id = "map-" + Guid.NewGuid().ToString("n")[..8]; string? shown; DotNetObjectReference<MapView>? self;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        var key = new JsonArray(Points.Select(p => (JsonNode?)p.DeepClone()).ToArray()).ToJsonString();
        if (key == shown) return; shown = key;
        if (OnPick.HasDelegate) self ??= DotNetObjectReference.Create(this);
        var opts = new Dictionary<string, object?> { ["zoom"] = Zoom, ["picked"] = Picked == null ? null : new { lat = (double?)Picked["lat"], lon = (double?)Picked["lon"] }, ["pickRef"] = self };
        if (Picked != null) opts["center"] = new { lat = (double?)Picked["lat"], lon = (double?)Picked["lon"] };
        try { await JS.InvokeVoidAsync("otMap.show", id, Points.Select(p => new { lat = (double?)p["lat"], lon = (double?)p["lon"], title = (string?)p["title"], sub = (string?)p["sub"], href = (string?)p["href"], kind = (string?)p["kind"] }), opts); } catch { }
    }
    [JSInvokable("OnPick")] public Task Picked_(double lat, double lon) => OnPick.InvokeAsync(new JsonObject { ["lat"] = lat, ["lon"] = lon, ["label"] = (string?)Picked?["label"] ?? "" });
    public Task PinAt(double lat, double lon) => JS.InvokeVoidAsync("otMap.pin", id, lat, lon).AsTask();
}
