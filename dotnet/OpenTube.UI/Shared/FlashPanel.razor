@inject OpenTube.Client.ClientSession S
@* Flash computers: your own cloud login on this computer (sealed to it), start one, and the ones you started. This
   computer runs them: it starts them, keeps their recordings, and deletes them when they're done. *@
<div class="flash">
    @if (!open) { <button @onclick="Open">⚡ Flash computers</button> <span class="sub">cloud servers for a stream, on your own cloud account</span> }
    else if (data == null) { <span class="sub">⚡ Flash computers: loading… @st</span> }
    else
    {
        var M = data["mine"] as JsonObject;
        <div class="row-actions"><b>⚡ Flash computers</b>
            @if (Js.IsTrue(M?["ready"])) { <span class="sub">your login: @Name((string?)M!["provider"])@((string?)M["plan"] is { Length: > 0 } pl ? " · " + pl : "")@((string?)M["region"] is { Length: > 0 } rg ? " · " + rg : "")</span><button class="primary" @onclick="StartOne">⚡ Start a flash computer</button> }
            else { <span class="sub">Attach your cloud login to start servers on your own account.</span> }
            @if (M != null && !editing) { <button @onclick="() => { editing = true; Fill(M); }">Edit login</button> <button @onclick="Remove">@(confirmRemove ? "Really remove?" : "Remove login")</button> }
            <span class="sub">@st</span>
        </div>
        @if (M == null || editing)
        {
            <div class="panel">
                <div class="row-actions">
                    <select @bind="prov">@foreach (var p in (data["providers"] as JsonArray ?? []).Select(x => (string?)x).OfType<string>()) { <option value="@p">@Name(p)</option> }</select>
                    <textarea class="grow-input mono" rows="@(prov == "gcp" ? 4 : 1)" @bind="token" disabled="@(prov is "custom" or "local")" placeholder="@KeyHint(prov)"></textarea>
                </div>
                @if (Js.IsTrue(M?["tokenSet"])) { <div class="sub">A key is saved: leave the field empty to keep it.</div> }
                @{ var def = data["defaults"]?[prov]; }
                <div class="row-actions"><input @bind="region" placeholder="@((string?)def?["region"] ?? "region")" style="width:150px" /><input @bind="plan" placeholder="@((string?)def?["plan"] ?? "plan / size")" style="width:150px" /><input @bind="image" placeholder="@((string?)def?["image"] ?? "image")" style="width:220px" /></div>
                <div class="row-actions"><select @bind="billing"><option value="auto">billing: as the provider bills</option><option value="hour">billed by the hour</option><option value="second">billed by the second</option></select>
                    <span class="sub">at most</span><input type="number" min="1" max="48" @bind="maxH" style="width:70px" /><span class="sub">h · idle</span><input type="number" min="2" max="240" @bind="idle" style="width:70px" /><span class="sub">min before deleting</span></div>
                @if (Js.IsTrue(data["owner"])) { <div class="row-actions"><input class="grow-input" @bind="cCmd" placeholder="create command (gets OT_NAME, OT_USERDATA_FILE; prints {&quot;id&quot;:…,&quot;ip&quot;:…})" /><input class="grow-input" @bind="dCmd" placeholder="delete command (gets OT_ID)" /></div> }
                <div class="row-actions"><button class="primary" @onclick="() => Save(false)">Save (sealed for this computer)</button>@if (M != null) { <button @onclick="() => editing = false">Cancel</button> }</div>
                <div class="sub">Your key is encrypted on this device for this computer only; the peers and tunnels that carry it see only ciphertext. Servers are billed to your cloud account.</div>
            </div>
        }
        @if (Js.IsTrue(M?["ready"]))
        {
            var sc = data["scale"]; var vw = data["viewers"];
            <div class="row-actions"><span>👁 @(Js.Num(vw?["total"]) ?? 0) watching your live streams now</span>
                <label class="check sub"><input type="checkbox" checked="@Js.IsTrue(sc?["on"])" @onchange="e => Scale((bool)e.Value!, (int)(Js.Num(sc?[PerKey]) ?? 25), (int)(Js.Num(sc?[MaxKey]) ?? 3))" /> add flash computers as viewers grow: one per</label>
                <input type="number" min="5" value="@((int)(Js.Num(sc?["per"]) ?? 25))" @onchange="e => Scale(Js.IsTrue(sc?[OnKey]), int.Parse((string)e.Value!), (int)(Js.Num(sc?[MaxKey]) ?? 3))" style="width:80px" /><span class="sub">viewers, up to</span>
                <input type="number" min="1" max="10" value="@((int)(Js.Num(sc?["max"]) ?? 3))" @onchange="e => Scale(Js.IsTrue(sc?[OnKey]), (int)(Js.Num(sc?[PerKey]) ?? 25), int.Parse((string)e.Value!))" style="width:60px" /></div>
        }
        @foreach (var c in (data["children"] as JsonArray ?? []).OfType<JsonObject>())
        {
            var state = (string?)c["state"]; var tag = (string?)c["tag"] ?? "";
            <div class="row-item">
                <span class="grow">@(state == "deleted" ? "⚪" : state == "running" ? "🟢" : "🟡") <b>@tag</b>@if (!Js.IsTrue(c["mine"])) { <span class="sub"> (someone else’s)</span> }
                    <span class="sub"> · @(state == "deleted" ? $"deleted {Ago(Js.Num(c["deletedAt"]))}: {(string?)c["why"]}" : $"{(state == "starting" ? "installing (2–4 min)…" : (string?)c["busy"] is { } b ? "busy: " + b : c["idleSince"] != null ? "idle" : "running")} · recordings copied here {Js.Num(c["copied"]) ?? 0}/{Js.Num(c["recordings"]) ?? 0}{((string?)c["error"] is { } er ? " · ✗ " + er : "")}")</span></span>
                @if (state != "deleted")
                {
                    <label class="check sub"><input type="checkbox" checked="@Js.IsTrue(c["keep"])" @onchange="e => Run(KeepCmd, new JsonObject { [TagKey] = tag, [KeepKey] = (bool)e.Value! })" /> keep</label>
                    <button @onclick="() => Shut(tag)">@(confirmShut == tag ? "Really shut down?" : "Shut down")</button>
                }
            </div>
        }
    }
</div>
@code {
    [Parameter] public required string Node { get; set; }
    const string PerKey = "per", MaxKey = "max", OnKey = "on", KeepCmd = "flash.keep", TagKey = "tag", KeepKey = "keep";
    static readonly Dictionary<string, string> Names = new() { ["aws"] = "Amazon Web Services (EC2)", ["gcp"] = "Google Cloud (Compute Engine)", ["hetzner"] = "Hetzner Cloud", ["digitalocean"] = "DigitalOcean", ["vultr"] = "Vultr", ["linode"] = "Akamai / Linode", ["scaleway"] = "Scaleway", ["custom"] = "Custom commands (any provider)", ["local"] = "This computer itself (test)" };
    static string Name(string? p) => p != null && Names.TryGetValue(p, out var n) ? n : p ?? "";
    static string KeyHint(string p) => p switch { "aws" => "ACCESS_KEY_ID:SECRET_ACCESS_KEY", "gcp" => "paste the service account’s JSON key", "scaleway" => "PROJECT_ID:SECRET_KEY", "custom" or "local" => "(not needed)", _ => "API token" };
    static string Ago(double? ms) { if (ms == null) return ""; var s = (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - ms.Value) / 1000; return s < 3600 ? $"{(int)(s / 60)} min ago" : s < 86400 ? $"{(int)(s / 3600)} h ago" : $"{(int)(s / 86400)} days ago"; }
    JsonObject? data; bool open, editing, confirmRemove; string? st, confirmShut;
    string prov = "hetzner", token = "", region = "", plan = "", image = "", billing = "auto", cCmd = "", dCmd = ""; int maxH = 6, idle = 5;
    async Task Open() { open = true; await Run("flash", new JsonObject()); }
    async Task Run(string cmd, JsonObject args)
    {
        st = "…"; StateHasChanged();
        try { var r = await S.NodeCtl(Node, cmd, args); data = r["data"] as JsonObject ?? r; st = null; if (data["mine"] is JsonObject m && !editing) Fill(m); }
        catch (Exception e) { st = "✗ " + e.Message; }
    }
    void Fill(JsonObject m) { prov = (string?)m["provider"] ?? prov; region = (string?)m["region"] ?? ""; plan = (string?)m["plan"] ?? ""; image = (string?)m["image"] ?? ""; billing = (string?)m["billing"] ?? "auto"; maxH = (int)(Js.Num(m["maxHours"]) ?? 6); idle = (int)(Js.Num(m["idleMin"]) ?? 5); cCmd = (string?)m["createCmd"] ?? ""; dCmd = (string?)m["deleteCmd"] ?? ""; }
    async Task Save(bool off)
    {
        if (data?["enc"] is not JsonValue ev) { st = "✗ this computer has no encryption key"; return; }
        st = "Sealing your login for this computer…";
        var obj = off ? new JsonObject { ["off"] = true } : new JsonObject { ["provider"] = prov, ["token"] = token.Trim(), ["region"] = region, ["plan"] = plan, ["image"] = image, ["billing"] = billing, ["maxHours"] = maxH, ["idleMin"] = idle };
        if (!off && Js.IsTrue(data["owner"])) { obj["createCmd"] = cCmd; obj["deleteCmd"] = dCmd; }
        token = ""; editing = false;
        await Run("flash.setup", new JsonObject { ["sealed"] = Sealing.For((string)ev!, obj) });
    }
    async Task Remove() { if (!confirmRemove) { confirmRemove = true; return; } confirmRemove = false; await Save(true); }
    Task StartOne() { st = "Creating the server…"; return Run("flash.start", new JsonObject { ["grant"] = S.Trade.Grant("flash") }); }
    Task Scale(bool on, int per, int max) => Run("flash.scale", new JsonObject { ["on"] = on, ["per"] = per, ["max"] = max });
    async Task Shut(string tag) { if (confirmShut != tag) { confirmShut = tag; return; } confirmShut = null; await Run("flash.stop", new JsonObject { ["tag"] = tag }); }
}
