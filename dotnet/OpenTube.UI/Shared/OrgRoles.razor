@inherits Live
@* An organization's people: roles the owner gives (moderator: flags videos; clerk: takes filings; arbitrator: rules on disputes) *@
<div class="panel">
    <h3>@((string?)S.Genesis(Id)?["payload"]?["orgType"] ?? "Organization")@((string?)S.Genesis(Id)?["payload"]?["jurisdiction"] is { Length: > 0 } j ? " · " + j : "")</h3>
    @{ var roles = S.Trade.Roles(Id); }
    @foreach (var (k, rs) in roles) { <div class="row-item"><span class="grow">@S.NameOf(k)</span>@foreach (var r in rs) { <span class="badge">@Trade.RoleName(r)</span> @if (Mine) { <button @onclick="() => Set(k, r, false)">✕</button> } }</div> }
    @if (roles.Count == 0) { <p class="sub">No roles given yet.</p> }
    @if (Mine)
    {
        <div class="row-actions">
            <input placeholder="Their user ID" @bind="who" class="grow-input" />
            <select @bind="role">@foreach (var r in Trade.OrgRoles) { <option value="@r">@Trade.RoleName(r)</option> }</select>
            <button @onclick="() => Set(who, role, true)">Give role</button>
        </div>
    }
    @if (msg != null) { <div class="sub">@msg</div> }
</div>
@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public bool Mine { get; set; }
    string who = "", role = "moderator"; string? msg;
    async Task Set(string k, string r, bool on) { try { await S.Trade.SetRole(Id, k, r, on); msg = null; who = ""; } catch (Exception e) { msg = e.Message; } }
}
