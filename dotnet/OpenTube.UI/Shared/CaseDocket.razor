@inherits Live
@{
    var d = S.Chain(Id); var g = S.Genesis(Id); var court = (string?)g?["payload"]?["parent"]; var listing = (string?)g?["payload"]?["listing"];
    var L = listing != null ? S.Trade.Get(listing) : null; var items = S.Docket(Id);
    var clerk = d != null && S.IsMine(d.Owner); var judge = court != null && S.IAm(court, "judge");
    var cst = court != null ? S.Org(court) : null;
    var orders = (cst?.Submits ?? []).Where(b => (string?)b["payload"]?["what"] == "order" && (string?)b["payload"]?["case"] == Id && b["payload"]?["sig"] != null && !items.Any(x => (string?)x["payload"]?["ref"] == (string?)b["hash"])).ToList();
}
<div class="panel">
    <div>Court: @if (court != null) { <ChainLink Id="@court" /> } else { <span>—</span> } · status <b>@(S.CaseStatus(Id) ?? "filed")</b></div>
    @if (L != null) { <div class="sub">About the sale <a href="market/item/@listing">“@L.Title”</a>@if (L.L["escrow"] is JsonObject es) { <span> · @ChainActions.Coins(Js.Num(es["amt"]) ?? 0) coins @((string?)es["state"])</span> }</div> }
    <p class="pre">@((string?)g?["payload"]?["about"])</p>
</div>
<div class="panel"><h3>Docket</h3>
    @if (items.Count == 0) { <div class="sub">Nothing on the docket yet.</div> }
    @foreach (var b in items)
    {
        var p = b["payload"]!;
        switch ((string?)p["type"])
        {
            case "status": <div class="item sub">Status → @((string?)p["state"])@((string?)p["note"] is { } n ? " · " + n : "") · @Ago(Js.Num(b["ts"]) ?? 0)</div> break;
            case "order":
                <div class="item"><span class="badge ok">order</span> <b>@((string?)p["title"])</b><span class="sub"> · signed by arbitrator @S.NameOf((string?)p["judge"] ?? "") · @Ago(Js.Num(b["ts"]) ?? 0)</span>
                    @if (Js.Num(p["buyerShare"]) is double bs) { <div>Buyer receives @Math.Round(bs * 100)% of the held coins, the seller the rest.</div> }
                    @if ((string?)p["text"] is { Length: > 0 } ot) { <p class="pre">@ot</p> }</div>
                break;
            default:
                <div class="item"><span class="badge">@((string?)p["what"])</span> <b>@((string?)p["title"])</b><span class="sub"> · by @S.NameOf((string?)p["by"] ?? "") · @Ago(Js.Num(b["ts"]) ?? 0)</span>@if ((string?)p["text"] is { Length: > 0 } ft) { <p class="pre">@ft</p> }</div>
                break;
        }
    }
</div>
@if (clerk)
{
    <div class="panel"><h3>Clerk</h3>
        <div class="row-actions"><select @bind="state">@foreach (var x in Orgs.States) { <option value="@x">@x</option> }</select><input class="grow-input" @bind="note" placeholder="Note" /><button @onclick="SetStatus">Set status</button></div>
        @foreach (var b in orders) { <div class="row-actions"><span>Signed order from arbitrator @S.NameOf((string?)b["payload"]?["judge"] ?? ""): <b>@((string?)b["payload"]?["title"])</b></span><button class="primary" @onclick="() => DocketOrder(b)">Put on the docket</button></div> }
        <p class="sub">You hold this case’s key. To hand the case to another clerk, export it under Keys & backup.</p>
    </div>
}
@if (judge)
{
    <div class="panel"><h3>Arbitrator: write an order</h3>
        <input @bind="otitle" placeholder="Order title" />
        <textarea @bind="otext" rows="3" placeholder="The order"></textarea>
        <div class="row-actions">@if (L?.L["escrow"] != null) { <input type="number" min="0" max="100" @bind="share" placeholder="% to buyer" style="width:120px" /> }<button class="primary" @onclick="() => Sign(court!, listing, L?.L[EscrowKey] != null)">Sign order</button></div>
    </div>
}
@if (msg != null) { <div class="sub" id="case-msg">@msg</div> }
@code {
    [Parameter] public required string Id { get; set; }
    const string EscrowKey = "escrow";
    string state = "open", note = "", otitle = "", otext = ""; double? share; string? msg;
    async Task Run(Func<Task> f, string? done = null) { msg = null; StateHasChanged(); try { await f(); msg = done; } catch (Exception e) { msg = e.Message; } }
    Task DocketOrder(JsonObject b) => Run(() => S.DocketOrder(Id, b), "On the docket.");
    Task SetStatus() => Run(async () => { await S.SetCaseStatus(Id, state, note); note = ""; }, "Status set.");
    Task Sign(string court, string? listing, bool escrow) => Run(async () => { await S.SignOrder(court, Id, otitle, otext, escrow && share != null ? Math.Clamp(share.Value, 0, 100) / 100 : null, listing); otitle = otext = ""; }, "Signed and sent to the clerk.");
}
