@inject OpenTube.Client.ClientSession S
@inject IVideoPlayer Player
@inject IJSRuntime JS
@* Attached pictures and videos: fetched from the network (or your own copy) and decrypted when they came with a key *@
@if (Refs is { Count: > 0 })
{
    <div class="media-row">
        @foreach (var r in Refs.OfType<JsonObject>())
        {
            var ih = (string?)r["ih"] ?? ""; var mime = (string?)r["mime"] ?? ""; var name = (string?)r["name"] ?? "file"; var key = ih + (string?)r["key"];
            var img = mime.StartsWith("image/"); var vid = mime.StartsWith("video/");
            <div class="media-item" title="@name">
                @if (urls.TryGetValue(key, out var u))
                {
                    if (u.StartsWith("!")) { <span class="sub">@u[1..]</span> }
                    else if (img) { <img src="@u" alt="@name" /> }
                    else if (vid) { <video src="@u" controls playsinline></video> }
                    else { <a href="@u" download="@name">⬇ @name</a> }
                }
                else if (img && (Js.Num(r["size"]) ?? 0) < 8e6)
                {
                    if ((string?)r["thumb"] is { Length: > 0 } th) { <img src="@th" alt="@name" /> } else { <span class="sub">@name</span> }
                    Load(r, key);
                }
                else { <button class="media-play" style="@((string?)r["thumb"] is { Length: > 0 } t2 ? $"background-image:url('{t2}')" : "")" @onclick="() => Load(r, key)">@(vid ? "▶" : "⬇") <span class="sub">@name · @Bytes(Js.Num(r["size"]) ?? 0)</span></button> }
            </div>
        }
    </div>
}
@code {
    [Parameter] public JsonArray? Refs { get; set; }
    readonly Dictionary<string, string> urls = []; readonly HashSet<string> loading = [];
    static string Bytes(double n) => n < 1e6 ? $"{n / 1e3:0} KB" : $"{n / 1e6:0.0} MB";
    void Load(JsonObject r, string key)
    {
        if (!loading.Add(key)) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                var ih = (string)r["ih"]!;
                var data = await S.Media.OwnCopy(ih) ?? await Player.Fetch(ih, (string?)r["name"] ?? "file", Js.Num(r["size"]) ?? 0, TimeSpan.FromSeconds(120));
                if (data == null) { urls[key] = "!Nobody online has it right now."; }
                else
                {
                    if ((string?)r["key"] is { } k && await S.Media.OwnCopy(ih) == null) data = OpenTube.Client.Media.Open(data, k, (string)r["iv"]!);
                    urls[key] = await JS.InvokeAsync<string>("otUi.blobUrl", data, (string?)r["mime"] ?? "application/octet-stream");
                }
            }
            catch (Exception e) { urls[key] = "!" + e.Message; }
            StateHasChanged();
        });
    }
}
