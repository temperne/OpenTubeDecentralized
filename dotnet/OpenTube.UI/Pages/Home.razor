@page "/"
@inherits Live
@if (!S.Ready) { <p class="sub">Starting…</p> }
else
{
    var subs = S.Notes.Subscribed;
    var live = S.LiveEverywhere().Where(x => subs.Contains(x.Chain) || subs.Count == 0).ToList();
    @if (live.Count > 0)
    {
        <h2>Live now</h2>
        @foreach (var (c, n, lb) in live) { <a class="live-banner" href="live/@c/@lb["payload"]!["stream"]">🔴 @((string?)lb["payload"]?["title"]) · @n · started @Ago(Js.Num(lb["ts"]) ?? 0)</a> }
    }
    <div class="head-row"><h2>Home</h2>
        <div class="row-actions small-actions"><button class="@(homeView == "all" ? "on" : "")" @onclick="@(() => SetView("all"))">Everything</button><button class="@(homeView == "videos" ? "on" : "")" @onclick="@(() => SetView("videos"))">Videos</button></div>
    </div>
    @if (subs.Count == 0)
    {
        <div class="panel">
            <p>You don’t follow anything yet. <a href="explore">Explore</a> trending videos and channels, and subscribe to the ones you like: their videos and posts show up here.</p>
        </div>
        <h3>Trending</h3>
        <div class="grid">
            @foreach (var i in S.Rank(null).Items.OrderByDescending(i => i.Score).Take(24))
            {
                var v = S.Chain(i.Chain)?.Videos.FirstOrDefault(x => (string?)x["hash"] == i.Video);
                if (v != null && !Muted(v)) { <VideoCard Chain="@i.Chain" Block="(JsonObject)v.DeepClone()" ChannelName="@i.Channel" /> }
            }
        </div>
    }
    else if (homeView == "videos")
    {
        var rank = S.Rank(null).Items.ToDictionary(i => i.Video, i => i.Score);
        var vids = subs.SelectMany(id => S.Chain(id) is { Kind: "channel" } d ? d.Videos.Where(b => S.Engine.PostPaid(b) && !Muted(b)).Select(b => (id, (string?)d.Profile["name"] ?? "", b)) : []).ToList();
        vids = (feedSort == "new" ? vids.OrderByDescending(x => Js.Num(x.b["ts"])) : vids.OrderByDescending(x => rank.GetValueOrDefault((string)x.b["hash"]!)).ThenByDescending(x => Js.Num(x.b["ts"]))).ToList();
        <div class="row-actions small-actions"><button class="@(feedSort != "new" ? "on" : "")" @onclick="@(() => SetSort("hot"))">Hot</button><button class="@(feedSort == "new" ? "on" : "")" @onclick="@(() => SetSort("new"))">Newest</button></div>
        if (vids.Count == 0) { <p class="sub">No videos from your subscriptions yet. <a href="explore">Explore channels</a> or <a href="you/channels">create your own</a>.</p> }
        <div class="grid">@foreach (var (c, n, b) in vids.Take(200)) { <VideoCard Chain="@c" Block="(JsonObject)b.DeepClone()" ChannelName="@n" /> }</div>
    }
    else
    {
        var m = Social.Month(DateTimeOffset.UtcNow);
        <div class="panel">
            <textarea @bind="post" @bind:event="oninput" rows="2" maxlength="1000" placeholder="Share something publicly…"></textarea>
            <div class="row-actions"><button class="primary" disabled="@posting" @onclick="() => Post(m)">Post</button>@if (postMsg != null) { <span class="sub">@postMsg</span> }</div>
        </div>
        <div class="timeline">
            @if (friendPosts != null)
            {
                foreach (var f in friendPosts.Where(f => f.Content != null).Take(10))
                {
                    <div class="panel post"><div class="sub">🔒 <a class="person" href="u/@f.Author">@S.NameOf(f.Author)</a> · friends only · @Ago(f.Ts)</div><Rich Text="@((string?)f.Content!["text"])" /></div>
                }
            }
            @if (timeline == null) { <p class="sub">Loading…</p> }
            else if (timeline.Count == 0) { <p class="sub">Nothing here yet. Subscribe to channels and groups, and follow people, to fill your Home.</p> }
            else
            {
                foreach (var x in timeline.Take(80))
                {
                    switch (x.Kind)
                    {
                        case "video":
                            if (Muted(x.Block)) break;
                            <div class="panel tl-video">
                                <div class="sub">🎬 <ChainLink Id="@x.Chain" /> posted a video · @Ago(x.Ts)@if (x.Via != null) { <span> · in the list <ChainLink Id="@x.Via" /></span> }</div>
                                <VideoCard Chain="@x.Chain" Block="(JsonObject)x.Block.DeepClone()" ChannelName="@((string?)S.Chain(x.Chain)?.Profile["name"])" />
                            </div>
                            break;
                        case "square":
                            var sp = S.Social.PostOf(x.Month!, (string)x.Block["hash"]!);
                            if (sp != null) { <div class="panel"><PostItem P="sp" Month="@(x.Month!)" /></div> }
                            break;
                        default:
                            var d = S.Chain(x.Chain); var a = S.AuthorOf((string)x.Block["author"]!, d, (string?)x.Block["payload"]?["name"] ?? "");
                            <div class="panel post">
                                <div class="sub">@(x.Kind == "gpost" ? "👥 in " : "📣 ")<ChainLink Id="@x.Chain" /> · @Ago(x.Ts)</div>
                                @if (x.Kind == "gpost") { <div><a class="person" href="@a.Href"><b>@a.Name</b></a></div> }
                                <Rich Text="@((string?)x.Block["payload"]?["text"])" />
                                @if (x.Kind == "gpost") { <a class="sub" href="c/@x.Chain">Reply in the group</a> }
                            </div>
                            break;
                    }
                }
            }
        </div>
    }
}
@code {
    string homeView = "all", feedSort = "hot", post = ""; string? postMsg; bool posting; HashSet<string> muted = [];
    List<Feeds.TimelineItem>? timeline; List<Social.Sealed>? friendPosts; DateTime loaded;
    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        if (!S.Ready) return;
        homeView = await S.Social.Pref("homeView") ?? "all"; feedSort = await S.Social.Pref("feedSort") ?? "hot"; muted = (await S.Social.Muted()).Tags;
        await Load();
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (S.Ready && homeView == "all" && DateTime.UtcNow - loaded > TimeSpan.FromSeconds(5)) { await Load(); StateHasChanged(); }
    }
    async Task Load()
    {
        loaded = DateTime.UtcNow;
        timeline = await S.Timeline();
        try { friendPosts = await S.Social.Feed(); } catch { friendPosts = []; }
    }
    bool Muted(JsonObject v) => muted.Count > 0 && (v["payload"]?["tags"] as JsonArray ?? []).Any(t => muted.Contains((string?)t ?? ""));
    async Task SetView(string v) { homeView = v; await S.Social.SetPref("homeView", v); }
    async Task SetSort(string v) { feedSort = v; await S.Social.SetPref("feedSort", v); }
    async Task Post(string m)
    {
        if (post.Trim().Length == 0) return;
        posting = true; postMsg = "Anti-spam work…"; StateHasChanged();
        try { await S.Social.PostTo(m, post); post = ""; postMsg = null; await Load(); } catch (Exception e) { postMsg = e.Message; }
        posting = false;
    }
}
