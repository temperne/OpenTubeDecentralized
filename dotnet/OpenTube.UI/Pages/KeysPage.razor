@page "/you/keys"
@inherits Live
@inject IDeviceFiles Files
@using Microsoft.AspNetCore.Components.Forms
<p><a href="you">← You</a></p>
<h2>Keys & backup</h2>
@if (!S.Ready) { <p class="sub">Starting…</p> }
else
{
    <div class="panel @(unbacked > 0 ? "warn" : "")">
        <div class="head-row"><h3>Back up</h3>@if (unbacked > 0) { <span class="badge warnb">@unbacked key@(unbacked == 1 ? "" : "s") not backed up</span> } else { <span class="badge ok">all keys backed up</span> }</div>
        <p class="sub">Your keys exist only on this device. Whoever holds a channel’s key controls that channel. “Back up all keys” saves your personal key (with your encryption and messaging keys) and every channel and list key in one file, locked with a password you choose: without it the file is useless, so remember it (nobody can recover it). “Import keys” takes that file, or any single key file, here or on the website.</p>
        <label>Password for exported files (at least @KeyFile.MinPassword characters)</label>
        <div class="row-actions"><input type="password" id="keys-pass" @bind="pass" @bind:event="oninput" autocomplete="new-password" class="grow-input" placeholder="Password" /><input type="password" id="keys-pass2" @bind="pass2" @bind:event="oninput" autocomplete="new-password" class="grow-input" placeholder="Repeat it" /></div>
        <div class="row-actions">
            <button class="primary" @onclick="Backup">Back up all keys</button>
            <label class="button file-button">Import keys <InputFile OnChange="Import" accept=".json,application/json" /></label>
        </div>
        @if (locked != null)
        {
            <div class="panel">
                <p>This file is locked with a password. Enter it to import the keys.</p>
                <div class="row-actions"><input type="password" id="keys-unlock" @bind="unlockPass" @bind:event="oninput" autocomplete="current-password" class="grow-input" placeholder="Password" @onkeydown="UnlockKey" /><button class="primary" @onclick="Unlock">Unlock and import</button><button @onclick="CancelUnlock">Cancel</button></div>
            </div>
        }
        @if (pending != null)
        {
            <div class="panel">
                <p>This file has a different personal key@(pendingControls > 0 ? $" (it controls {pendingControls} older channel(s) or list(s))" : ""). Use it on this device? Your current personal key is replaced: back it up first if it matters.</p>
                <div class="row-actions"><button class="primary" @onclick="UsePending">Use the key from the file</button><button @onclick="() => pending = null">Keep mine</button></div>
            </div>
        }
    </div>
    <div class="panel">
        <h3>Your user ID</h3>
        <div class="mono">@S.Me.pub</div>
        <label>Display name (on your comments and posts)</label>
        <div class="row-actions"><input @bind="name" maxlength="60" class="grow-input" /><button @onclick="SaveName">Save</button></div>
    </div>
    <div class="panel">
        <h3>Your channels & lists</h3>
        @{ var (bound, all) = S.Keys.BoundCount(); }
        <p class="sub">Each has its own key, bound to your identity so its coins land in your balance (@bound of @all bound).</p>
        @foreach (var c in S.Keys.Channels())
        {
            <div class="row-item">
                <span class="grow"><b>@(c.Name.Length > 0 ? c.Name : c.Pub[..8])</b> <span class="sub">@c.Kind</span></span>
                <button @onclick="() => Export(c.Pub)">@(c.Exported ? "Export key" : "Export key ⚠")</button>
                @if (c.Chain != null) { <button @onclick="() => rekey = c.Chain">New key…</button> }
            </div>
            @if (rekey == c.Chain && c.Chain != null)
            {
                <div class="panel"><p>Give @c.Name a new key and retire the current one? Export the new key afterwards.</p><div class="row-actions"><button class="primary" @onclick="() => Rekey(c.Chain)">Replace its key</button><button @onclick="() => rekey = null">Cancel</button></div></div>
            }
        }
        @if (S.Keys.Channels().Count == 0) { <p class="sub">None yet.</p> }
    </div>
    <div class="panel">
        <h3>Messaging keys</h3>
        <p class="sub">Messages to you are encrypted to one of these (the newest is used). Retire one if it may have leaked: new messages then use the others.</p>
        @if (mkeys != null)
        {
            foreach (var (pub, published, retired) in mkeys)
            {
                <div class="row-item"><span class="grow mono">@pub[..24]… · @(retired ? "retired" : published ? "published" : "not published yet")</span>
                    @if (published && !retired) { <button @onclick="() => Run(() => S.Mail.RetireKey(pub))">Retire</button> }</div>
            }
        }
        <button @onclick="() => Run(() => S.Mail.NewKey())">New messaging key</button>
    </div>
    <div class="panel">
        <h3>If your personal key may have leaked</h3>
        <p class="sub">Retire it: a new key takes over your coins, your channels (through their bindings) and your pages, and the old one can’t send anything any more. Your encryption and messaging keys stay, so friends still read you.</p>
        @if (!confirmRetire) { <button @onclick="() => confirmRetire = true">Retire my personal key…</button> }
        else { <div class="row-actions"><button class="primary" @onclick="Retire">Yes: make a new key and retire this one</button><button @onclick="() => confirmRetire = false">Cancel</button></div> }
    </div>
}
@if (msg != null) { <div class="sub" id="keys-status">@msg</div> }
@code {
    int unbacked; string name = "", pass = "", pass2 = "", unlockPass = ""; string? locked; string? msg, rekey; bool confirmRetire;
    System.Text.Json.Nodes.JsonObject? pending; int pendingControls;
    List<(string, bool, bool)>? mkeys;
    protected override async Task OnInitializedAsync() { base.OnInitialized(); S.Keys.Changed += Reload; S.Mail.Changed += Reload; await Load(); }
    async Task Load() { unbacked = await S.Keys.NotBackedUp(); if (name.Length == 0) name = await S.Keys.Name(); mkeys = await S.Mail.KeyList(); }
    void Reload() => InvokeAsync(async () => { await Load(); StateHasChanged(); });
    async Task Run(Func<Task> f, string doing = "Working (a little proof of work)…") { msg = doing; StateHasChanged(); try { await f(); msg = "Done."; } catch (Exception e) { msg = e.Message; } await Load(); }
    string? PassProblem() => pass.Length < KeyFile.MinPassword ? $"First choose a password of at least {KeyFile.MinPassword} characters (under Back up): the file is locked with it." : pass != pass2 ? "The two passwords don’t match." : null;
    Task Backup() => PassProblem() is { } p ? Say(p) : Run(async () => { var (n, t) = await S.Keys.BackupAll(pass); await Files.Save(n, t); }, "Locking and saving…");
    Task Export(string pub) => PassProblem() is { } p ? Say(p) : Run(async () => { var (n, t) = await S.Keys.ExportChannel(pub, pass); await Files.Save(n, t); }, "Locking and saving…");
    Task Say(string m) { msg = m; return Task.CompletedTask; }
    async Task Import(InputFileChangeEventArgs e)
    {
        try
        {
            using var r = new StreamReader(e.File.OpenReadStream(1 << 20)); var text = await r.ReadToEndAsync();
            if (KeyFile.IsEncrypted(text)) { locked = text; unlockPass = ""; msg = null; return; }
            await ImportText(text, null);
        }
        catch (Exception ex) { msg = ex.Message; }
    }
    Task UnlockKey(KeyboardEventArgs e) => e.Key == "Enter" ? Unlock() : Task.CompletedTask;
    void CancelUnlock() { locked = null; unlockPass = ""; }
    async Task Unlock()
    {
        if (locked == null) return;
        msg = "Unlocking…"; StateHasChanged();
        try { await ImportText(locked, unlockPass); locked = null; unlockPass = ""; }
        catch (Exception ex) { msg = ex.Message; }
    }
    async Task ImportText(string text, string? password)
    {
        var (res, personal) = await S.Keys.Import(text, password);
        pending = personal; pendingControls = res.Controls;
        msg = res.Channels > 0 ? $"Imported {res.Channels} channel/list key{(res.Channels == 1 ? "" : "s")}." : personal != null ? null : "Those keys are already here.";
        await Load();
    }
    async Task UsePending() { await S.Keys.UsePersonal(pending!); msg = "Using the key from the file: restarting…"; StateHasChanged(); await Files.Restart(); }
    Task Rekey(string chain) => Run(async () => { await S.Keys.RekeyChannel(chain); rekey = null; });
    async Task Retire()
    {
        try { await S.Keys.RetirePersonal(st => { msg = st; InvokeAsync(StateHasChanged); }); await Task.Delay(1500); await Files.Restart(); }
        catch (Exception e) { msg = "Failed: " + e.Message; }
    }
    async Task SaveName() { await S.Keys.SetName(name); msg = "Saved."; }
    public override void Dispose() { base.Dispose(); S.Keys.Changed -= Reload; S.Mail.Changed -= Reload; }
}
