@page "/devices"
@inherits Live
@using System.Text.Json.Nodes
<h2>Devices</h2>
<p class="sub">Your computers run OpenTube: they keep the network, host your videos, receive OBS, and watch for you while your phone sleeps.</p>
@foreach (var (n, perms, at) in S.MyNodes())
{
    var info = Info(n); var online = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - at < 120000; var owner = perms.Contains('o') && perms.Contains('m') && Owner(n);
    <div class="panel">
        <div class="head-row"><h3>@((string?)info?["name"] ?? "computer")</h3><span class="badge @(online ? "ok" : "")">@(online ? "online" : "offline " + Ago(at))</span></div>
        <div class="sub">@(owner ? "yours" : "shared with you") · @string.Join(", ", Roles(n)) @((string?)info?["public"] is { } pub ? " · " + pub : "")</div>
        <div class="row-actions">
            @if (perms.Contains('o')) { <a class="button" href="golive">🎥 OBS & go live</a> }
            @if (owner)
            {
                <button @onclick='() => Open(n, "files")'>📁 Files</button>
                <button @onclick='() => Open(n, "users")'>👥 People</button>
                <button @onclick='() => Open(n, "logs")'>📜 Log</button>
                <select @onchange='e => Do(n, "public.set", new JsonObject { ["mode"] = (string)e.Value! })'><option value="">Public access…</option><option value="auto">Auto (own HTTPS, else a tunnel)</option><option value="tunnel">Always a tunnel</option><option value="off">Off</option></select>
                <button @onclick='() => Do(n, "update", null)'>⟳ Update now</button>
            }
        </div>
        @if (openNode == n && view != null)
        {
            <div class="panel">
                @if (openWhat == "files")
                {
                    foreach (var ch in view["channels"] as JsonArray ?? [])
                    {
                        <div><b>@((string?)ch?["name"])</b></div>
                        foreach (var v in ch?["videos"] as JsonArray ?? [])
                        {
                            var ih = (string?)v?["ih"] ?? "";
                            <div class="row-item"><span class="grow">@((string?)v?["title"] ?? ih[..8]) <span class="sub">@(Js.IsTrue(v?["complete"]) ? "complete" : "downloading")@(Js.IsTrue(v?["pinned"]) ? " · pinned" : "")</span></span>
                                <button @onclick='() => Do(n, "pin", new JsonObject { ["ih"] = ih, ["on"] = !Js.IsTrue(v?["pinned"]) }, true)'>@(Js.IsTrue(v?["pinned"]) ? "Unpin" : "Pin")</button>
                                <button @onclick='() => Do(n, "drop", new JsonObject { ["ih"] = ih }, true)'>Delete here</button></div>
                        }
                    }
                    <div class="sub">Limit per joined channel: @(Js.Num(view["capGB"]) ?? 0) GB</div>
                }
                else if (openWhat == "users")
                {
                    foreach (var (k, u) in view["users"] as JsonObject ?? [])
                    {
                        <div class="row-item"><span class="grow">@((string?)u?["name"] is { Length: > 0 } nm ? nm : S.NameOf(k))</span><span class="sub">@string.Join(", ", (u?["can"] as JsonArray ?? []).Select(x => (string?)x))</span><button @onclick='() => Share(n, k, "", [])'>Remove</button></div>
                    }
                    <div class="row-actions"><input placeholder="Their user ID" @bind="shareKey" class="grow-input" /><input placeholder="Name" @bind="shareName" style="max-width:140px" /></div>
                    <div class="row-actions">@foreach (var c in new[] { "obs", "host", "manage" }) { <label class="check"><input type="checkbox" checked="@shareCan.Contains(c)" @onchange="e => { if (e.Value is true) shareCan.Add(c); else shareCan.Remove(c); }" /> @c</label> }<button @onclick="() => Share(n, shareKey, shareName, shareCan.ToList())">Share</button></div>
                }
                else if (openWhat == "logs") { <pre class="log">@string.Join("\n", (view["lines"] as JsonArray ?? []).Select(x => (string?)x).TakeLast(80))</pre> }
            </div>
        }
    </div>
}
@if (S.MyNodes().Count == 0) { <p class="sub">No computers yet. Add one below.</p> }
<div class="panel">
    <h3>Add a computer</h3>
    <p class="sub">Run one command on it (Linux, Mac, or Windows PowerShell). It installs .NET if needed, runs OpenTube as yours, and updates itself. Don’t share the command: whoever runs it runs a computer that is yours.</p>
    <div class="row-actions"><input placeholder="Its name (e.g. Home server)" @bind="label" class="grow-input" /><button class="primary" @onclick="() => grant = S.Trade.Grant(label)">Make the command</button></div>
    @if (grant != null)
    {
        <div class="sub">Linux or Mac:</div><div class="mono cmd">curl -fsSL @S.Site/opentube-dotnet.sh | bash -s -- --site=@S.Site --grant=@grant</div>
        <div class="sub">Windows (PowerShell):</div><div class="mono cmd">powershell -NoProfile -ExecutionPolicy Bypass -Command "&amp; ([scriptblock]::Create((irm @S.Site/opentube-dotnet.ps1))) --site=@S.Site --grant=@grant"</div>
    }
</div>
@if (msg != null) { <div class="sub" id="devices-status">@msg</div> }
@code {
    string? openNode, openWhat, msg, grant; JsonObject? view;
    string label = "", shareKey = "", shareName = ""; readonly HashSet<string> shareCan = ["obs"];
    JsonObject? Info(string n) => S.Engine.Read(e => e.Nodes.TryGetValue(n, out var x) ? x["info"]?.DeepClone() as JsonObject : null);
    IEnumerable<string> Roles(string n) => S.Engine.Read(e => e.Nodes.TryGetValue(n, out var x) ? (x["roles"] as JsonArray ?? []).Select(r => (string?)r).OfType<string>().ToList() : []);
    bool Owner(string n) => S.Engine.Read(e => e.Nodes.TryGetValue(n, out var x) && (string?)x["grant"]?["user"] == S.Me.pub);
    async Task Open(string n, string what)
    {
        openNode = n; openWhat = what; view = null; msg = "Asking the computer…";
        try { view = await S.NodeCtl(n, what, what == "logs" ? new JsonObject { ["n"] = 120 } : null); msg = null; } catch (Exception e) { msg = e.Message; }
    }
    async Task Do(string n, string cmd, JsonObject? args, bool reopen = false)
    {
        if (cmd == "public.set" && (string?)args?["mode"] is not { Length: > 0 }) return;
        msg = "Asking the computer…";
        try { await S.NodeCtl(n, cmd, args); msg = cmd == "update" ? "Updating: it restarts when it’s done." : "Done."; if (reopen && openWhat != null) await Open(n, openWhat); }
        catch (Exception e) { msg = e.Message; }
    }
    async Task Share(string n, string key, string name, List<string> can)
    {
        msg = "Asking the computer…";
        try { view = await S.NodeCtl(n, "users.set", new JsonObject { ["key"] = key.Trim(), ["name"] = name, ["can"] = new JsonArray(can.Select(c => (JsonNode?)c).ToArray()) }); openWhat = "users"; msg = null; shareKey = shareName = ""; }
        catch (Exception e) { msg = e.Message; }
    }
}
