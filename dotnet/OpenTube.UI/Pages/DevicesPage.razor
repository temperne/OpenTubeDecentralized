@page "/devices"
@inherits Live
@using System.Text.Json.Nodes
<div class="head-row"><h2>Devices</h2><a href="network">📡 Network &amp; diagnostics</a></div>
<p class="sub">Your computers run OpenTube: they keep the network, host your videos, receive OBS, and watch for you while your phone sleeps.</p>
@foreach (var (n, perms, at) in S.MyNodes())
{
    var info = Info(n); var online = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - at < 120000; var owner = perms.Contains('o') && perms.Contains('m') && Owner(n);
    <div class="panel">
        <div class="head-row"><h3>@((string?)info?["name"] ?? "computer")</h3><span class="badge @(online ? "ok" : "")">@(online ? "online" : "offline " + Ago(at))</span></div>
        <div class="sub">@(owner ? "yours" : perms.Contains('g') ? "you’re invited to a group stream on it" : "shared with you") · @string.Join(" · ", Roles(n).Select(r => r switch { "node" => "full node", "host" => "host", "obs" => "OBS receiver", _ => r })) @((string?)info?["public"] is { } pub ? " · " + pub : "")</div>
        <div class="sub">@InfoLine(info)</div>
        @if (info?["host"] is JsonObject ho) { <div class="sub">Hosting @(Js.Num(ho["hosting"]) ?? 0) videos (@Bytes((long)(Js.Num(ho["hostedBytes"]) ?? 0))) for @(Js.Num(ho["channels"]) ?? 0) joined channels in @((string?)ho["videoDir"] ?? "its folder")@(Js.Num(ho["downloading"]) is > 0 and var dl ? $" · downloading {dl}" : "")</div> }
        @if (info?["obs"] is JsonObject ob) { <div class="sub @((string?)ob["error"] != null || ob["listening"]?.GetValue<bool>() == false ? "warn-text" : "")">@ObsLine(ob)</div> }
        @if (info?["flash"] is JsonObject fl) { <div class="sub">⚡ Flash computer of <b>@(Info((string?)fl["parent"] ?? "")?["name"] ?? "one of your computers")</b> — it’s deleted when idle and its recordings are copied there.</div> }
        <div class="row-actions">
            <button @onclick="() => Test(n, info)">Test connection</button>
            @if (perms.Contains('o')) { <a class="button" href="golive">🎥 OBS & go live</a> }
            @if (owner)
            {
                <button @onclick='() => Open(n, "files")'>📁 Files</button>
                <button @onclick='() => Open(n, "users")'>👥 People</button>
                <button @onclick='() => Open(n, "logs")'>📜 Log</button>
                <select @onchange='e => Do(n, "public.set", new JsonObject { ["mode"] = (string)e.Value! })'><option value="">Public access…</option><option value="auto">Auto (own HTTPS, else a tunnel)</option><option value="tunnel">Always a tunnel</option><option value="off">Off</option></select>
                <button @onclick='() => Do(n, "update", null)'>⟳ Update now</button>
            }
        </div>
        @if (tests.TryGetValue(n, out var tr)) { <div class="sub test-result">@tr</div> }
        @if (online && info?["enc"] != null && !perms.Contains('g')) { <FlashPanel Node="@n" /> }
        @if (openNode == n && view != null)
        {
            <div class="panel">
                @if (openWhat == "files")
                {
                    foreach (var ch in view["channels"] as JsonArray ?? [])
                    {
                        <div><b>@((string?)ch?["name"])</b></div>
                        foreach (var v in ch?["videos"] as JsonArray ?? [])
                        {
                            var ih = (string?)v?["ih"] ?? "";
                            <div class="row-item"><span class="grow">@((string?)v?["title"] ?? ih[..8]) <span class="sub">@(Js.IsTrue(v?["complete"]) ? "complete" : "downloading")@(Js.IsTrue(v?["pinned"]) ? " · pinned" : "")</span></span>
                                <button @onclick='() => Do(n, "pin", new JsonObject { ["ih"] = ih, ["on"] = !Js.IsTrue(v?["pinned"]) }, true)'>@(Js.IsTrue(v?["pinned"]) ? "Unpin" : "Pin")</button>
                                <button @onclick='() => Do(n, "drop", new JsonObject { ["ih"] = ih }, true)'>Delete here</button></div>
                        }
                    }
                    <div class="sub">Limit per joined channel: @(Js.Num(view["capGB"]) ?? 0) GB</div>
                }
                else if (openWhat == "users")
                {
                    foreach (var (k, u) in view["users"] as JsonObject ?? [])
                    {
                        <div class="row-item"><span class="grow">@((string?)u?["name"] is { Length: > 0 } nm ? nm : S.NameOf(k))</span><span class="sub">@string.Join(", ", (u?["can"] as JsonArray ?? []).Select(x => (string?)x))</span><button @onclick='() => Share(n, k, "", [])'>Remove</button></div>
                    }
                    <div class="row-actions"><input placeholder="Their user ID" @bind="shareKey" class="grow-input" /><input placeholder="Name" @bind="shareName" style="max-width:140px" /></div>
                    <div class="row-actions">@foreach (var c in new[] { "obs", "host", "manage" }) { <label class="check"><input type="checkbox" checked="@shareCan.Contains(c)" @onchange="e => { if (e.Value is true) shareCan.Add(c); else shareCan.Remove(c); }" /> @c</label> }<button @onclick="() => Share(n, shareKey, shareName, shareCan.ToList())">Share</button></div>
                }
                else if (openWhat == "logs") { <pre class="log">@string.Join("\n", (view["lines"] as JsonArray ?? []).Select(x => (string?)x).TakeLast(80))</pre> }
            </div>
        }
    </div>
}
@if (S.MyNodes().Count == 0) { <p class="sub">No computers yet. Add one below.</p> }
<div class="panel">
    <h3>Add a computer</h3>
    <p class="sub">Run one command on it (Linux, Mac, or Windows PowerShell). It installs .NET if needed, runs OpenTube as yours, and updates itself. Don’t share the command: whoever runs it runs a computer that is yours.</p>
    <div class="row-actions"><input placeholder="Its name (e.g. Home server)" @bind="label" class="grow-input" /><button class="primary" @onclick="() => grant = S.Trade.Grant(label)">Make the command</button></div>
    @if (grant != null)
    {
        <div class="sub">Linux or Mac:</div><div class="mono cmd">curl -fsSL @S.Site/opentube-dotnet.sh | bash -s -- --site=@S.Site --grant=@grant</div>
        <div class="sub">Windows (PowerShell):</div><div class="mono cmd">powershell -NoProfile -ExecutionPolicy Bypass -Command "&amp; ([scriptblock]::Create((irm @S.Site/opentube-dotnet.ps1))) --site=@S.Site --grant=@grant"</div>
        <div class="row-actions"><button @onclick="() => Copy(UnixCmd)">Copy command (Linux/Mac)</button><button @onclick="() => Copy(WinCmd)">Copy command (Windows)</button></div>
    }
</div>
<div class="panel" id="earnings">
    <h3>Earned by your nodes</h3>
    <p class="sub">Every @(Coin.EpochMs / 60000) minutes the network pays nodes for what they provided, from signed receipts by the people they served: @string.Join(", ", Coin.ServeRes.Select(r => $"{ChainActions.Coins(r.Pool)} new coins by {ResText(r.Res)}")), plus @(Coin.FeeShare * 100)% of the period’s watch, like and post payments. Payouts land about an hour after the period. Run a node (Add a computer, above) to earn.</p>
    @{ var rows = Earnings(); }
    @if (rows.Count == 0) { <div class="sub">Nothing yet.</div> }
    else
    {
        <div class="sub">Last @rows.Count: @ChainActions.Coins(rows.Sum(x => x.Amt)) coins</div>
        @foreach (var x in rows) { <div class="row-item"><span class="grow"><span class="amt-in">+@ChainActions.Coins(x.Amt)</span> @ResText(x.Res) · @(x.Res == "bytes" ? Bytes((long)x.Units) : x.Res == "storage" ? Bytes((long)x.Units * 1000000) : $"{Math.Round(x.Units / 60)} min")@if (x.Key != S.Me.pub) { <span class="sub"> → @S.NameOf(x.Key)</span> }</span><span class="sub">@DateTimeOffset.FromUnixTimeMilliseconds((long)(x.E * Coin.EpochMs)).ToLocalTime().ToString("MMM d HH:mm")</span></div> }
    }
</div>
@if (msg != null) { <div class="sub" id="devices-status">@msg</div> }
@code {
    string? openNode, openWhat, msg, grant; JsonObject? view; readonly Dictionary<string, string> tests = [];
    [Inject] IJSRuntime JS { get; set; } = null!;
    string UnixCmd => $"curl -fsSL {S.Site}/opentube-dotnet.sh | bash -s -- --site={S.Site} --grant={grant}";
    string WinCmd => $"powershell -NoProfile -ExecutionPolicy Bypass -Command \"& ([scriptblock]::Create((irm {S.Site}/opentube-dotnet.ps1))) --site={S.Site} --grant={grant}\"";
    async Task Copy(string t) { try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", t); msg = "Command copied. Paste it into a terminal on that computer."; } catch { msg = "Couldn’t copy: select the command and copy it."; } }
    static string ResText(string r) => r switch { "bytes" => "video served", "uptime" => "time connected", "tracker" => "tracker service", "storage" => "storage kept", _ => r };
    static string InfoLine(JsonObject? i) => i == null ? "" : string.Join(" · ", new[] { (string?)i["os"], (string?)i["node"] is { } nv ? "Node " + nv : null, Js.Num(i["height"]) is { } h ? $"main #{h}" : null, Js.Num(i["peers"]) is { } p ? $"{p} peer(s)" : null, Js.Num(i["chains"]) is { } c ? $"{c} chains" : null, (string?)i["version"]?["build"] is { } b ? "build " + b[..Math.Min(8, b.Length)] : null }.Where(x => x != null));
    string ObsLine(JsonObject o) => (string?)o["error"] is { } er ? "⚠ OBS: " + er : o["listening"]?.GetValue<bool>() == false ? "⚠ OBS: not listening" : Js.IsTrue(o["live"]) ? $"OBS: streaming now ({Bytes((long)(Js.Num(o["bytes"]) ?? 0))})" : Js.IsTrue(o["armed"]) ? "OBS: ready, waiting for Start Streaming" : $"OBS: listening on port {Js.Num(o["port"])} (stream key and server under OBS & go live)";
    record struct Earn(string Key, double E, string Res, double Units, double Amt);
    List<Earn> Earnings()
    {
        var keys = S.Directory().Where(c => S.IsMine(c.Owner)).Select(c => c.Owner!).Append(S.Me.pub).ToHashSet();
        return S.Engine.Read(e => keys.Where(k => k == S.Me.pub || (e.Store.Ledger.Resolve(k) != S.Me.pub && !e.Store.Ledger.Retired.Contains(k)))
            .SelectMany(k => e.Store.Ledger.Earned.TryGetValue(k, out var l) ? l.Select(x => new Earn(k, Js.Num(x["e"]) ?? 0, (string?)x["res"] ?? "", Js.Num(x["units"]) ?? 0, Js.Num(x["amt"]) ?? 0)).ToList() : [])
            .OrderByDescending(x => x.E).ThenBy(x => x.Res).Take(30).ToList());
    }
    async Task Test(string n, JsonObject? info)
    {
        var addrs = (S.Engine.Read(e => e.Nodes.TryGetValue(n, out var x) ? (x["addrs"] as JsonArray ?? []).Select(a => (string?)a).OfType<string>().ToList() : [])).Concat(((string?)info?["public"] is { Length: > 0 } pub && pub.StartsWith("http") ? [pub] : Array.Empty<string>())).Distinct().ToList();
        tests[n] = "Testing…"; StateHasChanged();
        var res = new List<string>();
        try { var t0 = DateTime.UtcNow; var r = await S.NodeCtl(n, "logs", new JsonObject { ["n"] = 1 }); res.Add($"through the network ✓ ({(int)(DateTime.UtcNow - t0).TotalMilliseconds} ms)"); } catch (Exception e) { res.Add("through the network ✗ " + e.Message); }
        foreach (var a in addrs)
        {
            try { var j = await JS.InvokeAsync<JsonObject>("otUi.status", a.TrimEnd('/') + "/status"); res.Add($"{a} ✓ (main #{Js.Num(j["height"])})"); }
            catch { res.Add(a + " ✗"); }
        }
        tests[n] = string.Join(" · ", res) + (res.Any(x => x.Contains('✗')) && addrs.Count > 0 ? ". ✗ is normal for addresses inside another home network; the computer still syncs and hosts through the network." : "");
    }
    string label = "", shareKey = "", shareName = ""; readonly HashSet<string> shareCan = ["obs"];
    JsonObject? Info(string n) => S.Engine.Read(e => e.Nodes.TryGetValue(n, out var x) ? x["info"]?.DeepClone() as JsonObject : null);
    IEnumerable<string> Roles(string n) => S.Engine.Read(e => e.Nodes.TryGetValue(n, out var x) ? (x["roles"] as JsonArray ?? []).Select(r => (string?)r).OfType<string>().ToList() : []);
    bool Owner(string n) => S.Engine.Read(e => e.Nodes.TryGetValue(n, out var x) && (string?)x["grant"]?["user"] == S.Me.pub);
    async Task Open(string n, string what)
    {
        openNode = n; openWhat = what; view = null; msg = "Asking the computer…";
        try { view = await S.NodeCtl(n, what, what == "logs" ? new JsonObject { ["n"] = 120 } : null); msg = null; } catch (Exception e) { msg = e.Message; }
    }
    async Task Do(string n, string cmd, JsonObject? args, bool reopen = false)
    {
        if (cmd == "public.set" && (string?)args?["mode"] is not { Length: > 0 }) return;
        msg = "Asking the computer…";
        try { await S.NodeCtl(n, cmd, args); msg = cmd == "update" ? "Updating: it restarts when it’s done." : "Done."; if (reopen && openWhat != null) await Open(n, openWhat); }
        catch (Exception e) { msg = e.Message; }
    }
    async Task Share(string n, string key, string name, List<string> can)
    {
        msg = "Asking the computer…";
        try { view = await S.NodeCtl(n, "users.set", new JsonObject { ["key"] = key.Trim(), ["name"] = name, ["can"] = new JsonArray(can.Select(c => (JsonNode?)c).ToArray()) }); openWhat = "users"; msg = null; shareKey = shareName = ""; }
        catch (Exception e) { msg = e.Message; }
    }
}
