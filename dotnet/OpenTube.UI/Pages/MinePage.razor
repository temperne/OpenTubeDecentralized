@page "/mine"
@inherits Live
@inject IJSRuntime JS
<h2>@(Mine().Count > 1 ? "My channels" : "My channel")</h2>
@if (!S.Ready) { <p class="sub">Starting…</p> }
else if (Mine().Count == 0)
{
    <div class="panel"><h2>Create your channel first</h2><p>To add videos or go live, you need a channel. It takes a few seconds.</p><a class="button primary-link" href="you/channels">Create a channel</a></div>
}
else
{
    @foreach (var c in Mine())
    {
        var d = S.Chain(c.Id); var handle = S.NameOfChain(c.Id); var registered = S.Engine.Read(e => e.Store.Directory.ContainsKey(c.Id));
        <div class="panel channel-head">
            @if (c.Avatar is { Length: > 0 } av) { <img class="avatar big" src="@av" alt="" /> } else { <span class="avatar big empty">@(c.Name.Length > 0 ? c.Name[..1].ToUpperInvariant() : "?")</span> }
            <div class="grow">
                <h3><a href="c/@c.Id">@c.Name</a> @if (d?.LiveNow.Count > 0) { <span class="badge live">LIVE</span> }</h3>
                <div class="sub">@if (handle != null) { <a href="n/@Uri.EscapeDataString(handle)">@handle</a> } else { <a href="c/@c.Id/manage">Claim an @@name for a short link</a> }@(registered ? "" : " · registration pending") · @c.Videos videos</div>
                <div class="row-actions">
                    <a class="button primary-link" href="upload/@c.Id">＋ Add video</a><a class="button live-link" href="golive/@c.Id">● Go live</a>
                    <a class="button" href="c/@c.Id">Videos</a><a class="button" href="c/@c.Id/manage">Manage</a>
                    @if (handle != null) { <button @onclick="() => Copy(S.Site + '/' + handle)">Copy link</button> }
                </div>
            </div>
        </div>
    }
    @if (msg != null) { <div class="sub">@msg</div> }
}
@code {
    string? msg;
    List<ChainInfo> Mine() => S.Directory().Where(c => c.Kind == "channel" && S.IsMine(c.Owner)).ToList();
    async Task Copy(string t) { try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", t); msg = "Link copied."; } catch { msg = t; } }
}
