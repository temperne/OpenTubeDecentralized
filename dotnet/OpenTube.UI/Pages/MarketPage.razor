@page "/market"
@page "/market/{Tab}"
@inherits Live
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
<div class="head-row"><h2>Market</h2><span class="sub">You have @Trade.Coins(S.Trade.Balance) coins</span></div>
<div class="tabs">@foreach (var (k, l) in tabs) { <a href="market/@k" class="@(T == k ? "active" : "")">@l</a> }</div>
@if (!S.Ready) { <p class="sub">Starting…</p> }
else if (T == "new")
{
    var K = Market.Kinds.First(k => k.Key == d.Type);
    <div class="panel" style="max-width:720px">
        <h3>Sell something</h3>
        <p class="sub">Listings live on the main chain. Coins move through the network. Ad views move automatically. Anything else (goods, services, gift cards, cash deals) is delivered by you, using the contact you give.</p>
        <label>What are you listing?</label>
        <select value="@d.Type" @onchange="e => { d.Type = (string)e.Value!; d.Fields.Clear(); if (d.Type == HousingKey) d.Category = HousingKey; if (d.Type is JobKey or WantedKey) d.Kind = FixedKey; }">@foreach (var k in Market.Kinds) { <option value="@k.Key">@k.Icon @k.Name</option> }</select>
        <label>How it sells</label>
        <select @bind="d.Kind"><option value="fixed">Fixed price</option><option value="auction">Auction</option></select>
        @if (d.Kind == "auction") { <div class="row-actions"><span>Ends in</span><input type="number" min="1" max="30" @bind="d.Days" style="width:80px" /><span>days</span></div> }
        <label>Payment protection</label>
        <select @bind="d.Org"><option value="">No escrow: I’m paid at once</option>@foreach (var a in S.Trade.Orgs()) { <option value="@a.Id">Escrow, disputes arbitrated by @a.Name</option> }</select>
        <label>Title</label><input @bind="d.Title" maxlength="120" placeholder="What are you selling?" />
        <label>Description</label><textarea @bind="d.About" rows="3" maxlength="2000" placeholder="Description, condition, delivery…"></textarea>
        <div class="fields">
            @foreach (var f in K.Fields)
            {
                <div>
                    @if (f.Type == "bool") { <label class="check"><input type="checkbox" checked="@(d.Fields.GetValueOrDefault(f.Key) == "true")" @onchange="e => d.Fields[f.Key] = (bool)e.Value! ? TrueText : FalseText" /> @f.Label</label> }
                    else
                    {
                        <label>@f.Label</label>
                        @if (f.Choices != null) { <select value="@d.Fields.GetValueOrDefault(f.Key)" @onchange="e => d.Fields[f.Key] = (string)e.Value!"><option value="">@f.Label…</option>@foreach (var o in f.Choices) { <option value="@o">@o</option> }</select> }
                        else { <input type="@(f.Type switch { NumberKey => NumberKey, DateKey => DateKey, DateTimeKey => "datetime-local", _ => "text" })" value="@d.Fields.GetValueOrDefault(f.Key)" @onchange="e => d.Fields[f.Key] = (string?)e.Value ?? string.Empty" maxlength="160" /> }
                    }
                </div>
            }
        </div>
        <label>@(K.PriceLabel ?? (d.Kind == "auction" ? "Starting bid (coins)" : "Price (coins)"))</label><input @bind="d.Price" inputmode="decimal" />
        <label>Contact</label><input @bind="d.Contact" maxlength="200" placeholder="How the buyer reaches you (email, site, shop link): public" />
        <div class="fields">
            <div><label>Category (optional)</label><select @bind="d.Category"><option value="">—</option>@foreach (var (k, n) in Market.Categories) { <option value="@k">@n</option> }</select></div>
            <div><label>Tags (optional)</label><input @bind="d.Tags" placeholder="e.g. bike, vintage" /></div>
        </div>
        @if (d.Category == "housing" && d.Type != "housing") { <label>Housing</label><select @bind="d.Deal"><option value="sale">For sale</option><option value="rent">For rent (price per month)</option></select> }
        <label>Cover picture (optional)</label>
        <div class="row-actions">@if (d.Image != null) { <img class="avatar big" style="border-radius:8px" src="@d.Image" alt="" /> }<InputFile OnChange="PickImage" accept="image/*" /></div>
        <label>More pictures and videos (from My media, up to 10)</label>
        <AttachBox @ref="attach" />
        <label>Where (optional: helps people nearby find it)</label>
        <PlacePicker Value="d.Place" ValueChanged="p => d.Place = p" />
        @{ var certs = S.MyCerts(); }
        @if (certs.Count > 0)
        {
            <label>Include ad views (they go to the buyer)</label>
            @foreach (var g in certs.GroupBy(c => c.Adv))
            {
                var ids = g.Select(c => c.Id).ToList();
                <label class="check"><input type="checkbox" @onchange="e => ToggleCerts(ids, (bool)e.Value!)" /> @g.Count() view@(g.Count() == 1 ? "" : "s") of @S.AdvName(g.Key)’s ads (worth @Trade.Coins(g.Sum(c => c.Amt)) coins if cashed in)</label>
            }
        }
        <div class="row-actions"><button class="primary" disabled="@busy" @onclick="List">List it</button><span class="sub">Listing costs @Trade.Coins(S.Trade.Price("list")) coins.</span></div>
    </div>
}
else if (T == "adviews-mine")
{
    var certs = S.MyCerts();
    <div class="panel"><h3>Your ad views</h3>
        <p class="sub">Each verified ad you watch gives you a certificate holding your share of what the advertiser paid. Cash them in, give them to a creator, or bundle them into a listing.</p>
        @if (certs.Count == 0) { <div class="sub">None yet. Watch ads before videos to earn them.</div> }
        @foreach (var g in certs.GroupBy(c => c.Adv))
        {
            var list = g.ToList();
            <div class="row-item"><span class="grow"><b>@list.Count × @S.AdvName(g.Key)</b> <span class="sub">· worth @Trade.Coins(list.Sum(c => c.Amt)) coins</span></span>
                <button @onclick="() => Run(() => S.CashIn(list), CashedText)">Cash in</button>
                <input placeholder="Give to (user or channel ID)" @bind="giveTo" style="width:200px" /><button @onclick="() => Give(list)">Give</button>
                <a class="button" href="market/new">Sell</a></div>
        }
    </div>
}
else if (T == "map")
{
    <p class="sub">🛍 listings · 🏠 housing · 🏛 organizations · 🏪 channels and businesses. Click a pin to open it.</p>
    var pts = Places();
    <MapView Points="pts" Height="520" />
    <div class="sub">@pts.Count place(s) known to this device.</div>
}
else if (T == "ads")
{
    var mineCh = S.Directory().Where(c => c.Kind == "channel" && S.IsMine(c.Owner)).ToList();
    <p class="sub">Ads published on the channels this device knows. Running an advertiser’s ads on your channel sponsors them: their ads play before your videos, and each verified view pays the viewer (as a certificate) and you.</p>
    var rows = S.AdBoard();
    if (rows.Count == 0) { <p class="sub">No ads known yet. Advertisers create them on their channel’s Advertise tab.</p> }
    foreach (var (c, b) in rows)
    {
        var p = b["payload"]!; var t = p["terms"];
        <div class="row-item">
            <span class="grow"><b>@((string?)p["title"])</b> <span class="sub">· <ChainLink Id="@c" /> · @(Market.Categories.FirstOrDefault(x => x.Key == (string?)p["category"]).Name ?? "uncategorized") · @Trade.Coins(Js.Num(t?["perView"]) ?? 0) coins per full view · up to @t?["maxViews"] views · @t?["duration"] s</span></span>
            @if (mineCh.Count > 0 && !S.IsMine(S.Chain(c)?.Owner))
            {
                <select @bind="sponsorOn">@foreach (var m in mineCh) { <option value="@m.Id">@m.Name</option> }</select>
                <button @onclick="() => Run(() => S.Sponsor(sponsorOn.Length > 0 ? sponsorOn : mineCh[0].Id, c), RunsText)">Run on my channel</button>
            }
        </div>
    }
}
else
{
    var all = S.Trade.Listings(); var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    var live = all.Where(l => l.Open && (l.Kind == "fixed" || (Js.Num(l.L["ends"]) ?? 0) > now)).ToList();
    List<Trade.Listing> shown = T switch
    {
        "auctions" => live.Where(l => l.Kind == "auction").ToList(),
        "housing" => live.Where(l => ((string?)l.L["category"] == "housing" || l.Type == "housing") && (deal == "all" || (string?)l.L["deal"] == deal)).ToList(),
        "adviews" => live.Where(l => (l.L["certs"] as JsonArray)?.Count > 0).ToList(),
        "mine" => all.Where(l => S.IsMine(l.Seller)).ToList(),
        _ => live.Where(l => l.Kind == "fixed" && (kindFilter == "all" || Market.KindOf(l.L).Key == kindFilter)).ToList(),
    };
    shown = Near(shown);
    shown = shown.Where(l => q.Length == 0 || l.Title.Contains(q, StringComparison.OrdinalIgnoreCase) || ((string?)l.L["about"] ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    <div class="row-actions">
        <input type="search" placeholder="Search" @bind="q" @bind:event="oninput" class="grow-input" />
        @if (T == "items") { <select @bind="kindFilter"><option value="all">All kinds</option>@foreach (var k in Market.Kinds) { <option value="@k.Key">@k.Icon @k.Name</option> }</select> }
        @if (T == "housing") { <select @bind="deal"><option value="all">All</option><option value="sale">For sale</option><option value="rent">For rent</option></select> }
        @if (T == "adviews") { <a class="button" href="market/adviews-mine">Your ad views</a> }
        @if (T is "items" or "housing" or "auctions")
        {
            <span class="sub">@(here != null ? "📍 Near you:" : "Near you:")</span>
            <select value="@nearKm" @onchange="e => SetNear(int.Parse((string)e.Value!))"><option value="0">anywhere</option><option value="5">within 5 km</option><option value="25">within 25 km</option><option value="100">within 100 km</option><option value="500">within 500 km</option></select>
            @if (here != null) { <button @onclick="UpdateHere">Update my location</button> }
        }
    </div>
    @if (T == "mine")
    {
        var pending = S.Engine.Read(e => e.Store.TxPool.Values.Where(t => t["list"] != null && S.IsMine((string?)t["from"])).Select(t => (string?)t["list"]?["title"]).ToList());
        foreach (var p in pending) { <div class="row-item"><span class="grow"><b>@p</b></span><span class="badge warnb">waiting for a block</span></div> }
    }
    if (shown.Count == 0) { <p class="sub">@(T switch { "mine" => "You haven’t listed anything.", "auctions" => "No auctions running.", "housing" => "No housing listed yet.", "adviews" => "No ad-view bundles for sale.", _ => "Nothing listed yet. Be the first: ＋ Sell something." })</p> }
    @if (T == "housing")
    {
        var hp = shown.Where(l => l.L["place"] is JsonObject).Select(l => Pt((JsonObject)l.L["place"]!, l.Title, $"{Trade.Coins(l.PriceNow)} coins{((string?)l.L["deal"] == "rent" ? " / month" : "")}", "market/item/" + l.Id, "housing")).ToList();
        <MapView Points="hp" Height="300" />
    }
    <div class="grid">
        @foreach (var l in shown) { <ListingCard L="l" /> }
    </div>
    @if (T == "mine")
    {
        var bought = all.Where(l => S.IsMine((string?)l.L["high"]?["by"]) || S.IsMine((string?)l.L["buyer"])).ToList();
        <h3>Your bids and purchases</h3>
        @if (bought.Count == 0) { <p class="sub">None yet.</p> }
        <div class="grid">@foreach (var l in bought) { <ListingCard L="l" /> }</div>
    }
}
@if (msg != null) { <div class="sub" id="market-status">@msg</div> }
@code {
    [Parameter] public string? Tab { get; set; }
    const string HousingKey = "housing", JobKey = "job", WantedKey = "wanted", FixedKey = "fixed", NumberKey = "number", DateKey = "date", DateTimeKey = "datetime", TrueText = "true", FalseText = "false", CashedText = "Cashed in: the coins arrive with the next main-chain block.", RunsText = "Their ads now run on your channel.";
    static readonly (string, string)[] tabs = [("items", "Listings"), ("housing", "🏠 Housing"), ("map", "🗺 Map"), ("auctions", "Auctions"), ("adviews", "Ad views"), ("ads", "Ad board"), ("mine", "Mine"), ("new", "＋ Sell something")];
    string T => Tab is "map" or "housing" or "auctions" or "adviews" or "adviews-mine" or "ads" or "mine" or "new" ? Tab : Tab == "browse" ? "items" : "items";
    AttachBox? attach; Market.Draft d = new(); string q = "", kindFilter = "all", deal = "all", placeLabel = "", giveTo = "", sponsorOn = ""; string? msg; bool busy;
    async Task Run(Func<Task> f, string? done = null) { msg = null; StateHasChanged(); try { await f(); msg = done; } catch (Exception e) { msg = e.Message; } }
    void ToggleCerts(List<string> ids, bool on) { d.Certs.RemoveAll(ids.Contains); if (on) d.Certs.AddRange(ids); }
    Task Give(List<Market.Cert> list) { var to = S.Recipient(giveTo); if (to == null) { msg = "Not a user or channel ID"; return Task.CompletedTask; } return Run(() => S.GiveCerts(list, to), "Given."); }
    async Task PickImage(InputFileChangeEventArgs e)
    {
        try
        {
            foreach (var size in new[] { 320, 200 })
            {
                var img = await e.File.RequestImageFileAsync("image/jpeg", size, size);
                using var ms = new MemoryStream(); await img.OpenReadStream(4 << 20).CopyToAsync(ms);
                d.Image = "data:image/jpeg;base64," + Convert.ToBase64String(ms.ToArray());
                if (d.Image.Length <= 24000) break;
            }
            if (d.Image!.Length > 24000) { d.Image = null; msg = "That picture is too big even when shrunk."; }
        }
        catch (Exception ex) { msg = "That picture didn’t work: " + ex.Message; }
    }
    int nearKm; (double Lat, double Lon)? here;
    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        if (!S.Ready) return;
        nearKm = int.TryParse(await S.Social.Pref("nearKm"), out var k) ? k : 0;
        if (await S.Social.Setting("here") is JsonObject h && Js.Num(h["lat"]) is double la && Js.Num(h["lon"]) is double lo) here = (la, lo);
    }
    static double Km((double Lat, double Lon) a, JsonNode p)
    {
        double r = Math.PI / 180, la = (Js.Num(p["lat"]) ?? 0), lo = (Js.Num(p["lon"]) ?? 0), dLa = (la - a.Lat) * r, dLo = (lo - a.Lon) * r;
        var x = Math.Pow(Math.Sin(dLa / 2), 2) + Math.Cos(a.Lat * r) * Math.Cos(la * r) * Math.Pow(Math.Sin(dLo / 2), 2);
        return 2 * 6371 * Math.Asin(Math.Sqrt(x));
    }
    List<Trade.Listing> Near(List<Trade.Listing> list) => here is not { } me || nearKm == 0 ? list
        : list.Where(l => l.L["place"] is JsonObject p && Km(me, p) <= nearKm).OrderBy(l => Km(me, l.L["place"]!)).ToList();
    async Task SetNear(int km) { nearKm = km; await S.Social.SetPref("nearKm", km.ToString()); if (km > 0 && here == null) await UpdateHere(); }
    async Task UpdateHere()
    {
        try { var p = await JS.InvokeAsync<double[]>("otUi.locate"); here = (Math.Round(p[0], 5), Math.Round(p[1], 5)); await S.Social.SetSetting("here", new JsonObject { ["lat"] = here.Value.Lat, ["lon"] = here.Value.Lon }); }
        catch (Exception e) { msg = "Couldn’t get your location: " + e.Message; }
    }
    static JsonObject Pt(JsonObject place, string title, string sub, string href, string kind) => new() { ["lat"] = place["lat"]?.DeepClone(), ["lon"] = place["lon"]?.DeepClone(), ["title"] = title, ["sub"] = sub, ["href"] = href, ["kind"] = kind };
    /// <summary>Everything with a place: open listings, organizations, channels (businesses).</summary>
    List<JsonObject> Places()
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(); var pts = new List<JsonObject>();
        foreach (var l in S.Trade.Listings().Where(l => l.Open && l.L["place"] is JsonObject && (l.Kind == "fixed" || (Js.Num(l.L["ends"]) ?? 0) > now)))
            pts.Add(Pt((JsonObject)l.L["place"]!, l.Title, Trade.Coins(l.PriceNow) + " coins", "market/item/" + l.Id, (string?)l.L["category"] == "housing" ? "housing" : "listing"));
        foreach (var c in S.Directory().Where(c => c.Kind is "org" or "channel"))
            if (S.Chain(c.Id)?.Profile["place"] is JsonObject pl) pts.Add(Pt(pl, c.Name, (string?)pl["label"] ?? (c.Kind == "org" ? "Organization" : "Channel"), "c/" + c.Id, c.Kind == "org" ? "org" : "channel"));
        return pts;
    }
    async Task Locate()
    {
        try
        {
            var p = await JS.InvokeAsync<double[]>("otUi.locate");
            d.Place = new JsonObject { ["lat"] = Math.Round(p[0], 5), ["lon"] = Math.Round(p[1], 5), ["label"] = placeLabel.Trim() };
        }
        catch (Exception e) { msg = "Couldn’t get your location: " + e.Message; }
    }
    async Task List()
    {
        busy = true; msg = "Listing (a little proof of work)…"; StateHasChanged();
        try { if (attach?.Count > 0) d.Media = await attach.GetRefs(false); await S.ListDraft(d); msg = "Listed: it shows once the next main-chain block includes it."; d = new(); placeLabel = ""; Nav.NavigateTo("market/mine"); }
        catch (Exception e) { msg = e.Message; }
        busy = false;
    }
}
