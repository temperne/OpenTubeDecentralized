@page "/notifications"
@page "/notifications/{Tab}"
@inherits Live
@inject IJSRuntime JS
@inject UiPlatform Platform
<div class="head-row"><h2>@(Tab == "settings" ? "Notification settings" : "Notifications")</h2>
    @if (Tab != "settings" && S.Ready) { <div class="row-actions"><button @onclick="() => S.Notes.MarkAllRead()" disabled="@(S.Notes.Unread == 0)">Mark all read</button><button @onclick="() => S.Notes.ClearAll()" disabled="@(S.Notes.All.Count == 0)">Clear all</button></div> }</div>
<div class="tabs"><a href="notifications" class="@(Tab != "settings" ? "active" : "")">Notifications</a><a href="notifications/settings" class="@(Tab == "settings" ? "active" : "")">Settings</a></div>
@if (!S.Ready) { <p class="sub">Starting…</p> }
else if (Tab == "settings")
{
    <div class="panel">
        <h3>Kinds</h3>
        <p class="sub">What you’re told about, in general. Below, each thing you follow can override this.</p>
        @foreach (var (key, label, _) in Notifications.Types) { <label class="check"><input type="checkbox" checked="@S.Notes.TypeOn(key)" @onchange="e => S.Notes.SetType(key, e.Value is true)" /> @label</label> }
        @if (Platform.Label.Contains("WebAssembly")) { <label class="check"><input type="checkbox" checked="@S.Notes.Desktop" @onchange="e => SetDesktop(e.Value is true)" /> Also show them as desktop notifications while this page is open</label> }
        else { <p class="sub">On the phone, each kind is also its own Android notification category (sound, silent, off) in the system settings.</p> }
    </div>
    <div class="panel">
        <h3>Per channel, group, list and organization</h3>
        @{ var objs = S.Notes.Objects.Where(id => S.Genesis(id) != null).ToList(); }
        @if (objs.Count == 0) { <div class="sub">You don’t follow anything yet.</div> }
        @foreach (var id in objs)
        {
            <details class="item">
                <summary class="row-actions"><span class="grow"><ChainLink Id="@id" /></span>
                    <select value="@S.Notes.ObjectMode(id)" @onchange="e => S.Notes.SetObject(id, (string)e.Value!)"><option value="default">🔔 Default</option><option value="all">🔔 All</option><option value="none">🔕 None</option></select></summary>
                <div class="sub">Override single kinds for this one:</div>
                @foreach (var (key, label, _) in Notifications.Types)
                {
                    var cur = S.Notes.TypeObj(id, key);
                    <div class="row-actions"><span style="min-width:260px">@label</span>
                        <select value="@(cur == null ? "" : cur.Value ? "on" : "off")" @onchange="e => S.Notes.SetTypeObj(id, key, (string)e.Value! switch { OnText => true, OffText => false, _ => null })"><option value="">as above</option><option value="on">on</option><option value="off">off</option></select></div>
                }
            </details>
        }
    </div>
}
else
{
    var all = S.Notes.All;
    @if (all.Count == 0) { <p class="sub">Nothing new. You’ll be told about the things you follow (Settings to choose what).</p> }
    <div class="list">
        @foreach (var n in all)
        {
            <a class="row-item note @(n.Read ? "" : "unread")" href="@AppNav.LinkFor(n.Href, S.Site)">
                <span class="badge">@Notifications.LabelOf(n.Type)</span>
                <span class="grow">@n.Text</span>
                <span class="sub">@Ago(n.Ts)</span>
            </a>
        }
    </div>
}
@code {
    [Parameter] public string? Tab { get; set; }
    const string OnText = "on", OffText = "off";
    async Task SetDesktop(bool on)
    {
        if (on) { var ok = await JS.InvokeAsync<bool>("otUi.askNotify"); if (!ok) on = false; }
        await S.Notes.SetDesktop(on);
    }
}
