@page "/wallet"
@page "/wallet/{Key}"
@inherits Live
@if (!S.Ready) { <p class="sub">Starting…</p> }
else
{
    var accounts = S.MyAccounts(); var viewing = Key != null && !accounts.Contains(Key) ? Key : null;
    if (viewing != null)
    {
        <h2>Account</h2>
        <div class="panel"><h3><a class="person" href="u/@viewing">@S.NameOf(viewing)</a></h3><div class="mono">@viewing</div>
            <div class="bal">@ChainActions.Coins(S.Balance(viewing)) <span class="sub">coins</span></div></div>
        <div class="panel"><h3>Activity</h3><History Key="@viewing" /></div>
    }
    else
    {
        <h2>Wallet</h2>
        <p class="sub">OpenTube runs on one shared coin. Watching pays the creator and whoever sent you the video, a like pays whoever you liked (a dislike is burned), and posting a video pays the people who host that channel. Watching ads earns you coins.</p>
        @foreach (var k in accounts)
        {
            <div class="panel">
                <div class="head-row"><h3>@(k == S.Me.pub ? "You" : S.NameOf(k))</h3><a class="sub" href="wallet/@k">public view</a></div>
                <div class="mono sub">@k</div>
                <div class="bal">@ChainActions.Coins(S.Balance(k)) <span class="sub">coins</span></div>
                @if (!S.Engine.Read(e => e.Store.Ledger.Starters.Contains(k)) && k == S.Me.pub) { <button class="primary" disabled="@starting" @onclick="Starter">Get @ChainActions.Coins(Coin.Starter) starter coins</button> }
            </div>
        }
        <div class="panel">
            <h3>Send coins</h3>
            <label>From</label>
            <select @bind="from">@foreach (var k in accounts) { <option value="@k">@(k == S.Me.pub ? "You" : S.NameOf(k)) (@ChainActions.Coins(S.Balance(k)))</option> }</select>
            <label>To</label>
            <textarea @bind="to" rows="3" placeholder="One per line: a user ID, a channel ID, or a name (@@channel, ~list, @@@@person). Several lines pay each one the amount."></textarea>
            <div class="row-actions"><input type="number" min="0.01" step="0.01" @bind="amount" placeholder="Coins (each)" style="width:140px" /><input class="grow-input" @bind="memo" maxlength="140" placeholder="Memo (optional, public)" /></div>
            <button class="primary" disabled="@busy" @onclick="Send">Send</button>
            @if (msg != null) { <div class="sub" id="wallet-msg">@msg</div> }
        </div>
        <div class="panel">
            <h3>Prices right now</h3>
            <p class="sub">The network sets these itself: after every main-chain block each price moves up to 12.5% toward keeping use at a target.</p>
            @{ var pr = S.Engine.Read(e => new Dictionary<string, double>(e.Store.Ledger.Prices)); }
            <div class="kv">
                <div>Like or dislike</div><div>@ChainActions.Coins(Math.Max(1, Math.Ceiling(pr["like"]))) coins</div>
                <div>Each piece of a video</div><div>@ChainActions.Coins(pr["piece"]) coins</div>
                <div>Post a video</div><div>@ChainActions.Coins(Math.Max(1, Math.Ceiling(pr["post"]))) coins per GB</div>
                <div>Market listing</div><div>@ChainActions.Coins(Math.Max(1, Math.Ceiling(pr.GetValueOrDefault("list")))) coins</div>
            </div>
        </div>
        <div class="panel">
            <div class="head-row"><h3>History</h3>
                <select @bind="histKey">@foreach (var k in accounts) { <option value="@k">@(k == S.Me.pub ? "You" : S.NameOf(k))</option> }</select></div>
            <History Key="@(histKey.Length > 0 ? histKey : S.Me.pub)" />
        </div>
    }
}
@code {
    [Parameter] public string? Key { get; set; }
    string from = "", to = "", memo = "", histKey = ""; double amount; string? msg; bool busy, starting;
    protected override void OnParametersSet() { if (from.Length == 0 && S.Ready) from = S.Me.pub; }
    async Task Starter()
    {
        starting = true; msg = "Earning starter coins (proof of work: a little while)…"; StateHasChanged();
        try { await S.Engine.SubmitTx(new JsonObject { ["starter"] = true }, S.Me); msg = "Starter coins on the way: they count once the next main-chain block includes them."; }
        catch (Exception e) { msg = e.Message; starting = false; }
    }
    async Task Send()
    {
        var lines = to.Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0).ToList();
        var recips = lines.Select(S.Recipient).ToList();
        if (lines.Count == 0 || recips.Any(r => r == null)) { msg = "Every recipient must be a user ID, a known channel ID or a registered name"; return; }
        busy = true; msg = "Signing (a little proof of work)…"; StateHasChanged();
        try { await S.Send(from.Length > 0 ? from : S.Me.pub, recips!, Math.Round(amount * 100), memo); msg = $"Sent: it confirms in the next main-chain block."; to = memo = ""; amount = 0; }
        catch (Exception e) { msg = e.Message; }
        busy = false;
    }
}
