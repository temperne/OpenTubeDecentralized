@page "/network"
@inherits Live
@implements IAsyncDisposable
@inject IVideoPlayer Player
@inject IJSRuntime JS
@inject UiPlatform Platform
@* Network & diagnostics: every check in plain language with what to try, the connection, the main chain, every chain,
   video peer-to-peer (trackers, reachability, transfers), storage, hosting and the recent events. Refreshes itself. *@
@if (!S.Ready) { <h2>Network &amp; diagnostics</h2><p class="sub">Starting…</p> }
else
{
    var checks = Checks(); var w = Worst(checks);
    var mainC = S.Engine.Read(e => e.Store.Main);
    var ms = S.Engine.Read(e => e.SyncState(e.Store.Main)); var mst = S.Engine.Stat(mainC.Id);
    var main = S.Engine.Read(e => (Height: Js.Num(e.Store.MainBest["height"]) ?? 0, Tip: (string?)e.Store.MainBest["hash"] ?? "", Blocks: e.Store.Main.Blocks.Count, Orphans: e.Store.Main.Orphans.Count, Pending: e.Store.Mempool.Count, Txs: e.Store.TxPool.Count, Directory: e.Store.Directory.Count, Mining: e.Mining, Hashes: e.MinedHashes, Rejected: e.Store.Rejected.ToList()));
    <div class="head-row"><h2>Network &amp; diagnostics</h2>
        <div class="row-actions"><span class="pill @w" id="net-verdict">@(w == "ok" ? "✅ Everything working" : w == "warn" ? "⚠️ Partly working" : "❌ Something is broken")</span><button @onclick="Retest">Re-test</button></div></div>
    var live = S.LiveEverywhere();
    <div class="panel"><b>Live streams@(live.Count > 0 ? $" ({live.Count})" : "")</b>
        @if (live.Count == 0) { <div class="sub">None of the channels this device has loaded says it’s live.</div> }
        @foreach (var (c, n, lb) in live)
        {
            var owner = S.Chain(c)?.Owner; var hub = (string?)lb["payload"]?["hub"]; var ts = Js.Num(lb["ts"]) ?? 0;
            <div class="row-actions"><a href="live/@c/@lb["payload"]!["stream"]">@n: @((string?)lb["payload"]?["title"])</a>
                <span class="sub">@Ago(ts) · @((string?)lb["author"] != owner ? "from a computer" : "from a browser") · hub @(hub is { Length: > 8 } ? hub[..8] : "the site")</span>
                <span>@(Now - ts < 90000 ? "listed: just started" : "listed")</span></div>
        }
    </div>
    <div class="panel" id="net-checks">
        @foreach (var c in checks)
        {
            <div class="check"><div><span class="pill @c.Level">@(c.Level == "ok" ? "✅ OK" : c.Level == "warn" ? "⚠️ Degraded" : "❌ Problem")</span></div>
                <div><b>@c.Name</b> — @c.Text @if (c.Fix is { Length: > 0 }) { <div class="fix">→ @c.Fix</div> }</div></div>
        }
    </div>
    <div class="split">
        <div class="panel"><h3>Connection</h3>
            <div class="kv">
                <div>Mode</div><div>@Platform.Label · @(S.Peers > 0 ? $"online: {S.Peers} node{(S.Peers == 1 ? "" : "s")}" : "offline")</div>
                <div>Ways in</div><div class="mono">@if (!S.LinkedUrls.Any()) { <span>none right now</span> } @foreach (var u in S.LinkedUrls) { <div>@Short(u)@(u == S.SiteSocket ? " (the site, fallback)" : "")</div> }</div>
                <div>Last message in</div><div>@AgoOr(S.Engine.LastMsgIn)</div>
                <div>Messages</div><div>@S.Engine.MsgsIn.ToString("N0") in · @S.Engine.MsgsOut.ToString("N0") out</div>
                <div>@(nodeFrom != null ? "Status from " + nodeFrom : "Status")</div>
                <div>@if (nodeErr != null) { <span class="pill error">status unavailable: @nodeErr</span> }
                     else if (node != null) { <span>height #@Js.Num(node["height"]) · @(Js.Num(node["peers"]) ?? 0) nodes linked · @Js.Num(node["chains"]) chains · @Js.Num(node["registered"]) registered · tracker: @(Js.Num(node["tracker"]?["peers"])?.ToString() ?? "?") peers in @(Js.Num(node["tracker"]?["swarms"])?.ToString() ?? "?") swarms · @nodeMs ms</span> }
                     else { <span>—</span> }</div>
                <div>The site</div><div class="mono">@S.Site</div>
                <div>Network ID</div><div class="mono">@Network.MainId[..32]…</div>
            </div>
        </div>
        <div class="panel"><h3>Main chain</h3>
            <div class="kv">
                <div>Sync</div><div><span class="pill @ms.Level">@ms.State</span> @ms.Text</div>
                <div>Height / tip</div><div>#@main.Height · <span class="mono">@(main.Tip.Length > 16 ? main.Tip[..16] : main.Tip)…</span></div>
                <div>Blocks stored</div><div>@main.Blocks (@main.Orphans waiting for parents)</div>
                <div>Registered</div><div>@main.Directory channels, lists and more</div>
                <div>Last new block</div><div>@AgoOr(mst.LastBlock)</div>
                <div>Mining</div><div>@(main.Mining ? $"yes, {main.Hashes:N0} hashes" : "idle")</div>
                <div>Pending</div><div>@main.Pending registrations · @main.Txs transactions</div>
                <div>Rejected blocks</div><div>@(main.Rejected.Count == 0 ? "none" : string.Join(", ", main.Rejected.Select(kv => $"{kv.Value}× {kv.Key}")))</div>
            </div>
        </div>
    </div>
    var chains = S.Engine.Read(e => e.Store.Chains.Values.Where(c => c != e.Store.Main).Select(c => (C: c, Kind: (string?)c.Genesis["payload"]?["kind"] ?? "", Name: (string?)c.Genesis["payload"]?["name"] ?? (string?)c.Genesis["payload"]?["month"] ?? c.Id[..8], Blocks: c.Blocks.Count, Orphans: c.Orphans.Count, Owner: c.Owner, Sync: e.SyncState(c))).ToList());
    <div class="panel"><h3>Chains (@chains.Count)</h3>
        @if (chains.Count == 0) { <div class="sub">You haven’t opened any channels or lists yet.</div> }
        else
        {
            <div class="tablewrap"><table class="diag">
                <tr><th>Chain</th><th>Your role</th><th>Blocks</th><th>Missing</th><th>Last block</th><th>Last heard from peers</th><th>Status</th></tr>
                @foreach (var c in chains.OrderByDescending(c => S.IsMine(c.Owner) || S.Notes.Subscription(c.C.Id) != null).ThenByDescending(c => c.Blocks).Take(200))
                {
                    var st = S.Engine.Stat(c.C.Id);
                    <tr><td><a href="c/@c.C.Id">@(S.Chain(c.C.Id)?.Profile["name"]?.ToString() ?? c.Name)</a><div class="sub">@c.Kind</div></td><td>@Role(c.C.Id, c.Owner)</td><td>@c.Blocks</td><td>@c.Orphans</td>
                        <td>@AgoOr(st.LastBlock)</td><td>@AgoOr(st.LastAnnounce)</td>
                        <td><span class="pill @c.Sync.Level">@c.Sync.State</span><div class="sub">@c.Sync.Text</div>@if (st.Rejected > 0) { <div class="sub">@st.Rejected rejected (last: @st.LastReject)</div> }</td></tr>
                }
            </table></div>
        }
    </div>
    var transfers = Player.Transfers(); var down = transfers.Sum(t => Speed(t.InfoHash).Down); var up = transfers.Sum(t => Speed(t.InfoHash).Up);
    var hosting = transfers.Where(t => t.Complete).ToList();
    <div class="panel"><h3>Video peer-to-peer</h3>
        <div class="kv">
            <div>WebRTC</div><div>@if (stun?.Error is "no WebRTC in this browser") { <span class="pill error">not supported</span> } else { <span class="pill ok">supported</span> }</div>
            <div>Public address</div><div>@if (stun == null) { <span>testing…</span> } else if (stun.Error != null) { <span class="pill warn">@stun.Error</span> } else { <span class="pill @(stun.Types.Contains("srflx") ? "ok" : "warn")">@(stun.Types.Contains("srflx") ? "discovered" : "not discovered")</span> <span> candidate types: @(stun.Types.Count > 0 ? string.Join(", ", stun.Types) : "none")</span> }</div>
            <div>Totals</div><div>@transfers.Count transfers · ↓@Bytes(down)/s ↑@Bytes(up)/s · sharing @hosting.Count complete videos (@Bytes(hosting.Sum(t => (double)t.Size)))</div>
        </div>
        <h4>Trackers</h4>
        <div class="tablewrap"><table class="diag"><tr><th>Tracker</th><th>Role</th><th>Status</th></tr>
            @foreach (var u in Player.TrackerList()) { <tr><td class="mono">@u</td><td>@(u.StartsWith(S.Site.Replace("https://", "wss://").Replace("http://", "ws://")) ? "the site (fallback)" : u.EndsWith("/tracker") ? "meet place (OpenTuber computer)" : "public tracker")</td><td>@if (trackers.TryGetValue(u, out var r)) { <span class="pill @(r.Ok ? "ok" : "warn")">@r.Text</span> } else { <span>testing…</span> }</td></tr> }
        </table></div>
        <h4>Transfers</h4>
        @if (transfers.Count == 0) { <div class="sub">No video transfers right now.</div> }
        else
        {
            <div class="tablewrap"><table class="diag"><tr><th>Video</th><th>Role</th><th>Have</th><th>Peers</th><th>Speed</th><th>Status</th></tr>
                @foreach (var t in transfers)
                {
                    var v = VideoFor(t.InfoHash); var sp = Speed(t.InfoHash); var age = Now - firstSeen.GetValueOrDefault(t.InfoHash, Now);
                    var (lvl, txt) = t.Complete ? ("ok", t.Peers > 0 ? $"sharing with {t.Peers} peer(s)" : "complete; no one fetching right now") : t.Peers > 0 ? ("ok", $"downloading from {t.Peers} peer(s)") : age > 20000 ? ("error", "no online peer has this video") : ("warn", "looking for peers…");
                    <tr><td>@if (v != null) { <a href="v/@v.Value.Chain/@v.Value.Hash">@v.Value.Title</a><div class="sub">@v.Value.Channel</div> } else { @(t.Name.Length > 0 ? t.Name : t.InfoHash[..12])<div class="sub mono">@t.InfoHash[..16]</div> }</td>
                        <td>@(t.Complete ? "sharing" : "watching")</td><td>@((t.Progress * 100).ToString("0"))%</td><td>@t.Peers</td><td>↓@Bytes(sp.Down)/s ↑@Bytes(sp.Up)/s</td><td><span class="pill @lvl">@txt</span></td></tr>
                }
            </table></div>
        }
    </div>
    <div class="split">
        <div class="panel"><h3>Storage</h3>
            <div class="kv">
                <div>Used</div><div>@(storage == null ? "…" : $"{Bytes(storage.Usage)} of {Bytes(storage.Quota)}")</div>
                <div>Persistent</div><div>@if (storage?.Persisted == true) { <span class="pill ok">yes</span> } else { <span class="pill warn">no</span> }</div>
            </div>
            @if (storage != null && !storage.Persisted) { <button @onclick="Persist">Keep my data</button> }
            @if (persistMsg != null) { <div class="sub">@persistMsg</div> }
        </div>
        <div class="panel"><h3>Hosting for you elsewhere</h3>
            @{ var m = S.Engine.Read(e => e.Memberships.TryGetValue(S.Me.pub, out var x) ? (JsonObject)x.DeepClone() : null); }
            <div class="kv">
                <div>Joined channels</div><div>@S.Notes.Joined.Count</div>
                <div>List published</div><div>@(m != null ? Ago(Js.Num(m["at"]) ?? 0) : "not yet")</div>
                <div>Your computers</div><div>@S.MyNodes().Count (<a href="devices">Devices</a>)</div>
            </div>
        </div>
    </div>
    var events = S.Engine.Events();
    <div class="panel"><h3>Recent events</h3>
        <div class="log">@if (events.Count == 0) { <div class="sub">Nothing yet.</div> } @foreach (var e in events.Take(100)) { <div class="mono">@DateTimeOffset.FromUnixTimeMilliseconds((long)e.Ts).ToLocalTime().ToString("HH:mm:ss")  @e.Kind.PadRight(6) @e.Text</div> }</div>
    </div>
}
@code {
    sealed record Check(string Level, string Name, string Text, string? Fix = null);
    sealed record TrackerResult(bool Ok, string Text);
    sealed class Stun { public string? Error { get; set; } public List<string> Types { get; set; } = []; }
    sealed class StorageInfo { public double Usage { get; set; } public double Quota { get; set; } public bool Persisted { get; set; } }
    readonly Dictionary<string, TrackerResult> trackers = []; readonly Dictionary<string, double> firstSeen = [];
    readonly Dictionary<string, (double At, long D, long U, double Down, double Up)> speeds = [];
    StorageInfo? storage; Stun? stun; string? persistMsg; JsonObject? node; string? nodeErr, nodeFrom; long nodeMs; bool? keysOk;
    readonly CancellationTokenSource stop = new();
    static double Now => DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    static string Short(string u) => u.Replace("wss://", "").Replace("ws://", "").Replace("/ot", "");
    string AgoOr(double t) => t > 0 ? Ago(t) : "never";
    (double Down, double Up) Speed(string ih) => speeds.TryGetValue(ih, out var s) ? (s.Down, s.Up) : (0, 0);
    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized(); Retest();
        _ = Task.Run(async () => { while (!stop.IsCancellationRequested) { await Task.Delay(2000, stop.Token).ContinueWith(_ => { }); if (stop.IsCancellationRequested) break; Sample(); await InvokeAsync(StateHasChanged); } });
        await Task.CompletedTask;
    }
    void Sample()
    {
        var now = Now;
        foreach (var t in Player.Transfers())
        {
            firstSeen.TryAdd(t.InfoHash, now);
            if (speeds.TryGetValue(t.InfoHash, out var s) && now > s.At) speeds[t.InfoHash] = (now, t.Downloaded, t.Uploaded, Math.Max(0, (t.Downloaded - s.D) * 1000 / (now - s.At)), Math.Max(0, (t.Uploaded - s.U) * 1000 / (now - s.At)));
            else speeds[t.InfoHash] = (now, t.Downloaded, t.Uploaded, 0, 0);
        }
    }
    (string Chain, string Hash, string Title, string Channel)? VideoFor(string ih) => S.Engine.Read(e =>
    {
        foreach (var c in e.Store.Chains.Values) { if (c == e.Store.Main) continue; var d = Derived.Of(c); var v = d.Videos.FirstOrDefault(x => (string?)x["payload"]?["infohash"] == ih); if (v != null) return ((string, string, string, string)?)(c.Id, (string)v["hash"]!, (string?)v["payload"]?["title"] ?? "", (string?)d.Profile["name"] ?? ""); }
        return null;
    });
    string Role(string id, string? owner) => S.IsMine(owner) ? "owner" : S.Notes.Subscription(id) switch { "join" => "joined (hosting)", "sub" => "subscribed", _ => "viewed" };
    static string Worst(List<Check> cs) => cs.Any(c => c.Level == "error") ? "error" : cs.Any(c => c.Level == "warn") ? "warn" : "ok";
    List<Check> Checks()
    {
        var o = new List<Check>();
        // connection
        o.Add(S.Peers == 0 ? new("error", "Connection", "Not linked to any node: nothing new arrives.", "Nobody may be reachable, or this network blocks it. Running OpenTuber on a computer (Devices) gives the network an always-on peer; reload to retry.")
            : new(S.Peers >= 2 ? "ok" : "warn", "Connection", $"Connected to {S.Peers} node(s). Every connection is an equal peer; none is required.", S.Peers < 2 ? "With only one connection, losing it pauses syncing until another is found." : null));
        // main chain
        var (lvl, state, text, height, dir) = S.Engine.Read(e => { var s = e.SyncState(e.Store.Main); return (s.Level, s.State, s.Text, Js.Num(e.Store.MainBest["height"]) ?? 0, e.Store.Directory.Count); });
        var nodeH = Js.Num(node?["height"]);
        if (nodeH > height) o.Add(new("warn", "Main chain", $"Behind the network: you have block #{height}, {nodeFrom ?? "a node"} has #{nodeH}.", "It should catch up within seconds. If not, reload."));
        else o.Add(new(lvl, "Main chain", $"Block #{height}, {dir} registered. {text}", lvl == "ok" ? null : "Stay connected; missing blocks are requested automatically."));
        // mining
        var (myPending, myTxs, mining, hashes) = S.Engine.Read(e => (e.Store.Mempool.Values.Count(g => S.IsMine((string?)g["author"])), e.Store.TxPool.Values.Count(t => S.IsMine((string?)t["from"])), e.Mining, e.MinedHashes));
        if ((myPending > 0 || myTxs > 0) && !mining) o.Add(new("warn", "Mining", $"{myPending} registration(s) and {myTxs} transaction(s) of yours are waiting, but nothing is mining them.", "Keep this page open; it mines your own items. If it stays stuck, reload."));
        else if (mining) o.Add(new("ok", "Mining", $"Mining a main-chain block ({hashes:N0} hashes so far) to confirm pending items."));
        // your chains
        var followed = S.Engine.Read(e => e.Store.Chains.Values.Where(c => c != e.Store.Main && (S.Notes.Subscription(c.Id) != null || S.IsMine(c.Owner))).Select(c => e.SyncState(c)).ToList());
        var stuck = followed.Count(x => x.Level == "error"); var lag = followed.Count(x => x.Level == "warn" && x.State != "unconfirmed");
        o.Add(stuck > 0 ? new("error", "Your chains", $"{stuck} of {followed.Count} chains are not syncing.", "See the chain table below for which ones.")
            : lag > 0 ? new("warn", "Your chains", $"{lag} of {followed.Count} chains are catching up.", "Usually resolves within seconds.")
            : new("ok", "Your chains", followed.Count > 0 ? $"All {followed.Count} chains you follow are in sync." : "You don’t follow any chains yet."));
        // video
        if (stun?.Error == "no WebRTC in this browser") o.Add(new("error", "Video (P2P)", "This browser has no WebRTC, so it cannot exchange video with peers.", "Use a current Chrome, Edge, Firefox or Safari."));
        else
        {
            var up = trackers.Values.Count(x => x.Ok);
            if (trackers.Count == 0) o.Add(new("warn", "Video (P2P)", "Testing trackers…"));
            else if (up == 0) o.Add(new("error", "Video (P2P)", "No video tracker is reachable, so viewers can’t find whoever has a video.", "Check your network/firewall, or run OpenTuber on a computer with a public address (it becomes a meet place with its own tracker)."));
            else o.Add(new("ok", "Video (P2P)", $"{up} of {trackers.Count} trackers reachable."));
            if (stun != null)
            {
                if (stun.Error != null) o.Add(new("warn", "Reachability", "Could not test WebRTC reachability: " + stun.Error));
                else if (stun.Types.Contains("srflx")) o.Add(new("ok", "Reachability", "Your public address was discovered, so peers on other networks can usually connect to you."));
                else o.Add(new("warn", "Reachability", "Your device could not discover its public address (no STUN reply).", "Peers on the same network will work; across networks, connections may fail. A TURN relay would fix it."));
            }
            var starving = Player.Transfers().Count(t => !t.Complete && t.Peers == 0 && Now - firstSeen.GetValueOrDefault(t.InfoHash, Now) > 20000);
            if (starving > 0) o.Add(new("error", "Video transfers", $"{starving} video(s) have no peer: nobody online has them.", "The uploader and everyone who joined that channel are offline. A computer that joins the channel keeps its videos online."));
        }
        // rankings
        if ((string?)node?["ranker"] is { } ranker)
        {
            var r = S.Engine.Read(e => e.Rankings.TryGetValue(ranker, out var x) ? (JsonObject)x.DeepClone() : null);
            if (r == null) o.Add(new("warn", "Rankings", "This site’s node has a ranking list but hasn’t published a ranking yet. Explore ranks channels on this device meanwhile.", "It should appear within 5 minutes of the node waking up."));
            else { var at = Js.Num(r["at"]) ?? 0; var n = (r["items"] as JsonArray)?.Count ?? 0; o.Add(Now - at > 20 * 60000 ? new("warn", "Rankings", $"The node’s ranking is {Ago(at)} old.", "The node republishes every 5 minutes; it may be stuck.") : new("ok", "Rankings", $"The node’s ranking ({n} videos) was published {Ago(at)}.")); }
        }
        // storage
        if (storage is { Quota: > 0 } st)
        {
            var pct = st.Usage / st.Quota;
            o.Add(pct > 0.9 ? new("error", "Storage", $"Device storage for this site is {Math.Round(pct * 100)}% full.", "Leave a joined channel, or clear videos you no longer watch.")
                : !st.Persisted ? new("ok", "Storage", $"{Bytes(st.Usage)} used. Not marked persistent; that only matters once you keep videos here.")
                : new("ok", "Storage", $"{Bytes(st.Usage)} used of {Bytes(st.Quota)} available; marked persistent."));
        }
        // your computers
        var nodes = S.MyNodes(); var online = nodes.Count(x => Now - x.At < 10 * 60000);
        o.Add(nodes.Count == 0 ? new("warn", "Your computers", "None yet, so your videos are online only while this device is.", "Devices → Add a computer: one command on any computer keeps them online.")
            : online > 0 ? new("ok", "Your computers", $"{online} of {nodes.Count} online.") : new("warn", "Your computers", "None online right now.", "Check that OpenTuber is running on them (Devices)."));
        // keys
        if (keysOk == false) o.Add(new("warn", "Keys", "Keys controlling your channels are not backed up.", "You → Keys & security → Back up all keys."));
        return o;
    }
    void Retest()
    {
        trackers.Clear(); stun = null; StateHasChanged();
        foreach (var u in Player.TrackerList())
            _ = Task.Run(async () =>
            {
                var t0 = DateTime.UtcNow;
                try
                {
                    using var ws = new System.Net.WebSockets.ClientWebSocket(); using var cts = new CancellationTokenSource(8000);
                    await ws.ConnectAsync(new Uri(u), cts.Token); trackers[u] = new(true, $"reachable · {(DateTime.UtcNow - t0).TotalMilliseconds:0} ms");
                    try { await ws.CloseAsync(System.Net.WebSockets.WebSocketCloseStatus.NormalClosure, "", CancellationToken.None); } catch { }
                }
                catch (Exception e) { trackers[u] = new(false, e is OperationCanceledException ? "timed out" : "unreachable"); }
                await InvokeAsync(StateHasChanged);
            });
        _ = Probe();
    }
    async Task Probe()
    {
        try { stun = await JS.InvokeAsync<Stun>("otUi.stun"); } catch { stun = new Stun { Error = "not available in this app" }; }
        try { storage = await JS.InvokeAsync<StorageInfo?>("otUi.storageInfo"); } catch { storage = null; }
        try { keysOk = await S.Keys.NotBackedUp() == 0 || !S.Directory().Any(c => S.IsMine(c.Owner)); } catch { }
        await InvokeAsync(StateHasChanged);
        // the status of a node this device is linked to (else the site's node)
        var urls = S.LinkedUrls.Select(u => u.Replace("wss://", "https://").Replace("ws://", "http://").Replace("/ot", "/status")).Append(S.Site + "/status").Distinct().ToList();
        nodeErr = null;
        foreach (var u in urls)
        {
            try
            {
                var t0 = DateTime.UtcNow; using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(6) };
                node = System.Text.Json.Nodes.JsonNode.Parse(await http.GetStringAsync(u)) as JsonObject; nodeMs = (long)(DateTime.UtcNow - t0).TotalMilliseconds;
                nodeFrom = u.Replace("https://", "").Replace("http://", "").Replace("/status", ""); nodeErr = null; break;
            }
            catch (Exception e) { nodeErr = e.Message; }
        }
        await InvokeAsync(StateHasChanged);
    }
    async Task Persist()
    {
        bool ok = false; try { ok = await JS.InvokeAsync<bool>("otUi.persist"); storage = await JS.InvokeAsync<StorageInfo?>("otUi.storageInfo"); } catch { }
        persistMsg = ok ? "The browser will keep your data." : "The browser declined. Bookmarking the site or installing it usually helps.";
    }
    public ValueTask DisposeAsync() { stop.Cancel(); base.Dispose(); return ValueTask.CompletedTask; }
}
