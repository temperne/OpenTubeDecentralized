@page "/upload"
@page "/upload/{Chain}"
@inherits Live
@inject IVideoPlayer Player
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
<h2>Upload a video</h2>
@if (!S.Ready) { <p class="sub">Starting…</p> }
else
{
    var chans = S.Publish.MyChannels();
    if (chans.Count == 0) { <div class="panel"><h2>Create your channel first</h2><p>To add a video, you need a channel. It takes a few seconds.</p><a class="button primary-link" href="you/channels">Create a channel</a></div> }
    else
    {
        var nodes = S.Publish.StorageNodes();
        <div class="panel">
            <label>Channel</label>
            <select @bind="chain">@foreach (var c in chans) { <option value="@c.Id">@c.Name</option> }</select>
            <label>Video</label>
            <InputFile OnChange="Pick" accept="video/*" @ref="input" />
            @if (file != null) { <div class="sub">@file.Name · @Bytes(file.Size) · posting costs @((S.Publish.PostCost(file.Size) / 100).ToString("0.##")) coins (you have @((S.Balance(S.Me.pub) / 100).ToString("0.##")))</div> }
            @if (thumb is { Length: > 0 }) { <img src="@thumb" class="thumb-preview" alt="" /> }
            <label>Title</label>
            <input @bind="title" maxlength="140" />
            <label>Description</label>
            <textarea @bind="desc" rows="3" maxlength="5000"></textarea>
            <label>Tags</label><input @bind="tags" placeholder="Tags, e.g. cooking, pasta, italian (up to 8)" />
            <label>Comments on this video</label>
            <select @bind="vpol"><option value="">Channel default</option><option value="anyone">Anyone</option><option value="approved">Approved users only</option><option value="off">Off</option></select>
            @if (nodes.Count > 0)
            {
                <label>Kept on</label>
                <select value="@(node ?? nodes[0].Node)" @onchange="e => node = (string?)e.Value ?? string.Empty">@foreach (var (k, n) in nodes) { <option value="@k">@n</option> }<option value="">This device only (keep the app open while people watch)</option></select>
            }
            else { <p class="sub">None of your computers is online to keep it, so this device shares it while the app is open. Run the OpenTuber command on a computer (Devices on the site) to keep your videos available.</p> }
            <div class="row-actions"><button class="primary" disabled="@(busy || file == null || string.IsNullOrWhiteSpace(title))" @onclick="Go">Publish to channel</button></div>
            @if (step >= 0)
            {
                <div class="upload-steps" id="upload-steps">
                    @for (int i = 0; i < Steps.Length; i++)
                    {
                        var st = i < step || (i == step && finished) ? "done" : i == step ? (failed ? "bad" : "now") : "todo";
                        if (i == 4 && keepName == null) continue;
                        <div class="ustep @st"><span class="ustep-dot">@(st == "done" ? "✓" : st == "bad" ? "✗" : st == "now" ? "●" : "○")</span>
                            <div class="grow"><b>@(i == 4 ? $"Sending it to {keepName}" : Steps[i])</b>
                                @if (i == step && !finished)
                                {
                                    @if (i == 0 && file != null) { <Bar F="@readFrac" /><div class="sub">@Bytes(readBytes) of @Bytes(file.Size) · @Rate(readBytes, t0)</div> }
                                    else if (i == 1) { <div class="sub">Working out the video’s fingerprint (its torrent: every piece is hashed, @Bytes(file?.Size ?? 0)). Big files take a while; the page may pause.</div> }
                                    else if (i == 4 && sp != null)
                                    {
                                        <Bar F="@sp.Fraction" />
                                        <div class="sub">@Math.Round(sp.Fraction * 100)% · @Bytes(sp.Received) of @Bytes(sp.Size > 0 ? sp.Size : file?.Size ?? 0)@SendRate()</div>
                                        <div class="sub">@(sp.Peers > 0 ? $"Connected to your computer ({sp.Peers} connection{(sp.Peers == 1 ? "" : "s")})" : "Not connected to your computer yet")@(mine != null ? $" · this device has sent {Bytes(mine.Uploaded)}" : "")</div>
                                        @if (sp.Note != null) { <div class="sub">@sp.Note</div> }
                                        <div class="sub">Keep this page open until it reaches 100%: your computer downloads the video from this device. After that it stays online without this device.</div>
                                    }
                                    else if (i == 4) { <div class="sub">Asking your computer to keep it…</div> }
                                }
                            </div></div>
                    }
                </div>
            }
            @if (msg != null) { <div class="sub" id="upload-status">@msg</div> }
        </div>
    }
}
@code {
    [Parameter] public string? Chain { get; set; }
    string chain = "", title = "", desc = "", thumb = "", tags = "", vpol = ""; string? msg; bool busy;
    string? node;   // null: the first of your computers (as they come online); "": this device only
    IBrowserFile? file; InputFile? input;
    protected override void OnParametersSet()
    {
        if (chain.Length == 0) chain = Chain ?? S.Publish.MyChannels().FirstOrDefault()?.Id ?? "";
    }
    async Task Pick(InputFileChangeEventArgs e)
    {
        file = e.File; if (title.Length == 0) title = System.Text.RegularExpressions.Regex.Replace(Path.GetFileNameWithoutExtension(file.Name), "[_-]+", " ");
        try { thumb = await JS.InvokeAsync<string>("otUi.thumb", input!.Element); } catch { thumb = ""; }
    }
    static readonly string[] Steps = ["Reading the file", "Making its torrent", "Adding it to your channel", "Paying the posting fee", "Sending it to your computer", "Done"];
    int step = -1; bool finished, failed; double readFrac; long readBytes; DateTime t0, sendT0; long sendB0; string? keepName; OpenTube.Client.Publish.StoreProgress? sp; Transfer? mine; string ih = "";
    string Rate(long bytes, DateTime since) { var secs = (DateTime.UtcNow - since).TotalSeconds; return secs < 0.5 ? "" : $"{Bytes(bytes / secs)}/s"; }
    string SendRate()
    {
        if (sp == null || sp.Received <= sendB0) return "";
        var secs = (DateTime.UtcNow - sendT0).TotalSeconds; if (secs < 2) return ""; var bps = (sp.Received - sendB0) / secs; if (bps <= 0) return "";
        var left = Math.Max(0, (sp.Size - sp.Received) / bps);
        return $" · {Bytes(bps)}/s · about {(left < 60 ? $"{Math.Ceiling(left)} s" : left < 3600 ? $"{Math.Ceiling(left / 60)} min" : $"{left / 3600:0.0} h")} left";
    }
    void Step(int i) { step = i; InvokeAsync(StateHasChanged); }
    async Task Go()
    {
        busy = true; failed = finished = false; msg = null; void Say(string m) { if (m.StartsWith("Adding")) step = 2; else if (m.StartsWith("Paying")) step = 3; InvokeAsync(StateHasChanged); }
        string? keepOn = node; void PickKeep() { keepOn = node ?? S.Publish.StorageNodes().FirstOrDefault().Node; keepName = string.IsNullOrEmpty(keepOn) ? null : S.Publish.StorageNodes().FirstOrDefault(n => n.Node == keepOn).Name ?? "your computer"; }
        PickKeep();
        try
        {
            Step(0); t0 = DateTime.UtcNow; readBytes = 0; readFrac = 0;
            var dir = Path.Combine(Path.GetTempPath(), "opentube-upload", Guid.NewGuid().ToString("n")[..8]); Directory.CreateDirectory(dir);
            var path = Path.Combine(dir, string.Concat(file!.Name.Select(c => char.IsLetterOrDigit(c) || c is '.' or '-' or '_' or ' ' ? c : '_')));
            await using (var src = file.OpenReadStream(8L << 30)) await using (var dst = File.Create(path))
            {
                var buf = new byte[1 << 20]; int n; var shown = DateTime.UtcNow;
                while ((n = await src.ReadAsync(buf)) > 0)
                {
                    await dst.WriteAsync(buf.AsMemory(0, n)); readBytes += n; readFrac = (double)readBytes / Math.Max(1, file.Size);
                    if ((DateTime.UtcNow - shown).TotalMilliseconds > 250) { shown = DateTime.UtcNow; StateHasChanged(); await Task.Yield(); }
                }
            }
            Step(1); await Task.Delay(50);
            var meta = await Player.Share(path, Path.GetFileName(path)); ih = meta.InfoHash;
            Step(2);
            var b = await S.Publish.Video(chain, meta, Path.GetFileName(path), file.Size, file.ContentType is { Length: > 0 } ct ? ct : "video/mp4", title, desc, thumb, Say, tags, vpol);
            PickKeep();   // (your computers may have come online meanwhile)
            if (!string.IsNullOrEmpty(keepOn))
            {
                Step(4); sendT0 = DateTime.UtcNow; sendB0 = 0; sp = null;
                await S.Publish.Store(keepOn, chain, meta.InfoHash, _ => { }, p =>
                {
                    if (sp == null || (p.Received > 0 && sendB0 == 0 && sp.Received == 0)) { sendT0 = DateTime.UtcNow; sendB0 = p.Received; }
                    sp = p; mine = Player.Transfers().FirstOrDefault(t => t.InfoHash == ih); InvokeAsync(StateHasChanged);
                });
            }
            Step(5); finished = true; msg = string.IsNullOrEmpty(keepOn) ? "Published. This device shares it while the app is open." : $"Published, and {keepName} has all of it: it stays online without this device. Opening the video…";
            StateHasChanged(); await Task.Delay(1200);
            Nav.NavigateTo($"v/{chain}/{b["hash"]}");
        }
        catch (Exception e) { failed = true; msg = "Couldn’t publish: " + e.Message; busy = false; StateHasChanged(); }
    }
}
