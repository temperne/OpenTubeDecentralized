@page "/tag/{Tag}"
@inherits Live
<div class="head-row"><h2>#@Tag</h2>@if (S.Ready) { <button @onclick="Toggle">@(muted ? "Show this tag again" : "Not interested")</button> }</div>
<p class="sub">@(muted ? "You said you’re not interested in this tag, so its videos and ads are hidden elsewhere." : "Videos with this tag on the channels this device knows. Subscribe to more channels to see more.")</p>
@if (S.Ready)
{
    var found = S.Tagged(Tag);
    if (found.Count == 0) { <p class="sub">No videos with this tag yet.</p> }
    <div class="grid">@foreach (var (c, n, v) in found) { <VideoCard Chain="@c" Block="v" ChannelName="@n" /> }</div>
    var posts = S.TaggedPosts(Tag);
    if (posts.Count > 0)
    {
        <div class="panel"><h3>Posts</h3>
            @foreach (var (c, kind, b) in posts)
            {
                var d = S.Chain(c); var a = S.AuthorOf((string)b["author"]!, kind == "group" ? d : null, (string?)b["payload"]?["name"] ?? "");
                <div class="post">
                    <div><a class="person" href="@a.Href"><b>@a.Name</b></a><span class="sub"> · @Ago(Js.Num(b["ts"]) ?? 0) · @(kind == "group" ? "in " : "")</span>@if (kind == "group") { <ChainLink Id="@c" /> }</div>
                    <Rich Text="@((string?)b["payload"]?["text"])" />
                    @if (kind == "square") { <a class="sub" href="posts/@((string?)S.Genesis(c)?["payload"]?["month"])/@b["hash"]">Open</a> }
                </div>
            }
        </div>
    }
}
@code {
    [Parameter] public string Tag { get; set; } = "";
    bool muted;
    protected override async Task OnParametersSetAsync() { if (S.Ready) muted = (await S.Social.Muted()).Tags.Contains(Tag); }
    async Task Toggle() { muted = !muted; await S.Social.SetMuted("tags", Tag, muted); }
}
