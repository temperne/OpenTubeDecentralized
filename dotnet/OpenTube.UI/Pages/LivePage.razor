@page "/live/{Chain}/{Stream}"
@inherits Live
@inject IVideoPlayer Player
@* A live stream, watched in C# (LiveWatch) and played by the page's own video element; its chat and who's watching *@
@{ var d = S.Chain(Chain); var lb = Find(d); }
@if (lb == null) { <p class="sub">Loading this stream from the network…</p> }
else
{
    var hash = (string)lb["hash"]!; var stream = (string?)lb["payload"]?["stream"] ?? ""; var mine = S.IsMine(d!.Owner);
    var ended = d.LiveEnds.ContainsKey(stream) || w?.Ended == true; var stats = d.LiveStats.GetValueOrDefault(stream) as JsonObject;
    var v = w?.Viewers; var host = HostNode(d, lb); var guestOf = GuestNode(d, lb);
    <div class="watch">
        <div class="watch-main">
            @if (!ended || src != null) { <div class="player">@if (src != null) { <video controls autoplay muted playsinline src="@src" style="width:100%"></video> }</div> }
            <h2 class="watch-title">@if (!ended) { <span class="badge live">LIVE</span> } @((string?)lb["payload"]?["title"])</h2>
            <div class="row-actions">
                <a href="c/@Chain" class="chan-link"><b>@((string?)d.Profile["name"])</b></a>
                <span class="sub">started @Ago(Js.Num(lb["ts"]) ?? 0)</span>
                @if (v != null && !ended) { <span class="badge" id="viewer-count">👁 @Num(v["viewers"]) watching · peak @Num(v["peak"] ?? v["viewers"]) · @Num(v["seenCount"]) have watched</span> }
            </div>
            @if (guestOf != null && !ended) { <div class="panel warn row-actions" id="join-banner"><span class="grow">🎥 <b>You’re invited to join this stream on camera.</b></span><a class="button primary-link" href="golive?group=@guestOf">Join on camera</a></div> }
            <div class="sub" id="live-status">@(ended ? "This stream has ended." : w?.Status ?? "Joining…")@(w != null && w.Bytes > 0 ? $" · {Bytes(w.Bytes)} received" : "")</div>
            @if (ended) { <p id="live-ended">This stream has ended. @if (d.Recordings.GetValueOrDefault(stream) is { } rec) { <a href="v/@Chain/@((string?)rec["hash"])">Watch the recording</a> } else { <span class="sub">If the streamer publishes the recording, it appears with the channel’s <a href="c/@Chain">videos</a>.</span> }</p> }
            @if (stats != null)
            {
                var secs = Js.Num(stats["secs"]) ?? 0; var unique = Js.Num(stats["unique"]) ?? 0;
                <div class="panel">
                    <h3>📊 Stream statistics</h3>
                    <div class="row-actions stats">
                        <div><b>@Num(stats["peak"])</b><div class="sub">peak viewers</div></div>
                        <div><b>@unique</b><div class="sub">unique viewers</div></div>
                        <div><b>@Dur(secs)</b><div class="sub">watched in total</div></div>
                        <div><b>@(unique > 0 ? Dur(Math.Round(secs / unique)) : "–")</b><div class="sub">per viewer</div></div>
                    </div>
                    @if (stats["top"] is JsonArray top && top.Count > 0)
                    {
                        <div class="sub">Who watched (longest first)</div>
                        <div class="row-actions">@foreach (var t in top.Take(20).OfType<JsonArray>()) { var k = (string?)t[0] ?? ""; <a class="person" href="u/@k">@S.NameOf(k) <span class="sub">@Dur(Js.Num(t[1]) ?? 0)</span></a> }</div>
                    }
                    <div class="sub">Public on OpenTube: anyone can see these, not only the streamer.</div>
                </div>
            }
            else if (!ended)
            {
                <div class="panel" id="people-here">
                    <h3>👁 People here (@Num(v?["viewers"]))</h3>
                    @if (v == null) { <div class="sub">Counting…</div> }
                    else
                    {
                        var now = (v["now"] as JsonArray ?? []).Select(x => (string?)x).OfType<string>().ToList(); var anon = Math.Max(0, (Js.Num(v["viewers"]) ?? 0) - now.Count);
                        <div class="sub">peak @Num(v["peak"] ?? v["viewers"]) · @Num(v["seenCount"]) unique · @Dur(Js.Num(v["watchSecs"]) ?? 0) watched · public</div>
                        <div class="row-actions">@foreach (var k in now) { <a class="person" href="u/@k">@S.NameOf(k)</a> @if (host != null && !S.IsMine(k)) { <button class="small-btn @(invited.Contains(k) ? "on" : "")" title="Let them join this stream on camera (6 hours)" disabled="@invited.Contains(k)" @onclick="() => Invite(host, k)">🎥 Invite</button> } }</div>
                        @if (anon > 0) { <div class="sub">+ @anon not signed in</div> }
                        @if (now.Count == 0 && anon == 0) { <div class="sub">Nobody watching right now.</div> }
                        <button class="linkish" @onclick="() => showSeen = !showSeen">@(showSeen ? "▾" : "▸") Has been here (@Num(v["seenCount"]))</button>
                        @if (showSeen)
                        {
                            <div>@foreach (var x in (v["seen"] as JsonArray ?? []).OfType<JsonObject>()) { var k = (string?)x["k"] ?? ""; <div><a class="person" href="u/@k">@S.NameOf(k)</a> <span class="sub">first @Ago(Js.Num(x["first"]) ?? 0), watched @Dur(Js.Num(x["secs"]) ?? 0)</span></div> }</div>
                            <div class="sub">Open to everyone: who watches is public on OpenTube.</div>
                        }
                    }
                </div>
            }
        </div>
        @if (host != null && !ended) { <div class="panel watch-main-extra"><GroupPanel Node="@host" Title="true" /></div> }
        <aside class="watch-side">
            <div class="panel chat">
                <h3>Chat</h3>
                @{ var msgs = d.CommentsFor(hash).Where(c => !d.Hidden.Contains((string)c["hash"]!)).OrderBy(c => Js.Num(c["ts"]) ?? 0).ToList(); }
                <div class="chat-list">
                    @if (msgs.Count == 0) { <div class="sub">No messages yet.</div> }
                    @foreach (var c in msgs.TakeLast(200))
                    {
                        var a = S.AuthorOf((string)c["author"]!, d, (string?)c["payload"]?["name"] ?? "");
                        <div class="chat-msg"><a class="person" href="@a.Href"><b>@a.Name</b></a>@if (host != null && !S.IsMine((string)c["author"]!) && !a.Owner) { var ck = a.Key; <button class="tagx" title="Let them join on camera (6 hours)" disabled="@invited.Contains(ck)" @onclick="() => Invite(host, ck)">🎥</button> }@if (a.Owner) { <span class="badge ok">host</span> } <Rich Tag="span" Text="@((string?)c["payload"]?["text"])" />
                            @if (mine && !S.IsMine((string)c["author"]!)) { <button class="tagx" title="Hide this message" @onclick="() => Hide((string)c[HashKey]!)">✕</button> }</div>
                    }
                </div>
                @{ var can = mine || d.CanComment(S.Me.pub, hash); }
                <div class="row-actions">
                    <input class="grow-input" id="chat-box" @bind="say" @bind:event="oninput" @onkeydown="Key" maxlength="2000" disabled="@(!can || sending)" placeholder="@(can ? "Say something…" : "Chat isn’t open to you here")" />
                    <button disabled="@(!can || sending)" @onclick="() => Send(hash)">Send</button>
                </div>
                @if (msg != null) { <div class="sub">@msg</div> }
            </div>
        </aside>
    </div>
}
@code {
    [Parameter] public string Chain { get; set; } = ""; [Parameter] public string Stream { get; set; } = "";
    const string HashKey = "hash";
    LiveWatch? w; string? src, started, msg; string say = ""; bool showSeen, sending;
    // by its stream id, or by its live block's hash (notifications link that way, as the JavaScript page does)
    JsonObject? Find(Derived? d) => d?.Streams.FirstOrDefault(b => (string?)b["payload"]?["stream"] == Stream || (string?)b["hash"] == Stream);
    readonly HashSet<string> invited = [];
    /// <summary>The computer that combines cameras for this stream, if it's yours to run: the one streaming it, or one of
    /// your computers linked to the channel that receives OBS.</summary>
    string? HostNode(Derived d, JsonObject lb)
    {
        if (!S.IsMine(d.Owner)) return null;
        var mine = S.MyNodes().Where(n => n.Perms.Contains('o') && !n.Perms.Contains('g')).Select(n => n.Node).ToHashSet();
        var author = (string?)lb["author"];
        if (author != d.Owner && author != null) return mine.Contains(author) ? author : null;
        return d.Relays.FirstOrDefault(mine.Contains);
    }
    /// <summary>The stream's group computer, when it's shared with you as a guest (you're invited on camera).</summary>
    string? GuestNode(Derived d, JsonObject lb)
    {
        if (S.IsMine(d.Owner)) return null;
        var mine = S.MyNodes().Where(n => n.Perms.Contains('g')).Select(n => n.Node).ToHashSet(); if (mine.Count == 0) return null;
        var author = (string?)lb["author"];
        if (author != d.Owner && author != null && mine.Contains(author)) return author;
        return d.Relays.FirstOrDefault(mine.Contains);
    }
    async Task Invite(string node, string key)
    {
        invited.Add(key);
        try { await S.NodeCtl(node, "group.invite", new JsonObject { ["key"] = key, ["hours"] = 6, ["name"] = S.NameOf(key) }); msg = $"{S.NameOf(key)} can join on camera now: they get their own stream key for 6 hours."; }
        catch (Exception e) { invited.Remove(key); msg = "Invite failed: " + e.Message; }
    }
    static string Num(JsonNode? n) => ((long)(Js.Num(n) ?? 0)).ToString("N0");
    static string Dur(double secs) => secs < 60 ? $"{secs:0} s" : secs < 3600 ? $"{Math.Round(secs / 60)} min" : $"{secs / 3600:0.0} h";
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (started == Stream) return;
        var d = S.Chain(Chain); var lb = Find(d);
        if (lb == null) return;
        started = Stream;
        if (d!.LiveEnds.ContainsKey((string?)lb["payload"]?["stream"] ?? "")) return;   // over: nothing to join
        w = S.Watch(Chain, (JsonObject)lb.DeepClone()); w.Changed += Redraw;
        src = (await Player.PlayLive(w)).Src; StateHasChanged();
    }
    void Redraw() => InvokeAsync(StateHasChanged);
    async Task Send(string hash)
    {
        if (say.Trim().Length == 0) return;
        sending = true; msg = null;
        try { await S.Comment(Chain, hash, say); say = ""; } catch (Exception e) { msg = e.Message; }
        sending = false;
    }
    Task Key(KeyboardEventArgs e) => e.Key == "Enter" ? Send((string)Find(S.Chain(Chain))!["hash"]!) : Task.CompletedTask;
    async Task Hide(string h) { try { await S.Hide(Chain, h); } catch (Exception e) { msg = e.Message; } }
    public override void Dispose() { base.Dispose(); if (w != null) w.Changed -= Redraw; }
}
