@page "/c/{Id}"
@page "/c/{Id}/{Tab}"
@inherits Live
@inject IJSRuntime JS
@{ var d = S.Chain(Id); var g = S.Genesis(Id); }
@if (d == null)
{
    <h2>@((string?)g?["payload"]?["name"] ?? "Channel")</h2>
    <p class="sub">Loading this channel from the network…</p>
}
else
{
    var mine = S.IsMine(d.Owner); var name = (string?)d.Profile["name"] ?? ""; var handle = S.NameOfChain(Id);
    var who = S.OwnerIdentity(Id); var registered = S.Engine.Read(e => e.Store.Directory.ContainsKey(Id));
    var tabs = Tabs(d, mine); var tab = tabs.Contains(Tab ?? "") ? Tab! : tabs[0];
    <div class="channel-head">
        @if ((string?)d.Profile["avatar"] is { Length: > 0 } av) { <img class="avatar big" src="@av" alt="" /> } else { <span class="avatar big empty">@(name.Length > 0 ? name[..1].ToUpperInvariant() : "?")</span> }
        <div class="grow">
            <h2>@name</h2>
            @if (handle != null) { <div class="row-actions small-actions"><a href="n/@Uri.EscapeDataString(handle)"><b>@handle</b></a><button @onclick="() => Copy(S.Site + '/' + handle)">Copy link</button></div> }
            <div class="sub">
                @(d.Kind == "channel" ? $"{d.Videos.Count} video{(d.Videos.Count == 1 ? "" : "s")}" : KindName(d.Kind))
                @if (d.LiveNow.Count > 0) { <span class="badge live">LIVE</span> }
                @if (!registered) { <span class="badge warnb">registration pending</span> }
            </div>
            <div class="row-actions">
                @if (S.Notes.Subscription(Id) is { } how) { <button class="on" @onclick="() => S.Notes.Subscribe(Id, false)">Subscribed ✓</button> }
                else { <button class="primary" @onclick="() => S.Notes.Subscribe(Id, true)">Subscribe</button> }
                @if (d.Kind == "channel" && !mine)
                {
                    var hosts = S.Publish.StorageNodes();
                    @if (S.Notes.Subscription(Id) == "join") { <button class="on" title="Your computers host this channel’s videos. Click to stop." @onclick="() => Run(() => S.Join(Id, false), null, LeftText)">Joined ✓</button> }
                    else { <button disabled="@(hosts.Count == 0)" title="@(hosts.Count == 0 ? "Joining means hosting its videos: run OpenTube on a computer (Devices) first" : "Your computers download every video this channel posts and share it with viewers")" @onclick="() => Run(() => S.Join(Id, true), null, JoinedText)">Join</button> }
                }
                @if (S.Notes.Subscription(Id) != null)
                {
                    <select value="@S.Notes.ObjectMode(Id)" @onchange="e => S.Notes.SetObject(Id, (string)e.Value!)" title="Notifications from this @d.Kind">
                        <option value="default">🔔 Default</option><option value="all">🔔 All</option><option value="none">🔕 None</option>
                    </select>
                }
                @if (!mine && who.Length > 0 && who != S.Me.pub)
                {
                    <span class="sub">by <a class="person" href="u/@who">@S.NameOf(who)</a></span>
                    @if (friends != null && !friends.Contains(who)) { <button @onclick="() => AddFriend(who)">＋ Friend</button> }
                    <a class="button" href="messages/@who">✉ Message</a>
                    <button title="Send this @d.Kind some of your coins" @onclick="() => tipOpen = !tipOpen">🪙 Tip</button>
                }
            </div>
            @if (tipOpen)
            {
                <div class="panel row-actions">
                    <span>Tip @name</span><input type="number" min="0.01" step="0.01" @bind="tipAmt" style="width:110px" />
                    <span class="sub">coins (you have @ChainActions.Coins(S.Balance(S.Me.pub)))</span>
                    <button class="primary" @onclick="() => Tip(d.Owner!, name)">Send</button>
                </div>
            }
        </div>
    </div>
    @if (mine && keyUnbacked) { <div class="panel warn row-actions"><span class="grow">⚠ This @d.Kind’s private key exists only on this device. If you lose the device, you lose the @d.Kind.</span><a class="button primary-link" href="you/keys">Back up keys</a></div> }
    @if (msg != null) { <div class="sub" id="chan-msg">@msg</div> }
    <div class="tabs">@foreach (var t in tabs) { <a href="c/@Id/@t" class="@(t == tab ? "active" : "")">@TabName(t)</a> }</div>

    @switch (tab)
    {
        case "videos":
            foreach (var lb in d.LiveNow) { <a class="live-banner" href="live/@Id/@lb["payload"]!["stream"]">🔴 Live now: @((string?)lb["payload"]?["title"]) · watch</a> }
            if (mine) { <div class="row-actions"><a class="button primary-link" href="upload/@Id">＋ Add video</a><a class="button" href="golive/@Id">● Go live</a></div> }
            var vids = d.Videos.Where(v => mine || !Muted(v)).OrderByDescending(v => Js.Num(v["ts"])).ToList();
            if (vids.Count == 0) { <p class="sub">No videos yet.</p> }
            <div class="grid">@foreach (var v in vids) { <VideoCard Chain="@Id" Block="(JsonObject)v.DeepClone()" ChannelName="@name" /> }</div>
            break;
        case "posts":
        case "discussion":
            var canPost = mine || d.CanPost(S.Me.pub);
            if (canPost)
            {
                <div class="panel">
                    <AttachBox @ref="attach" />
                    <textarea @bind="postText" @bind:event="oninput" maxlength="5000" placeholder="@(d.Kind == "group" ? $"Write to {name}…" : "Write a post for your channel…")" rows="3"></textarea>
                    <div class="row-actions"><button class="primary" disabled="@posting" @onclick="Post">Post</button>@if (posting) { <span class="sub">@(mine ? "Posting…" : "Doing anti-spam work…")</span> }</div>
                </div>
            }
            else if (d.Kind == "group") { <div class="panel sub">@((string?)d.Profile["join"] == "approved" ? $"Only approved members can post here. Send the owner your user ID to be approved: {S.Me.pub}" : "You can’t post in this group.")</div> }
            var posts = d.Posts.OrderByDescending(p => Js.Num(p["ts"]) ?? 0).ToList();
            if (posts.Count == 0) { <p class="sub">@(d.Kind == "group" ? "No posts yet. Say hello!" : "No posts.")</p> }
            foreach (var p in posts)
            {
                var ph = (string)p["hash"]!; var pa = (string)p["author"]!; var a = S.AuthorOf(pa, d, (string?)p["payload"]?["name"] ?? "");
                var pv = S.Votes(d, ph); var replies = d.CommentsFor(ph).Where(c => !d.Hidden.Contains((string)c["hash"]!)).OrderBy(c => Js.Num(c["ts"]) ?? 0).ToList();
                <div class="panel post">
                    <div><a class="person" href="@a.Href"><b>@a.Name</b></a>@if (a.Owner) { <span class="badge ok">owner</span> }<span class="sub"> · @Ago(Js.Num(p["ts"]) ?? 0)</span></div>
                    <Rich Text="@((string?)p["payload"]?["text"])" Author="@pa" />
                    @if ((string?)p["payload"]?["image"] is { Length: > 0 } img) { <img class="post-img" src="@img" alt="" /> }
                    <MediaView Refs="@(p["payload"]?["media"] as JsonArray)" />
                    <div class="row-actions small-actions">
                        @if (d.Kind == "group") { <button disabled="@(S.IsMine(pa) || pv.Mine > 0)" title="Like (pays the author)" @onclick="() => Like(ph, pa)">👍 @pv.Up</button> }
                        @if (mine || S.IsMine(pa)) { <button @onclick="() => Run(() => S.Hide(Id, ph))">Hide</button> }
                    </div>
                    @foreach (var c in replies)
                    {
                        var ca = S.AuthorOf((string)c["author"]!, d, (string?)c["payload"]?["name"] ?? "");
                        <div class="reply"><a class="person" href="@ca.Href"><b>@ca.Name</b></a><span class="sub"> · @Ago(Js.Num(c["ts"]) ?? 0)</span><Rich Text="@((string?)c["payload"]?["text"])" /></div>
                    }
                    @if (d.Kind == "group" && (mine || d.CanComment(S.Me.pub, ph)))
                    {
                        <div class="row-actions"><input class="grow-input" placeholder="Reply…" maxlength="2000" value="@(replyText.GetValueOrDefault(ph))" @oninput="e => replyText[ph] = (string?)e.Value ?? string.Empty" /><button @onclick="() => Reply(ph)">Reply</button></div>
                    }
                </div>
            }
            break;
        case "members":
            var posters = d.Posts.Concat(d.Visible.Where(b => (string?)b["payload"]?["type"] == "comment")).Select(b => (string)b["author"]!).Where(k => k != d.Owner).Distinct().ToList();
            <div class="panel">
                <p class="sub">@((string?)d.Profile["join"] == "open" ? "Anyone can post in this group." : "Only approved members can post. The owner approves people under Manage.")</p>
                <h4>Owner</h4><div>@name</div>
                <h4>Approved</h4>@if (d.Allowed.Count == 0) { <div class="sub">—</div> } @foreach (var k in d.Allowed) { <div><a class="person" href="u/@k">@S.NameOf(k)</a></div> }
                <h4>Have posted</h4>@if (posters.Count == 0) { <div class="sub">—</div> } @foreach (var k in posters) { <div><a class="person" href="u/@k">@S.NameOf(k)</a></div> }
            </div>
            break;
        case "feed":
            if (mine)
            {
                <div class="panel row-actions">
                    <input class="grow-input" @bind="addLink" placeholder="Add a video: paste its link (…/v/…)" />
                    <input @bind="addNote" maxlength="200" placeholder="Note (optional)" style="width:200px" />
                    <button class="primary" @onclick="AddVideoByLink">Add video</button>
                </div>
            }
            var feed = S.ListFeed(Id);
            <p class="sub">Subscribe to this list and its feed shows up on your Home. @d.Adds.Count(b => b["payload"]?["video"] == null) channel(s), @d.Adds.Count(b => b["payload"]?["video"] != null) single video(s).</p>
            if (feed.Count == 0) { <p class="sub">Nothing in this list yet.</p> }
            <div class="grid">@foreach (var (c, v) in feed.Take(120)) { <VideoCard Chain="@c" Block="(JsonObject)v.DeepClone()" ChannelName="@((string?)S.Chain(c)?.Profile["name"])" /> }</div>
            break;
        case "channels":
            if (mine)
            {
                var all = S.Directory().Where(c => c.Kind == "channel").OrderBy(c => c.Name).ToList();
                <div class="panel">
                    <label>Add a channel to this list</label>
                    <select @bind="addChannel"><option value="">Choose a registered channel…</option>@foreach (var c in all) { <option value="@c.Id">@c.Name</option> }</select>
                    <input @bind="addNote" maxlength="200" placeholder="Why you recommend it (optional)" />
                    <button class="primary" @onclick="AddChannel">Add</button>
                </div>
            }
            <div class="list">
                @if (d.Adds.Count == 0) { <p class="sub">This list is empty.</p> }
                @foreach (var b in d.Adds)
                {
                    var target = (string?)b["payload"]?["target"] ?? ""; var vid = (string?)b["payload"]?["video"]; var tc = S.Chain(target);
                    <div class="row-item">
                        <span class="grow">
                            @if (vid != null) { <a href="v/@target/@vid">🎬 @((string?)tc?.Videos.FirstOrDefault(x => (string?)x["hash"] == vid)?["payload"]?["title"] ?? "a video")</a> }
                            else { <a href="c/@target">@((string?)tc?.Profile["name"] ?? (string?)S.Genesis(target)?["payload"]?["name"] ?? "Unknown channel")</a> }
                            @if ((string?)b["payload"]?["note"] is { Length: > 0 } note) { <span class="sub"> · @note</span> }
                        </span>
                        @if (mine) { <button @onclick="() => Remove(b)">Remove</button> }
                    </div>
                }
            </div>
            break;
        case "about":
            var links = (d.Profile["links"] as JsonArray ?? []).OfType<JsonObject>().ToList();
            <div class="panel">
                @if ((string?)d.Profile["about"] is { Length: > 0 } about) { <Rich Text="@about" /> } else { <p class="sub">No description.</p> }
                @if ((string?)d.Profile["location"] is { Length: > 0 } loc) { <div class="sub">📍 @loc</div> }
                @if (d.Profile["place"] is JsonObject place) { <div class="sub">🗺 <a href="@($"https://www.openstreetmap.org/?mlat={place["lat"]}&mlon={place["lon"]}#map=16/{place["lat"]}/{place["lon"]}")" target="_blank" rel="noopener">On the map</a> @((string?)place["label"])</div> }
                @if (links.Count > 0) { <div class="row-actions">@foreach (var l in links) { <a class="tagbox" href="@((string?)l["url"])" target="_blank" rel="noopener noreferrer nofollow">🔗 @((string?)l["label"])</a> }</div> }
                @if (d.Kind == "org")
                {
                    <div class="kv">
                        @if ((string?)d.Profile["orgType"] is { } ot) { <div>Type</div><div>@ot</div> }
                        @if ((string?)d.Profile["jurisdiction"] is { } jur) { <div>Jurisdiction</div><div>@jur</div> }
                        @foreach (var (k, v) in d.Profile["details"] as JsonObject ?? []) { <div>@k</div><div>@v?.ToString()</div> }
                    </div>
                    @foreach (var pp in (d.Profile["people"] as JsonArray ?? []).OfType<JsonObject>()) { <div><a class="person" href="u/@((string?)pp["key"])">@S.NameOf((string?)pp["key"] ?? "")</a> · @((string?)pp["role"])@(Js.Num(pp["share"]) is double sh ? $" · {sh}%" : "")</div> }
                }
                @if (who.Length > 0 && who != d.Owner) { <div class="sub">Owned by <a class="person" href="u/@who">@S.NameOf(who)</a> (coins paid to this @d.Kind go to them)</div> }
                <details class="tech"><summary class="sub">Technical details</summary>
                    <div class="kv">
                        <div>Chain ID</div><div class="mono">@Id</div>
                        <div>Channel key</div><div class="mono">@d.Owner</div>
                        <div>Owner identity</div><div class="mono">@(who != d.Owner ? who : "not bound yet")</div>
                        @if (d.Kind == "channel") { <div>Default comments</div><div>@CommentName((string?)d.Profile["comments"])</div> }
                        <div>Blocks</div><div>@d.BlockCount</div>
                        <div>Registered</div><div>@(registered ? "yes" : "pending")</div>
                    </div>
                </details>
            </div>
            break;
        case "manage":
            <ChannelManage Id="@Id" />
            break;
        case "flags": case "reports": case "rules": case "filings": case "cases": case "courts": case "people":
            <OrgTab Id="@Id" Tab="@tab" />
            break;
        case "ranking":
            var rk = S.Rank(Id);
            if (rk.Local) { <p class="sub">This ranking list has not published a ranking yet.</p> }
            else
            {
                <p class="sub">@rk.Items.Count videos · algorithm @rk.Algo · published @Ago(rk.At), signed by this list’s key.</p>
                <div class="grid">
                    @{ int rn = 0; }
                    @foreach (var i in rk.Items.Take(100))
                    {
                        rn++;
                        var rv = S.Chain(i.Chain)?.Videos.FirstOrDefault(x => (string?)x["hash"] == i.Video);
                        <div class="ranked"><span class="rank-n">#@rn</span>
                            @if (rv != null) { <VideoCard Chain="@i.Chain" Block="(JsonObject)rv.DeepClone()" ChannelName="@i.Channel" /> }
                            else { <a class="card" href="v/@i.Chain/@i.Video"><div class="thumb-empty">▶</div><div class="title">@i.Title</div><div class="sub">@i.Channel · 👍 @i.Up</div></a> }
                        </div>
                    }
                </div>
            }
            break;
        case "advertise":
            <ChannelAdvertise Id="@Id" />
            break;
        case "docket":
            <CaseDocket Id="@Id" />
            break;
        default:
            <p class="sub">This part of the @d.Kind isn’t in the C# pages yet. <a href="@($"/?#/c/{Id}/{tab}")">Open it on the JavaScript page</a>.</p>
            break;
    }
}
@code {
    [Parameter] public string Id { get; set; } = ""; [Parameter] public string? Tab { get; set; }
    const string JoinedText = "Joined: your computers host this channel’s videos.", LeftText = "Left: your computers stop hosting it (you stay subscribed).";
    string? msg; bool tipOpen, posting, keyUnbacked; double tipAmt = 1; string postText = "", addLink = "", addNote = "", addChannel = "";
    readonly Dictionary<string, string> replyText = []; HashSet<string>? friends, mutedTags;
    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        friends = (await S.Social.Friends()).Select(f => f.Key).ToHashSet();
        mutedTags = (await S.Social.Muted()).Tags;
        keyUnbacked = S.Keys.Channels().Any(c => c.Chain == Id && !c.Exported);
    }
    static List<string> Tabs(Derived d, bool mine) => d.Kind switch
    {
        "channel" => mine ? ["videos", "posts", "about", "advertise", "manage"] : ["videos", "posts", "about"],
        "group" => [.. new[] { "discussion", "members", "about" }, .. mine ? new[] { "manage" } : []],
        "org" => [.. new[] { "flags", "reports", "rules", "filings", "cases", "courts", "people", "about" }, .. mine ? new[] { "manage" } : []],
        "case" => [.. new[] { "docket", "about" }, .. mine ? new[] { "manage" } : []],
        _ when d.Profile["ranking"] != null => [.. new[] { "ranking", "about" }, .. mine ? new[] { "manage" } : []],
        _ => [.. new[] { "feed", "channels", "about" }, .. mine ? new[] { "manage" } : []],
    };
    static string TabName(string t) => t switch { "feed" => "Feed", "discussion" => "Discussion", _ => char.ToUpperInvariant(t[0]) + t[1..] };
    static string KindName(string k) => k switch { "list" => "list", "group" => "group", "org" => "organization", "case" => "case", _ => k };
    static string CommentName(string? p) => p switch { "approved" => "Approved users only", "off" => "Off", _ => "Anyone" };
    bool Muted(JsonObject v) => mutedTags != null && (v["payload"]?["tags"] as JsonArray ?? []).Any(t => mutedTags.Contains((string?)t ?? ""));
    async Task Run(Func<Task> f, string? doing = null, string? done = null)
    {
        msg = doing; StateHasChanged();
        try { await f(); msg = done; } catch (Exception e) { msg = e.Message; }
    }
    async Task Copy(string text) { try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); msg = "Link copied."; } catch { msg = text; } }
    Task AddFriend(string key) => Run(async () => { await S.Social.AddFriend(key, S.NameOf(key)); friends?.Add(key); }, "Adding…", "Added as a friend.");
    Task Tip(string to, string name) => Run(async () => { await S.Tip(to, Math.Round(tipAmt * 100), "tip for " + name); tipOpen = false; }, "Sending…", $"Tipped {tipAmt:0.##} coins. It confirms in the next main-chain block.");
    Task Like(string target, string author) => Run(() => S.Vote(Id, target, 1, author), "Liking (pays the author)…");
    AttachBox? attach;
    async Task Post() { posting = true; await Run(async () => { await S.Post(Id, postText, null, attach?.Count > 0 ? await attach.GetRefs(false) : null); postText = ""; attach?.Clear(); }); posting = false; }
    Task Reply(string post) => Run(async () => { await S.Comment(Id, post, replyText.GetValueOrDefault(post) ?? ""); replyText.Remove(post); });
    Task Remove(JsonObject b) => Run(() => S.Hide(Id, (string)b["hash"]!));
    Task AddChannel() => addChannel.Length == 0 ? Task.CompletedTask : Run(async () => { await S.AddChannel(Id, addChannel, addNote.Trim()); addChannel = addNote = ""; }, "Adding…", "Added to the list.");
    Task AddVideoByLink()
    {
        var m = System.Text.RegularExpressions.Regex.Match(addLink, "/v/([0-9a-f]{64})/([0-9a-f]{64})");
        if (!m.Success) { msg = "Paste a video link (it contains /v/…)"; return Task.CompletedTask; }
        return Run(async () => { await S.AddVideo(Id, m.Groups[1].Value, m.Groups[2].Value, addNote.Trim()); addLink = addNote = ""; }, "Adding…", "Added to the list.");
    }
}
