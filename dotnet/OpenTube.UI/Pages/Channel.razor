@page "/c/{Id}"
@inherits Live
@{ var d = S.Chain(Id); var g = S.Genesis(Id); }
@if (d == null)
{
    <h2>@((string?)g?["payload"]?["name"] ?? "Channel")</h2>
    <p class="sub">Loading this channel from the network…</p>
}
else
{
    <div class="channel-head">
        @if ((string?)d.Profile["avatar"] is { Length: > 0 } av) { <img class="avatar big" src="@av" alt="" /> }
        <div>
            <h2>@((string?)d.Profile["name"])</h2>
            <div class="sub">@d.Kind · @d.Videos.Count videos @(d.LiveNow.Count > 0 ? " · LIVE now" : "")</div>
            <p>@((string?)d.Profile["about"])</p>
            <div class="row-actions">
                @if (S.Notes.Subscription(Id) is { } how) { <button @onclick="() => S.Notes.Subscribe(Id, false)">@(how == "join" ? "Joined" : "Subscribed") ✓</button> }
                else { <button class="primary" @onclick="() => S.Notes.Subscribe(Id, true)">Subscribe</button> }
                <select value="@S.Notes.ObjectMode(Id)" @onchange="e => S.Notes.SetObject(Id, (string)e.Value!)" title="Notifications from this channel">
                    <option value="default">🔔 Default</option><option value="all">🔔 All</option><option value="none">🔕 None</option>
                </select>
            </div>
        </div>
    </div>
    @foreach (var lb in d.LiveNow) { <a class="live-banner" href="live/@Id/@lb["payload"]!["stream"]">🔴 Live now: @((string?)lb["payload"]?["title"]) · watch</a> }
    <div class="grid">
        @foreach (var v in d.Videos.OrderByDescending(v => Js.Num(v["ts"]))) { <VideoCard Chain="@Id" Block="(JsonObject)v.DeepClone()" ChannelName="@((string?)d.Profile["name"])" /> }
    </div>
}
@code { [Parameter] public string Id { get; set; } = ""; }
