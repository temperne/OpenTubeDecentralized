@page "/posts"
@page "/posts/{Month}"
@page "/posts/{Month}/{Hash}"
@inherits Live
@* The public feed: each month is its own chain everyone keeps *@
@{ var m = Month ?? Social.Month(DateTimeOffset.UtcNow); var thisMonth = m == Social.Month(DateTimeOffset.UtcNow); }
@if (Hash != null)
{
    var p = S.Social.PostOf(m, Hash);
    <p><a href="posts/@m">← Posts @m</a></p>
    @if (p == null) { <p class="sub">Fetching this post from the network…</p> }
    else
    {
        <div class="panel">
            <PostItem P="p" Month="@m" Full="true" OnError="e => msg = e" />
            <div class="replies">
                @foreach (var r in S.Social.Replies(m, Hash)) { <PostItem P="r" Month="@m" Full="true" Reply="true" OnError="e => msg = e" /> }
            </div>
            <div class="compose">
                <input placeholder="Reply…" @bind="reply" @bind:event="oninput" maxlength="1000" class="grow-input" />
                <button class="primary" disabled="@(busy || string.IsNullOrWhiteSpace(reply))" @onclick="() => Send(m, reply, Hash)">Reply</button>
            </div>
        </div>
    }
}
else
{
    <div class="head-row"><h2>Posts</h2><span class="sub">@m · <a href="posts/@Social.PrevMonth(m)">older ›</a></span></div>
    @if (thisMonth)
    {
        <div class="panel">
            <textarea placeholder="What’s happening?" @bind="text" @bind:event="oninput" maxlength="1000" rows="3"></textarea>
            <div class="row-actions">
                <button class="primary" disabled="@(busy || string.IsNullOrWhiteSpace(text))" @onclick="() => Send(m, text, null)">Post</button>
                <span class="sub">Public: anyone can read it, forever.</span>
            </div>
        </div>
    }
    <div class="row-actions">
        <button class="@(popular ? "" : "on")" @onclick="() => popular = false">Recent</button>
        <button class="@(popular ? "on" : "")" @onclick="() => popular = true">Popular</button>
    </div>
    var posts = S.Social.Posts(m, popular);
    @if (posts.Count == 0) { <p class="sub">No posts yet this month (or still loading from the network).</p> }
    <div class="panel list-plain">
        @foreach (var p in posts) { <PostItem P="p" Month="@m" OnError="e => msg = e" /> }
    </div>
}
@if (msg != null) { <div class="sub" id="post-status">@msg</div> }
@code {
    [Parameter] public string? Month { get; set; } [Parameter] public string? Hash { get; set; }
    string text = "", reply = ""; string? msg; bool busy, popular;
    async Task Send(string m, string t, string? to)
    {
        busy = true; msg = "Doing anti-spam work…"; StateHasChanged();
        try { await S.Social.PostTo(m, t, to); if (to == null) text = ""; else reply = ""; msg = null; }
        catch (Exception e) { msg = "Couldn’t post: " + e.Message; }
        busy = false;
    }
}
