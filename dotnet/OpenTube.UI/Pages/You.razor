@page "/you"
@page "/you/{Tab}"
@inherits Live
<h2>You</h2>
<div class="tabs">
    @foreach (var (t, label, href) in tabs) { <a href="@href" class="@(t == tab ? "active" : "")">@label</a> }
</div>
@if (!S.Ready) { <p class="sub">Starting…</p> }
else
{
    @switch (tab)
    {
        case "profile":
            var myPage = S.Social.MyPage;
            if (myPage == null)
            {
                <div class="panel">
                    <h3>Your public profile</h3>
                    <p class="sub">Your name, picture and a few words about you, plus an @@@@name people can find you by. It also carries your encryption key, so friends can send you friends-only posts.</p>
                    <button class="primary" disabled="@busy" @onclick="StartPage">Start my profile</button>
                </div>
            }
            else if (S.Chain(myPage) == null) { <p class="sub">Your profile is being registered (a few seconds to a minute)…</p> }
            else { <details class="panel" open="@(S.Chain(myPage)!.Profile["avatar"] == null)"><summary><b>Edit your profile</b></summary><ChannelManage Id="@myPage" /></details> }
            <p class="sub">Your public profile, as others see it:</p>
            <ProfileView Key="@S.Me.pub" />
            break;
        case "media":
            <MediaTab />
            break;
        case "channels":
            <div class="panel">
                <h3>Create a channel, list or group</h3>
                <label>Type</label>
                <select @bind="kind"><option value="channel">Channel (your videos and live streams)</option><option value="list">List (a curated feed of channels and videos)</option><option value="group">Group (a discussion)</option></select>
                <input placeholder="Name" @bind="name" maxlength="60" />
                <input placeholder="About (optional)" @bind="about" maxlength="500" />
                @if (kind == "group") { <label>Who can post</label><select @bind="join"><option value="open">Anyone</option><option value="approved">Only members you approve</option></select> }
                <p class="sub">This makes a new key pair just for it, and registers it on the main chain (your device does a little proof of work: seconds to a minute).</p>
                <button class="primary" disabled="@busy" @onclick="Create">Create &amp; register</button>
                @if (msg != null) { <div class="sub">@msg</div> }
            </div>
            <div class="panel">
                <h3>Your channels & lists</h3>
                @{ var mine = S.Directory().Where(c => S.IsMine(c.Owner) && c.Kind is not ("circle" or "square")).ToList(); }
                @if (mine.Count == 0) { <div class="sub">None yet.</div> }
                <div class="list">@foreach (var c in mine) { <a class="row-item" href="c/@c.Id">@if (c.Avatar is { Length: > 0 } av) { <img class="avatar" src="@av" alt="" /> }<span class="grow"><b>@c.Name</b></span><span class="badge">@c.Kind</span></a> }</div>
            </div>
            break;
        case "settings":
            <div class="panel">
                <h3>Not interested</h3>
                <p class="sub">Videos and ads with these tags are hidden. Kept on this device only.</p>
                <p class="sub">Videos and ads with these tags, and ads in these categories, are hidden for you. This list stays on this device: it is never published or sent to anyone.</p>
                @if (muted == null || muted.Value.Tags.Count + muted.Value.Cats.Count == 0) { <div class="sub">Nothing. Use ✕ next to a tag on a video to add one.</div> }
                else
                {
                    <div class="row-actions">
                        @foreach (var t in muted.Value.Tags) { <span class="tagbox">#@t<button class="tagx" title="Show again" @onclick="() => UnmuteTag(t)">✕</button></span> }
                        @foreach (var c in muted.Value.Cats) { <span class="tagbox">@(Market.Categories.FirstOrDefault(x => x.Key == c).Name ?? c) ads<button class="tagx" title="Show again" @onclick="() => UnmuteCat(c)">✕</button></span> }
                    </div>
                }
                <div class="row-actions"><input @bind="addTag" placeholder="Add a tag…" style="width:160px" /><button @onclick="AddTags">Add</button>
                    <select value="" @onchange="e => AddCat((string)e.Value!)"><option value="">Add an ad category…</option>@foreach (var (k, n) in Market.Categories.Where(c => muted?.Cats.Contains(c.Key) != true)) { <option value="@k">@n</option> }</select></div>
            </div>
            <div class="panel">
                <h3>Organizations you follow</h3>
                @if (orgsFollowed == null || orgsFollowed.Count == 0) { <div class="sub">None. Follow organizations from their page (Orgs).</div> }
                @foreach (var (id, _) in orgsFollowed ?? []) { <div><ChainLink Id="@id" /> <a class="sub" href="c/@id/flags">what its flags do</a></div> }
            </div>
            <div class="panel">
                <h3>Subscriptions</h3>
                @{ var subs = S.Notes.Subscribed; }
                @if (subs.Count == 0) { <div class="sub">None yet.</div> }
                @foreach (var id in subs) { <div class="row-item"><span class="grow"><ChainLink Id="@id" /></span><button @onclick="() => S.Notes.Subscribe(id, false)">Unsubscribe</button></div> }
            </div>
            <div class="panel">
                <h3>More settings</h3>
                <div class="list">
                    <a class="row-item" href="notifications">🔔 Notifications</a><a class="row-item" href="friends">👥 Friends</a><a class="row-item" href="messages">✉ Messages</a><a class="row-item" href="devices">🖥 Devices</a>
                </div>
            </div>
            @if (Push != null)
            {
                <div class="panel">
                    <h3>Notifications while the app is closed</h3>
                    <p class="sub">Your computers (or ones shared with you) watch for you and wake this phone with a push when there’s something, so the app needn’t stay connected. Pushes come through a UnifiedPush app on this phone, such as ntfy.</p>
                    @{ var ds = Push.Distributors(); }
                    @if (ds.Count == 0) { <p>Install <b>ntfy</b> (from F-Droid or Google Play; no account needed), then come back here.</p> }
                    else { <div class="row-actions">@foreach (var dist in ds) { <button class="primary" @onclick="() => Push.Enable(dist)">Use @(dist.Split('.').Last())</button> }</div> }
                    <div class="sub" id="push-status">@Push.Status</div>
                </div>
            }
            break;
    }
    <div class="panel">
        <div class="head-row"><b>Your user ID</b><a href="wallet">Coins: @ChainActions.Coins(S.Balance(S.Me.pub)) →</a></div>
        <div class="row-actions"><span class="mono grow">@S.Me.pub</span><button @onclick="CopyId">Copy user ID</button></div>
        @if (!S.Engine.Read(e => e.Store.Ledger.Starters.Contains(S.Me.pub)))
        {
            <div class="row-actions"><button class="primary" disabled="@starting" @onclick="Starter">Get 10 starter coins</button> <span class="sub" id="starter-status">@starterMsg</span></div>
        }
    </div>
    <div class="tiles">
        <a class="tile" href="market">🛍 Market</a><a class="tile" href="exchange">⇄ Exchange</a><a class="tile" href="orgs">🏛 Organizations</a><a class="tile" href="devices">🖥 Devices</a><a class="tile" href="notifications">🔔 Notifications</a><a class="tile" href="explore">🔎 Explore</a><a class="tile" href="network">📡 Network</a>
    </div>
}
@code {
    [Parameter] public string? Tab { get; set; }
    static readonly (string, string, string)[] tabs = [("profile", "Profile", "you"), ("media", "Media", "you/media"), ("channels", "Channels", "you/channels"), ("wallet", "Wallet", "wallet"), ("keys", "Keys & security", "you/keys"), ("settings", "Settings", "you/settings")];
    string tab => Tab is "channels" or "settings" or "media" ? Tab : "profile";
    bool starting, busy; string? starterMsg, msg; string name = "", about = "", kind = "channel", join = "open";
    (HashSet<string> Tags, HashSet<string> Cats)? muted;
    protected override async Task OnParametersSetAsync() { if (S.Ready) { muted = await S.Social.Muted(); orgsFollowed = await S.Followed(); } }
    string addTag = ""; JsonObject? orgsFollowed;
    [Inject] IJSRuntime JS { get; set; } = null!;
    async Task CopyId() { try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", S.Me.pub); starterMsg = "User ID copied."; } catch { } }
    async Task AddTags()
    {
        foreach (var t in addTag.ToLowerInvariant().Split([' ', ',', '#'], StringSplitOptions.RemoveEmptyEntries).Select(t => System.Text.RegularExpressions.Regex.Replace(t, "[^a-z0-9-]", "")).Where(t => t.Length is > 0 and <= 24)) await S.Social.SetMuted("tags", t, true);
        addTag = ""; muted = await S.Social.Muted();
    }
    async Task AddCat(string c) { if (c.Length == 0) return; await S.Social.SetMuted("cats", c, true); muted = await S.Social.Muted(); }
    Task UnmuteTag(string t) => Unmute("tags", t);
    Task UnmuteCat(string c) => Unmute("cats", c);
    async Task Unmute(string k, string v) { await S.Social.SetMuted(k, v, false); muted = await S.Social.Muted(); }
    async Task Starter()
    {
        starting = true; starterMsg = "Earning starter coins (proof of work: a little while)…"; StateHasChanged();
        try { await S.Engine.SubmitTx(new JsonObject { ["starter"] = true }, S.Me); starterMsg = "Starter coins on the way: they count once the next main-chain block includes them."; }
        catch (Exception e) { starterMsg = e.Message; starting = false; }
    }
    async Task StartPage()
    {
        busy = true; StateHasChanged();
        try { await S.Social.StartPage(); } catch (Exception e) { msg = e.Message; }
        busy = false;
    }
    [Inject] IServiceProvider Sp { get; set; } = null!;
    IPushSetup? Push => Sp.GetService(typeof(IPushSetup)) as IPushSetup;
    async Task Create()
    {
        if (string.IsNullOrWhiteSpace(name)) { msg = "Give it a name"; return; }
        busy = true; msg = "Registering: proof of work on the main chain (a few seconds to a minute)…"; StateHasChanged();
        try
        {
            var payload = new JsonObject { ["type"] = "genesis", ["kind"] = kind, ["name"] = name.Trim(), ["about"] = about.Trim() };
            if (kind == "channel") { payload["avatar"] = ""; payload["comments"] = "anyone"; }
            if (kind == "group") { payload["avatar"] = ""; payload["join"] = join; }
            var g = await S.CreateChannel(payload);
            msg = "Registered. Opening it…"; Nav.NavigateTo("c/" + (string)g["hash"]!);
        }
        catch (Exception e) { msg = "Couldn’t create it: " + e.Message; }
        busy = false;
    }
}
