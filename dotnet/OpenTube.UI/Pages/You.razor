@page "/you"
@inherits Live
<h2>You</h2>
<div class="tiles">
    <a class="tile" href="market">🛍 Market</a><a class="tile" href="exchange">⇄ Exchange</a><a class="tile" href="orgs">🏛 Organizations</a><a class="tile" href="devices">🖥 Devices</a><a class="tile" href="notifications">🔔 Notifications</a><a class="tile" href="explore">🔎 Explore</a>
</div>
@if (S.Ready)
{
    <div class="panel">
        <div><b>Your user ID</b></div>
        <div class="mono">@S.Me.pub</div>
        <div class="sub">Coins: @((S.Balance(S.Me.pub) / 100).ToString("0.00")) · this key lives in this browser (the same one the JavaScript page used here)</div>
        @if (!S.Engine.Read(e => e.Store.Ledger.Starters.Contains(S.Me.pub)))
        {
            <div class="row-actions"><button class="primary" disabled="@starting" @onclick="Starter">Get 10 starter coins</button> <span class="sub" id="starter-status">@starterMsg</span></div>
        }
    </div>
    <div class="panel">
        <h3>Create a channel</h3>
        <input placeholder="Name" @bind="name" maxlength="60" />
        <input placeholder="About (optional)" @bind="about" maxlength="500" />
        <button class="primary" disabled="@busy" @onclick="Create">Create &amp; register</button>
        @if (msg != null) { <div class="sub">@msg</div> }
    </div>
    @if (Push != null)
    {
        <div class="panel">
            <h3>Notifications while the app is closed</h3>
            <p class="sub">Your computers (or ones shared with you) watch for you and wake this phone with a push when there’s something, so the app needn’t stay connected. Pushes come through a UnifiedPush app on this phone, such as ntfy.</p>
            @{ var ds = Push.Distributors(); }
            @if (ds.Count == 0) { <p>Install <b>ntfy</b> (from F-Droid or Google Play; no account needed), then come back here.</p> }
            else
            {
                <div class="row-actions">
                    @foreach (var dist in ds) { <button class="primary" @onclick="() => Push.Enable(dist)">Use @(dist.Split('.').Last())</button> }
                </div>
            }
            <div class="sub" id="push-status">@Push.Status</div>
        </div>
    }
    <div class="panel">
        <h3>Your channels</h3>
        @foreach (var c in S.Directory().Where(c => S.IsMine(c.Owner))) { <div><a href="c/@c.Id">@c.Name</a> <span class="badge">@c.Kind</span></div> }
    </div>
}
@code {
    bool starting; string? starterMsg;
    async Task Starter()
    {
        starting = true; starterMsg = "Earning starter coins (proof of work: a little while)…"; StateHasChanged();
        try { await S.Engine.SubmitTx(new JsonObject { ["starter"] = true }, S.Me); starterMsg = "Starter coins on the way: they count once the next main-chain block includes them."; }
        catch (Exception e) { starterMsg = e.Message; starting = false; }
    }
    [Inject] IServiceProvider Sp { get; set; } = null!;
    IPushSetup? Push => Sp.GetService(typeof(IPushSetup)) as IPushSetup;
    string name = "", about = ""; string? msg; bool busy;
    async Task Create()
    {
        if (string.IsNullOrWhiteSpace(name)) { msg = "Give it a name"; return; }
        busy = true; msg = "Registering: proof of work on the main chain (a few seconds to a minute)…"; StateHasChanged();
        try
        {
            var payload = new JsonObject { ["type"] = "genesis", ["kind"] = "channel", ["name"] = name.Trim(), ["about"] = about.Trim(), ["avatar"] = "", ["comments"] = "anyone" };
            var g = await S.CreateChannel(payload);
            msg = "Registered. Opening it…"; Nav.NavigateTo("c/" + (string)g["hash"]!);
        }
        catch (Exception e) { msg = "Couldn’t create it: " + e.Message; }
        busy = false;
    }
}
