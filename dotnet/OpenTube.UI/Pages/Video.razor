@page "/v/{Chain}/{Hash}"
@inherits Live
@inject IVideoPlayer Player
@inject IJSRuntime JS
@{ var d = S.Chain(Chain); var v = d?.Videos.FirstOrDefault(x => (string?)x["hash"] == Hash); }
@if (v == null) { <p class="sub">Loading this video from the network…</p> }
else if (Orgs.Strongest(flags) is "hide" or "disable" && !shownAnyway && !S.IsMine(d!.Owner))
{
    <div class="panel" style="max-width:640px">
        <h2>⚑ @((string?)v["payload"]?["title"])</h2>
        <p>Flagged as @FlagText(). You chose not to open videos with this flag.</p>
        <div class="row-actions"><button @onclick="() => shownAnyway = true">Show it anyway</button><a href="c/@Chain">Back to the channel</a></div>
    </div>
}
else
{
    var p = v["payload"]!; var mineCh = S.IsMine(d!.Owner); var votes = S.Votes(d, Hash);
    var by = S.AuthorOf(S.Genesis(Chain)?["author"]?.GetValue<string>() ?? d.Owner ?? "", null);
    var tags = (p["tags"] as JsonArray ?? []).Select(t => (string?)t).OfType<string>().ToList();
    var lists = S.MyLists();
    <div class="watch">
        <div class="watch-main">
            @if (ad != null && adPhase != "done")
            {
                <div class="player">@if (adSrc != null) { <video id="ad-video" autoplay playsinline src="@adSrc" style="width:100%"></video> }</div>
                <div class="panel ad-panel" id="ad-panel">
                    <div class="head-row"><span><span class="badge warnb">Ad</span> <b>@((string?)ad.Block["payload"]?["title"])</b> <span class="sub">· @ad.Name</span>
                        @if ((string?)ad.Block["payload"]?["url"] is { Length: > 0 } au) { <a href="@au" target="_blank" rel="noopener noreferrer nofollow"> Visit advertiser ↗</a> }</span>
                        @if (adPhase == "playing" && canSkip) { <button @onclick="SkipAd">Skip ad</button> }</div>
                    <div class="sub" id="ad-status">@adStatus</div>
                </div>
            }
            else
            {
                <div class="player" id="player-@Hash">@if (src != null) { <video controls autoplay playsinline src="@src" style="width:100%"></video> }</div>
                @if (adResult != null) { <div class="panel ad-panel"><span class="badge @(adOk ? "ok" : "warnb")">@(adOk ? "Ad view verified" : "Ad view not counted")</span> <span class="sub" id="ad-result">@adResult</span></div> }
            }
            @if (status != null) { <div class="sub">@status</div> }
            <h2 class="watch-title">@((string?)p["title"])</h2>
            <div class="row-actions">
                <a href="c/@Chain" class="chan-link">@if ((string?)d.Profile["avatar"] is { Length: > 0 } av) { <img class="avatar sm" src="@av" alt="" /> }<b>@((string?)d.Profile["name"])</b></a>
                @if (!mineCh && !by.Owner && by.Key != S.Me.pub)
                {
                    <span class="sub">by <a class="person" href="@by.Href">@by.Name</a></span>
                    @if (friends != null && !friends.Contains(by.Key)) { <button class="small-btn" @onclick="() => AddFriend(by.Key, by.Name)">＋ Friend</button> }
                }
                <span class="sub">@Views(S.Views(Hash)) · @Ago(Js.Num(v["ts"]) ?? 0) · @Bytes(Js.Num(p["size"]) ?? 0)</span>
            </div>
            <div class="row-actions small-actions">
                <button class="@(votes.Mine > 0 ? "on" : "")" title="I like this (pays the creator)" disabled="@busy" @onclick="() => VoteVideo(1)">👍 @votes.Up</button>
                <button class="@(votes.Mine < 0 ? "on" : "")" title="I dislike this" disabled="@busy" @onclick="() => VoteVideo(-1)">👎 @votes.Down</button>
                <button @onclick="Copy">Copy link</button>
                @if (!mineCh) { <button title="Send this channel some of your coins" @onclick="() => tipOpen = !tipOpen">🪙 Tip</button> }
                @if (lists.Count > 0)
                {
                    <select @onchange="AddToList"><option value="">＋ Add to list…</option>@foreach (var (id, name) in lists) { <option value="@id">@name</option> }</select>
                }
                <button @onclick="() => reportOpen = !reportOpen">⚑ Report</button>
                @if (mineCh) { <button @onclick="HideVideo">Hide video</button> }
            </div>
            @if (reportOpen)
            {
                var orgs = S.Directory().Where(c => c.Kind == "org").ToList();
                <div class="panel row-actions" id="report-box">
                    @if (orgs.Count == 0) { <span class="sub">No organizations known yet. Find or create one under Orgs.</span> }
                    else
                    {
                        var org = reportOrg.Length > 0 ? reportOrg : orgs[0].Id; var classes = S.Org(org)?.Classes.Values.ToList() ?? [];
                        <span>Report to</span><select value="@org" @onchange="e => reportOrg = (string)e.Value!">@foreach (var o in orgs) { <option value="@o.Id">@o.Name</option> }</select>
                        <span>as</span><select @bind="reportCls">@foreach (var c in classes) { <option value="@c.Id">@c.Name</option> }<option value="other">Something else</option></select>
                        <input class="grow-input" @bind="reportNote" maxlength="2000" placeholder="What’s wrong (optional)" />
                        <button @onclick="() => Report(org)">Report</button>
                    }
                </div>
            }
            @if (flags.Count > 0) { <div class="panel warn">⚑ Flagged as @FlagText()</div> }
            @if (tipOpen)
            {
                <div class="panel row-actions">
                    <span>Tip @((string?)d.Profile["name"])</span><input type="number" min="0.01" step="0.01" @bind="tipAmt" style="width:110px" />
                    <span class="sub">coins (you have @ChainActions.Coins(S.Balance(S.Me.pub)))</span>
                    <button class="primary" @onclick="Tip">Send</button>
                </div>
            }
            @if (msg != null) { <div class="sub" id="watch-msg">@msg</div> }
            @if (tags.Count > 0)
            {
                <div class="row-actions">@foreach (var t in tags)
                {
                    <span class="tagbox"><a class="tag" href="tag/@t">#@t</a>@if (!mineCh) { <button class="tagx" title="Not interested in #@t: hide videos and ads with this tag (kept on this device only)" @onclick="() => Mute(t)">✕</button> }</span>
                }</div>
            }
            <div class="panel">@if ((string?)p["desc"] is { Length: > 0 } desc) { <Rich Text="@desc" Author="@d.Owner" /> } else { <span class="sub">No description.</span> }</div>
            <div class="sub">@(Js.Num(v["ts"]) < Coin.Epoch || mineCh ? "Free for you." : $"Watching pays {ChainActions.Coins(S.Engine.Read(e => e.Store.Ledger.Prices.GetValueOrDefault("piece")))} coins per piece to whoever sends it (half goes to the creator).")</div>

            @{
                var pre = $"view:{Hash}:"; var stats = S.Engine.Read(e => e.Store.Ledger.Paid.Where(kv => kv.Key.StartsWith(pre)).Select(kv => ((string?)kv.Value["from"] ?? "", Js.Num(kv.Value["amt"]) ?? 0)).ToList());
                var watchers = stats.Select(x => x.Item1).Where(x => x.Length > 0).Distinct().ToList(); var earned = stats.Sum(x => x.Item2);
                var peersNow = Player.Transfers().FirstOrDefault(t => t.InfoHash == (string?)p["infohash"])?.Peers;
                var ncomments = d.CommentsFor(Hash).Count(c => !d.Hidden.Contains((string)c["hash"]!));
            }
            <div class="panel" id="video-stats">
                <h3>📊 Statistics</h3>
                <div class="row-actions stats">
                    <div><b>@Math.Max(S.Views(Hash), watchers.Count)</b><div class="sub">views</div></div>
                    <div><b>@votes.Up</b><div class="sub">likes</div></div>
                    <div><b>@votes.Down</b><div class="sub">dislikes</div></div>
                    <div><b>@ncomments</b><div class="sub">comments</div></div>
                    <div><b>@ChainActions.Coins(earned)</b><div class="sub">coins from views</div></div>
                    @if (peersNow != null) { <div><b>@peersNow</b><div class="sub">peers sharing now</div></div> }
                </div>
                @if (watchers.Count > 0)
                {
                    <button class="linkish" @onclick="() => whoOpen = !whoOpen">@(whoOpen ? "▾" : "▸") Who watched (@watchers.Count)</button>
                    @if (whoOpen) { <div class="row-actions">@foreach (var k in watchers.Take(200)) { <a class="person" href="u/@S.Engine.Read(e => e.Store.Ledger.Resolve(k))">@S.NameOf(k)</a> }</div> }
                }
                @if ((string?)p["stream"] is { } vs && d.LiveStats.GetValueOrDefault(vs) is JsonObject ls) { <div class="sub">🔴 When it was live: peak @ls["peak"] viewers · @ls["unique"] unique</div> }
                <div class="sub">Public on OpenTube: anyone can see these, not only the creator.</div>
            </div>
            <div class="head-row"><h3>Comments</h3>
                @if (mineCh)
                {
                    var cur = d.VideoPolicy.TryGetValue(Hash, out var pol) && pol != null ? (string?)pol ?? "default" : "default";
                    <select value="@cur" @onchange="SetPolicy" title="Who can comment on this video">
                        <option value="default">Channel default (@((string?)d.Profile["comments"] ?? "anyone"))</option>
                        <option value="anyone">Anyone can comment</option><option value="approved">Approved users only</option><option value="off">Comments off</option>
                    </select>
                }
            </div>
            @{ var can = mineCh || d.CanComment(S.Me.pub, Hash); var policy = (string?)d.PolicyFor(Hash); }
            <div class="row-actions">
                <input class="grow-input" id="comment-box" @bind="comment" @bind:event="oninput" @onkeydown="CommentKey" maxlength="2000" disabled="@(!can || posting)"
                       placeholder="@(can ? "Add a comment…" : policy == "off" ? "Comments are off for this video" : policy == "approved" ? "Only approved users can comment on this video" : "You can no longer comment on this channel")" />
                <button class="primary" disabled="@(!can || posting)" @onclick="Post">Comment</button>
                @if (posting) { <span class="sub">@(mineCh ? "Posting…" : "Doing anti-spam work…")</span> }
            </div>
            @{ var list = d.CommentsFor(Hash).OrderByDescending(c => Js.Num(c["ts"]) ?? 0).ToList(); }
            @if (list.Count == 0) { <p class="sub">No comments yet.</p> }
            <div class="comments">
                @foreach (var c in list)
                {
                    var ch = (string)c["hash"]!; var author = (string)c["author"]!; var hidden = d.Hidden.Contains(ch);
                    if (hidden && !S.IsMine(author) && !mineCh) continue;
                    var a = S.AuthorOf(author, d, (string?)c["payload"]?["name"] ?? "");
                    var cv = S.Votes(d, ch);
                    <div class="comment @(hidden ? "hidden-item" : "")">
                        <div><a class="person" href="@a.Href"><b>@a.Name</b></a>@if (a.Owner) { <span class="badge ok">owner</span> }<span class="sub"> · @Ago(Js.Num(c["ts"]) ?? 0)</span>@if (hidden) { <span class="badge">hidden</span> }</div>
                        <Rich Text="@((string?)c["payload"]?["text"])" Author="@author" />
                        <div class="row-actions small-actions">
                            <button disabled="@(S.IsMine(author) || cv.Mine > 0)" title="Like this comment (pays its author)" @onclick="() => LikeComment(ch, author)">👍 @cv.Up</button>
                            @if (!hidden && (mineCh || S.IsMine(author))) { <button @onclick="() => Do(() => S.Hide(Chain, ch))">Hide</button> }
                            @if (mineCh && !S.IsMine(author)) { <button title="Block this person: hides everything they write on your channel" @onclick="() => blockAsk = author">Block</button> }
                        </div>
                        @if (blockAsk == author)
                        {
                            <div class="row-actions"><span>Block @a.Name on your channel?</span><button class="primary" @onclick="() => Do(() => S.Block(Chain, author), done: () => blockAsk = null)">Block</button><button @onclick="() => blockAsk = null">Cancel</button></div>
                        }
                    </div>
                }
            </div>
        </div>
        <aside class="watch-side">
            <h3>More from this channel</h3>
            <div class="side-list">@foreach (var o in d.Videos.Where(x => (string?)x["hash"] != Hash).OrderByDescending(x => Js.Num(x["ts"]) ?? 0).Take(12)) { <VideoCard Chain="@Chain" Block="o" ChannelName="@((string?)d.Profile["name"])" /> }</div>
        </aside>
    </div>
}
@code {
    [Parameter] public string Chain { get; set; } = ""; [Parameter] public string Hash { get; set; } = "";
    string? status, src, started, msg, blockAsk; string comment = ""; bool posting, busy, tipOpen; double tipAmt = 1;
    bool whoOpen; HashSet<string>? friends; List<Orgs.FlagOn> flags = []; bool shownAnyway, reportOpen; string reportOrg = "", reportCls = "", reportNote = "";
    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized(); friends = (await S.Social.Friends()).Select(f => f.Key).ToHashSet();
        flags = S.FlagsOn(await S.Followed(), Hash);
    }
    string FlagText() => string.Join(", ", flags.Select(f => $"{f.Name} ({f.OrgName})"));
    Task Report(string org) => Do(async () => { await S.Report(org, Chain, Hash, reportCls, reportNote); reportOpen = false; reportNote = ""; }, "Doing anti-spam work…", () => msg = "Reported. The organization’s moderators review it.");
    Task AddFriend(string key, string name) => Do(async () => { await S.Social.AddFriend(key, name); friends?.Add(key); }, "Adding…", () => msg = $"{name} is now a friend: they see your friends-only posts once they add you back.");
    Task Mute(string tag) => Do(() => S.Social.SetMuted("tags", tag, true), null, () => msg = $"You won’t see videos or ads tagged #{tag}. Undo under You → Settings → Not interested.");
    static string Views(double n) => n == 1 ? "1 view" : (n >= 1e6 ? $"{n / 1e6:0.#}M" : n >= 1e4 ? $"{Math.Round(n / 1e3)}K" : n.ToString("N0")) + " views";
    protected override async Task OnParametersSetAsync()
    {
        if (started != null && started != Hash) { src = null; msg = null; adCts.Cancel(); adCts = new(); ad = null; viewing = null; adSrc = adStatus = adResult = null; adPhase = ""; canSkip = false; }
        await Task.CompletedTask;
    }
    public override void Dispose() { base.Dispose(); adCts.Cancel(); }
    Ads.Candidate? ad; Ads.Viewing? viewing; string? adSrc, adStatus, adResult; string adPhase = ""; bool adOk, canSkip; CancellationTokenSource adCts = new();
    async Task RunAd(Derived d)
    {
        ad = await S.PickAd(Chain, (await S.Social.Muted()).Tags);
        if (ad == null) return;
        adPhase = "loading"; adStatus = "Loading ad…"; StateHasChanged();
        var t = ad.Terms;
        var bytes = await Player.Fetch((string)t["infohash"]!, (string?)ad.Block["payload"]?["file"] ?? "ad.mp4", Js.Num(t["size"]) ?? 0, TimeSpan.FromSeconds(20));
        if (bytes == null || bytes.Length != (long)(Js.Num(t["size"]) ?? -1)) { adPhase = "done"; adOk = false; adResult = "The ad could not be loaded (no peer has it), so it was skipped."; return; }
        viewing = new Ads.Viewing(S, ad, bytes, Hash, d.Owner!);
        var r = await viewing.Run(async () =>
        {
            adSrc = (await Player.Play("ad-video", (string)t["infohash"]!, (string?)ad.Block["payload"]?["file"] ?? "ad.mp4", Js.Num(t["size"]) ?? 0, _ => { })).Src;
            adPhase = "playing"; await InvokeAsync(StateHasChanged);
            _ = Task.Delay(5000).ContinueWith(_ => { canSkip = true; InvokeAsync(StateHasChanged); });
        }, async i => { try { return await JS.InvokeAsync<bool>("otUi.playingAt", "ad-video", i); } catch { return false; } },
        st => { adStatus = st; InvokeAsync(StateHasChanged); }, adCts.Token);
        try { await JS.InvokeVoidAsync("otUi.pause", "ad-video"); } catch { }
        adPhase = "done"; adOk = r.Ok; adResult = r.Text.Length > 0 ? r.Text : null;
    }
    async Task SkipAd() { if (viewing != null) viewing.Skipped = true; adStatus = "Ad skipped · counting what you watched…"; await JS.InvokeVoidAsync("otUi.pause", "ad-video"); }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        var d0 = S.Chain(Chain); var v = d0?.Videos.FirstOrDefault(x => (string?)x["hash"] == Hash);
        if (v == null || started == Hash) return;
        started = Hash;
        if (!S.IsMine(d0!.Owner)) { try { await RunAd(d0); } catch (Exception e) { adPhase = "done"; adResult = e.Message; } StateHasChanged(); }
        var p = v["payload"]!;
        status = "Finding peers for this video…"; StateHasChanged();
        var r = await Player.Play("player-" + Hash, (string)p["infohash"]!, (string?)p["file"] ?? "video.mp4", Js.Num(p["size"]) ?? 0, s => { status = s; InvokeAsync(StateHasChanged); });
        src = r.Src; status = r.Status;
        StateHasChanged();
    }
    async Task Do(Func<Task> f, string? doing = null, Action? done = null)
    {
        msg = doing; StateHasChanged();
        try { await f(); msg = null; done?.Invoke(); } catch (Exception e) { msg = e.Message; }
    }
    async Task VoteVideo(int dir) { busy = true; await Do(() => S.Vote(Chain, Hash, dir, S.Chain(Chain)!.Owner!), "Signing and paying…"); busy = false; }
    Task LikeComment(string target, string author) => Do(() => S.Vote(Chain, target, 1, author), "Liking (pays the author)…");
    async Task Post()
    {
        if (comment.Trim().Length == 0) return;
        posting = true;
        await Do(async () => { await S.Comment(Chain, Hash, comment); comment = ""; });
        posting = false;
    }
    Task CommentKey(KeyboardEventArgs e) => e.Key == "Enter" ? Post() : Task.CompletedTask;
    Task SetPolicy(ChangeEventArgs e) => Do(() => S.CommentPolicy(Chain, Hash, (string?)e.Value ?? "default"), "Recording the comment setting…", () => msg = "Comment setting recorded on the chain.");
    async Task AddToList(ChangeEventArgs e)
    {
        var list = (string?)e.Value; if (string.IsNullOrEmpty(list)) return;
        await Do(() => S.AddToList(list, Chain, Hash), "Adding…", () => msg = "Added to " + S.MyLists().FirstOrDefault(l => l.Id == list).Name);
    }
    async Task HideVideo() { await Do(() => S.Hide(Chain, Hash)); if (msg == null) Nav.NavigateTo("c/" + Chain); }
    Task Tip() => Do(() => S.Tip(S.Chain(Chain)!.Owner!, Math.Round(tipAmt * 100), "tip for " + (string?)S.Chain(Chain)!.Profile["name"]), "Sending…",
        () => { tipOpen = false; msg = $"Tipped {tipAmt:0.##} coins. It confirms in the next main-chain block."; });
    async Task Copy()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Nav.Uri); msg = "Link copied."; } catch { msg = Nav.Uri; }
    }
}
