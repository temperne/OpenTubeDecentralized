<UserControl x:Class="OpenTube.Uno.Controls.VideoGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
             xmlns:c="using:OpenTube.Uno.Controls">
  <!-- Video cards: one column on a phone, as many as fit on a wider screen -->
  <muxc:ItemsRepeater x:Name="Repeater">
    <muxc:ItemsRepeater.Layout>
      <muxc:UniformGridLayout MinItemWidth="300" MinColumnSpacing="16" MinRowSpacing="20" ItemsStretch="Fill" />
    </muxc:ItemsRepeater.Layout>
    <muxc:ItemsRepeater.ItemTemplate>
      <DataTemplate x:DataType="c:VideoItem">
        <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource OnSurfaceBrush}" Click="OnOpen" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Title}">
          <StackPanel Spacing="6">
            <Grid CornerRadius="12" Background="#000000">
              <Viewbox Stretch="Uniform"><Grid Width="16" Height="9" /></Viewbox>
              <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
              <Border Visibility="{x:Bind Live}" Background="#E5484D" CornerRadius="4" Padding="6,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White" />
              </Border>
            </Grid>
            <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Channel}" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            <TextBlock Text="{x:Bind Meta}" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          </StackPanel>
        </Button>
      </DataTemplate>
    </muxc:ItemsRepeater.ItemTemplate>
  </muxc:ItemsRepeater>
</UserControl>
