<Page x:Class="OpenTube.Uno.Pages.WatchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:c="using:OpenTube.Uno.Controls"
      xmlns:p="using:OpenTube.Uno.Pages"
      Background="{ThemeResource BackgroundBrush}">
  <!-- Watching a video: the player (with full screen), what it is, likes, comments, and more from the channel. One column
       on a phone; the channel's other videos beside it on a wide screen. -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="4,4,16,4" Background="{ThemeResource SurfaceBrush}">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Style="{StaticResource IconButtonStyle}" Click="OnBack" AutomationProperties.Name="Back"><SymbolIcon Symbol="Back" /></Button>
        <TextBlock x:Name="TopTitle" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="600" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1">
      <Grid x:Name="Layout" Padding="0,0,0,24" ColumnSpacing="20" MaxWidth="1500">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SideCol" Width="0" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="MainCol" Spacing="12">
          <Grid x:Name="PlayerBox" Background="Black" SizeChanged="OnPlayerSize">
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="True" Stretch="Uniform" />
            <TextBlock x:Name="NoVideo" Visibility="Collapsed" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" />
          </Grid>
          <StackPanel Padding="16,0" Spacing="10">
            <TextBlock x:Name="Status" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}" AutomationProperties.AutomationId="watch-status" />
            <TextBlock x:Name="VideoTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ChannelName" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="Meta" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </StackPanel>
              <Button x:Name="SubButton" Grid.Column="1" Click="OnSubscribe" Style="{StaticResource FilledButtonStyle}" />
            </Grid>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="LikeButton" Click="OnLike" Style="{StaticResource TonalButtonStyle}" />
                <Button x:Name="DislikeButton" Click="OnDislike" Style="{StaticResource TonalButtonStyle}" />
                <Button Content="Copy link" Click="OnCopyLink" Style="{StaticResource TonalButtonStyle}" />
              </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="ActionMsg" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}" Visibility="Collapsed" />
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="14">
              <TextBlock x:Name="Description" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>
            <TextBlock x:Name="CommentsHeading" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
            <Grid ColumnSpacing="8" x:Name="CommentBox">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="CommentText" PlaceholderText="Add a comment…" MaxLength="2000" AcceptsReturn="False" KeyDown="OnCommentKey" />
              <Button Grid.Column="1" Content="Post" Click="OnComment" Style="{StaticResource FilledButtonStyle}" />
            </Grid>
            <ItemsControl x:Name="Comments">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:CommentItem">
                  <StackPanel Padding="0,8" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Text="{x:Bind When}" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="More" Grid.Row="1" Padding="16,12" Spacing="12">
          <TextBlock Text="More from this channel" FontSize="17" FontWeight="SemiBold" />
          <c:VideoGrid x:Name="MoreGrid" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
