<Page x:Class="OpenTube.Uno.Pages.ExplorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:OpenTube.Uno.Controls"
      Background="{ThemeResource BackgroundBrush}">
  <ScrollViewer>
    <StackPanel Padding="16" Spacing="14" MaxWidth="1400">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="🗺 Map" Style="{StaticResource FilledButtonStyle}" Click="OnMap" />
        <Button Content="🛍 Market" Style="{StaticResource FilledTonalButtonStyle}" Click="OnMarket" />
        <Button Content="💱 Exchange" Style="{StaticResource FilledTonalButtonStyle}" Click="OnExchange" />
        <Button Content="🏛 Organizations" Style="{StaticResource FilledTonalButtonStyle}" Click="OnOrgs" />
      </StackPanel>
      <AutoSuggestBox x:Name="Search" PlaceholderText="Search videos and channels" QueryIcon="Find" TextChanged="OnSearch" />
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
        <StackPanel x:Name="ViewBar" Orientation="Horizontal" Spacing="8" />
      </ScrollViewer>
      <c:VideoGrid x:Name="Grid" />
      <TextBlock x:Name="Empty" Visibility="Collapsed" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
