<Page x:Class="OpenTube.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <!-- The app frame: a top bar (title, network status, add video, go live, notifications), the tab's page, and the
       tab bar (at the bottom on a phone). Pages a tab opens (a video, a channel) go over the whole frame. -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Padding="16,8" ColumnSpacing="8" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Open" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Tube" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="8,0,0,0">
        <Ellipse x:Name="NetDot" Width="8" Height="8" Fill="Gray" />
        <TextBlock x:Name="NetText" Text="Connecting…" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
        <Button x:Name="UploadButton" Style="{StaticResource IconButtonStyle}" Click="OnUpload" ToolTipService.ToolTip="Add a video" AutomationProperties.Name="Add a video">
          <SymbolIcon Symbol="Add" />
        </Button>
        <Button x:Name="LiveButton" Style="{StaticResource IconButtonStyle}" Click="OnGoLive" ToolTipService.ToolTip="Go live" AutomationProperties.Name="Go live">
          <FontIcon Glyph="&#xE7C8;" Foreground="{ThemeResource PrimaryBrush}" />
        </Button>
        <Button x:Name="BellButton" Style="{StaticResource IconButtonStyle}" Click="OnNotifications" ToolTipService.ToolTip="Notifications" AutomationProperties.Name="Notifications">
          <Grid>
            <FontIcon Glyph="&#xEA8F;" />
            <Border x:Name="BellBadge" Visibility="Collapsed" Background="{ThemeResource PrimaryBrush}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0">
              <TextBlock x:Name="BellCount" FontSize="10" Foreground="{ThemeResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>
      </StackPanel>
    </Grid>

    <Frame x:Name="TabFrame" Grid.Row="1" />

    <utu:TabBar x:Name="Tabs" Grid.Row="2" Style="{StaticResource BottomTabBarStyle}" SelectionChanged="OnTab">
      <utu:TabBarItem Content="Home" Tag="home" AutomationProperties.AutomationId="tab-home">
        <utu:TabBarItem.Icon><SymbolIcon Symbol="Home" /></utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Explore" Tag="explore" AutomationProperties.AutomationId="tab-explore">
        <utu:TabBarItem.Icon><SymbolIcon Symbol="Find" /></utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Posts" Tag="posts" AutomationProperties.AutomationId="tab-posts">
        <utu:TabBarItem.Icon><SymbolIcon Symbol="Comment" /></utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Messages" Tag="messages" AutomationProperties.AutomationId="tab-messages">
        <utu:TabBarItem.Icon><SymbolIcon Symbol="Mail" /></utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="You" Tag="you" AutomationProperties.AutomationId="tab-you">
        <utu:TabBarItem.Icon><SymbolIcon Symbol="Contact" /></utu:TabBarItem.Icon>
      </utu:TabBarItem>
    </utu:TabBar>
  </Grid>
</Page>
